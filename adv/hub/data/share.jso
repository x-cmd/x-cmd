{
"#desc"
:
{
"cn"
:
"管理云端文件的分享链接（默认为创建）。\n当文件名以 .zip 结尾时，后端自动解压并创建多文件分享；其他文件按单文件分享处理。\n"
,
"en"
:
"Manage share links for cloud files (default create).\nWhen the file name ends with .zip, the backend auto-extracts it into a multi-file share; otherwise a single-file share is created.\n"
}
,
"ls"
:
{
"#desc"
:
{
"cn"
:
"列出所有分享链接"
,
"en"
:
"List all share links"
}
,
"--json|-j"
:
{
"#desc"
:
{
"cn"
:
"以 JSON 格式输出"
,
"en"
:
"Output in JSON format"
}
}
,
"--page|-p"
:
{
"#desc"
:
{
"cn"
:
"页码（默认 1）"
,
"en"
:
"Page number (default 1)"
}
,
"#1"
:
null
}
,
"--limit|-l"
:
{
"#desc"
:
{
"cn"
:
"每页条数（默认 20）"
,
"en"
:
"Items per page (default 20)"
}
,
"#1"
:
null
}
,
"--space"
:
{
"#desc"
:
{
"cn"
:
"按空间名称过滤"
,
"en"
:
"Filter by space name"
}
,
"#1"
:
null
}
,
"#tldr"
:
[
{
"cmd"
:
"x hub share ls"
,
"cn"
:
"列出所有分享链接"
,
"en"
:
"List all share links"
}
,
{
"cmd"
:
"x hub share ls --json"
,
"cn"
:
"以 JSON 格式列出所有分享链接"
,
"en"
:
"List all share links in JSON format"
}
,
{
"cmd"
:
"x hub share ls --space <name>"
,
"cn"
:
"列出指定空间下的分享链接"
,
"en"
:
"List share links under the specified space"
}
]
}
,
"rm"
:
{
"#desc"
:
{
"cn"
:
"删除分享链接"
,
"en"
:
"Delete a share link"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"文件 ID"
,
"en"
:
"File ID"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x hub share rm <fileId>"
,
"cn"
:
"删除分享链接 <fileId>"
,
"en"
:
"Delete share link <fileId>"
}
]
}
,
"update"
:
{
"#desc"
:
{
"cn"
:
"更新分享链接设置"
,
"en"
:
"Update share link settings"
}
,
"--require-login"
:
{
"#desc"
:
{
"cn"
:
"设置需要登录才能访问"
,
"en"
:
"Require login to access"
}
}
,
"--expires|-e"
:
{
"#desc"
:
{
"cn"
:
"重新设置过期时间（支持秒数或 1h、2d、1w 等时间单位）"
,
"en"
:
"Reset expiration time (supports seconds or time units like 1h, 2d, 1w)"
}
,
"#1"
:
null
}
,
"--password"
:
{
"#desc"
:
{
"cn"
:
"设置或更新访问密码"
,
"en"
:
"Set or update the access password"
}
,
"#1"
:
null
}
,
"--remove-password"
:
{
"#desc"
:
{
"cn"
:
"移除访问密码"
,
"en"
:
"Remove the access password"
}
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"文件 ID"
,
"en"
:
"File ID"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x hub share update --require-login <fileId>"
,
"cn"
:
"设置分享链接 <fileId> 需要登录才能访问"
,
"en"
:
"Set share link <fileId> to require login"
}
,
{
"cmd"
:
"x hub share update --expires 3600 <fileId>"
,
"cn"
:
"重新设置分享链接 <fileId> 的有效期为 1 小时"
,
"en"
:
"Reset share link <fileId> expiration to 1 hour"
}
,
{
"cmd"
:
"x hub share update --password <password> <fileId>"
,
"cn"
:
"为分享链接 <fileId> 设置访问密码"
,
"en"
:
"Set access password for share link <fileId>"
}
,
{
"cmd"
:
"x hub share update --remove-password <fileId>"
,
"cn"
:
"移除分享链接 <fileId> 的访问密码"
,
"en"
:
"Remove access password for share link <fileId>"
}
]
}
,
"--expires|-e"
:
{
"#desc"
:
{
"cn"
:
"设置分享链接的有效期（支持秒数或 1h、2d、1w 等时间单位）"
,
"en"
:
"Set the expiration time of the share link (supports seconds or time units like 1h, 2d, 1w)"
}
,
"#1"
:
null
}
,
"--require-login"
:
{
"#desc"
:
{
"cn"
:
"设置需要登录才能访问"
,
"en"
:
"Require login to access"
}
}
,
"--path"
:
{
"#desc"
:
{
"cn"
:
"分享 URL 中的显示路径（不传则取文件名）"
,
"en"
:
"Display path in the share URL (defaults to filename)"
}
,
"#1"
:
null
}
,
"--space"
:
{
"#desc"
:
{
"cn"
:
"指定空间名称"
,
"en"
:
"Specify space name"
}
,
"#1"
:
null
}
,
"--password"
:
{
"#desc"
:
{
"cn"
:
"设置访问密码（仅单文件分享支持）"
,
"en"
:
"Set access password (single-file shares only)"
}
,
"#1"
:
null
}
,
"--entry"
:
{
"#desc"
:
{
"cn"
:
"指定 zip 分享的入口文件路径（默认为 index.html）"
,
"en"
:
"Specify the entry file path for zip shares (default is index.html)"
}
,
"#1"
:
null
}
,
"--force"
:
{
"#desc"
:
{
"cn"
:
"zip 分享目标文件夹已存在时强制覆盖"
,
"en"
:
"Force overwrite when the zip share target folder already exists"
}
}
,
"--file"
:
{
"#desc"
:
{
"cn"
:
"直传模式：直接上传本地文件创建分享（文件不会进入云端文件库）。\n未传 --file 时按引用模式工作，<1> 指定云端已有文件路径。\n"
}
,
"en"
:
"Direct-upload mode: upload a local file and create a share in one step (the file does not enter the cloud file library).\nWithout --file, the command runs in reference mode and <1> must be an existing cloud path.\n"
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"云端文件路径（引用模式）"
,
"en"
:
"Cloud file path (reference mode)"
}
,
"#exec:stdout:nospace"
:
"x hub _advise lsfile"
}
,
"#tldr"
:
[
{
"cmd"
:
"x hub share demo/example.txt"
,
"cn"
:
"为云端文件 me:demo/example.txt 创建永久分享链接"
,
"en"
:
"Create a permanent share link for cloud file me:demo/example.txt"
}
,
{
"cmd"
:
"x hub share --expires 3600 demo/example.txt"
,
"cn"
:
"为云端文件 me:demo/example.txt 创建有效期为 1 小时的分享链接"
,
"en"
:
"Create a 1-hour share link for cloud file me:demo/example.txt"
}
,
{
"cmd"
:
"x hub share --password <password> demo/example.txt"
,
"cn"
:
"为云端文件 me:demo/example.txt 创建带密码保护的分享链接"
,
"en"
:
"Create a password-protected share link for cloud file me:demo/example.txt"
}
,
{
"cmd"
:
"x hub share --file ./local.txt"
,
"cn"
:
"直传本地文件 ./local.txt 创建分享（文件不入云端文件库）"
,
"en"
:
"Direct-upload local file ./local.txt to create a share (does not enter the cloud file library)"
}
,
{
"cmd"
:
"x hub share --file ./photo.jpg --path album/photo.jpg"
,
"cn"
:
"直传本地图片并以 album/photo.jpg 作为 URL 展示路径"
,
"en"
:
"Direct-upload a local image with album/photo.jpg as the URL display path"
}
,
{
"cmd"
:
"x hub share <path/to/archive.zip>"
,
"cn"
:
"为云端 zip 文件创建多文件分享链接（后端按 .zip 后缀自动解压）"
,
"en"
:
"Create a multi-file share link for a cloud zip file (backend auto-extracts by .zip suffix)"
}
,
{
"cmd"
:
"x hub share --file ./site.zip"
,
"cn"
:
"直传本地 site.zip 并自动解压，创建多文件分享链接"
,
"en"
:
"Direct-upload local site.zip and auto-extract it to create a multi-file share link"
}
,
{
"cmd"
:
"x hub share --file ./site.zip --entry main.html --force"
,
"cn"
:
"直传本地 zip，指定 main.html 作为入口，并强制覆盖已存在的同名目录"
,
"en"
:
"Direct-upload a zip, set main.html as the entry, and force-overwrite an existing folder with the same name"
}
]
}

