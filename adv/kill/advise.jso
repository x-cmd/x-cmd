{
"#name"
:
{
"kill"
:
null
,
"en"
:
"kill command enhancement"
,
"zh"
:
"kill 命令增强"
}
,
"#desc"
:
{
"zh"
:
"增强版 kill 命令，支持递归杀死进程、按端口杀死进程、信号列表查看等功能"
,
"en"
:
"Enhanced kill command with recursive process killing, port-based killing, signal listing and more features"
}
,
"#tldr"
:
[
{
"cmd"
:
"x kill -l"
,
"en"
:
"View all available signals in the current system using an TUI"
,
"zh"
:
"以 TUI 方式查看当前系统所有可用的信号"
}
,
{
"cmd"
:
"x kill -l --json"
,
"en"
:
"List all signals in JSON format"
,
"zh"
:
"以 JSON 格式列出所有信号"
}
,
{
"cmd"
:
"x kill byport"
,
"en"
:
"Kill all processes listening on ports 80 and 443"
,
"zh"
:
"杀死所有监听 80 和 443 端口的进程"
}
,
{
"cmd"
:
"x kill tree 1234"
,
"zh"
:
"警告: 递归杀死进程 1234 及其所有子进程"
,
"en"
:
"Caution: Recursively kill process 1234 and all its children"
}
,
{
"cmd"
:
"x kill tree -s KILL 1234"
,
"zh"
:
"警告: 使用 KILL 信号递归杀死进程 1234"
,
"en"
:
"Caution: Recursively kill process 1234 with KILL signal"
}
]
,
"#other"
:
{
"en"
:
{
"Please visit our homepage for more information:"
:
"https://x-cmd.com"
}
,
"zh"
:
{
"请访问我们的主页以获取更多信息："
:
"https://x-cmd.com"
}
}
,
"#option"
:
{
"--recursive|-r"
:
{
"#tag"
:
[
"inner"
]
,
"#desc"
:
{
"zh"
:
"递归杀死进程及其所有子进程"
,
"en"
:
"Recursively kill process and all its child processes"
}
,
"-s"
:
{
"#desc"
:
{
"zh"
:
"指定发送的信号"
,
"en"
:
"Specify signal to send"
}
}
}
}
,
"--ls|-l"
:
{
"#subcmd"
:
true
,
"#desc"
:
{
"en"
:
"List available signal"
,
"zh"
:
"列出可用的信号"
}
,
"#option"
:
{
"-j|--json"
:
{
"#desc"
:
{
"en"
:
"Output in JSON format"
,
"zh"
:
"以 JSON 格式输出"
}
}
,
"-c|--csv"
:
{
"#desc"
:
{
"en"
:
"Output in CSV format"
,
"zh"
:
"以 CSV 格式输出"
}
}
,
"--app"
:
{
"#desc"
:
{
"en"
:
"View with interactive UI"
,
"zh"
:
"使用交互式 UI 查看"
}
}
}
}
,
"byport"
:
{
"#desc"
:
{
"zh"
:
"根据端口杀死进程 (目前仅支持 80/443 端口)"
,
"en"
:
"Kill processes by port (currently supports 80/443 ports only)"
}
}
,
"byfp|byfingerprint"
:
{
"#desc"
:
{
"zh"
:
"根据进程指纹验证后杀死进程"
,
"en"
:
"Kill processes after fingerprint verification"
}
,
"#args"
:
[
{
"name"
:
"pid=fingerprint"
,
"#desc"
:
{
"en"
:
"Process ID with fingerprint for verification"
,
"zh"
:
"带指纹验证的进程ID"
}
}
]
}
,
"tree"
:
{
"#desc"
:
{
"zh"
:
"递归杀死进程及其所有子进程"
,
"en"
:
"Recursively kill process and all its child processes"
}
,
"#1"
:
{
"#desc"
:
{
"zh"
:
"目标进程 ID"
,
"en"
:
"Target process ID"
}
}
,
"#option"
:
{
"-s"
:
{
"#desc"
:
{
"zh"
:
"指定发送的信号"
,
"en"
:
"Specify signal to send"
}
}
}
}
}

