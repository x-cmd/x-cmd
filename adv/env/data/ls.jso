}
}
,
"--all|-a"
:
{
"#desc"
:
{
"en"
:
"List all available versions for the specified package"
,
"zh"
:
"列出指定 package 的所有可用版本"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"package name"
,
"zh"
:
"包名"
}
,
"#exec:stdout"
:
"xrc pkg; ___x_cmd_pkg___advise ls_all_cand"
}
}
