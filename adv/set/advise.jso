:
"Finish and clean up the shell option environment for x-cmd"
}
}
}
,
"var"
:
{
"#desc"
:
{
"zh"
:
"设置 shell 变量"
,
"en"
:
"Set shell variables"
}
,
"ls"
:
{
"#desc"
:
{
"en"
:
"Print var in the current environment that match prefix"
,
"zh"
:
"打印匹配前缀的变量"
}
}
,
"key"
:
{
"#desc"
:
{
"en"
:
"Print varname in the current environment that match prefix"
,
"zh"
:
"打印匹配前缀的变量名"
}
}
,
"all"
:
{
"#desc"
:
{
"en"
:
"Display all the names and values of shell variables."
,
"zh"
:
"显示 shell 变量的所有名称和值"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x set var all"
,
"en"
:
"Print all variables in the current environment"
,
"zh"
:
"打印当前环境所有的变量"
}
]
}
,
