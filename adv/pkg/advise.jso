}
}
,
"#tldr"
:
[
{
"cmd"
:
"x pkg add node"
,
"en"
:
"Install and deploy the default version of node"
,
"zh"
:
"安装部署默认版本的 node"
}
,
{
"cmd"
:
"x pkg ls -a node"
,
"en"
:
"List all downloadable versions of node"
,
"zh"
:
"列出 node 所有可供下载的版本"
}
,
{
"cmd"
:
"x pkg link node v20.11.1"
,
"zh"
:
"将 v20.11.1 版本的 node 的 shim 可执行文件软链接到 pkg 的公共 bin 目录，从而在全局环境中启用 node"
,
"en"
:
"Symlink the shim executables of node v20.11.1 into pkg's shared bin directory to enable node globally"
}
,
{
"cmd"
:
"x pkg gc node"
,
"zh"
:
"删除指定 pkg 包"
,
"en"
:
"Delete the specified pkg package"
}
,
{
"cmd"
:
"x pkg update"
,
"en"
:
"Update pkg software package information"
,
"zh"
:
"更新 pkg 资源包信息"
}
,
{
"cmd"
:
"x pkg sociality get node"
,
"en"
:
"Get the sociality of the default version of node"
,
"zh"
:
"查看 node 默认版本的 sociality"
}
]
