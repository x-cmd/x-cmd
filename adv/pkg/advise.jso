"#exec:stdout"
:
"___x_cmd_pkg___advise ls_downloaded_candidate"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x pkg ls"
,
"en"
:
"Lists installed packages and their version numbers"
,
"zh"
:
"列出已安装的包及其版本号"
}
,
{
"cmd"
:
"x pkg ls -a java"
,
"en"
:
"List all downloadable versions of java"
,
"zh"
:
"列出 java 所有可供下载的版本"
}
,
{
"cmd"
:
"x pkg ls -i node"
,
"en"
:
"List downloaded node versions"
,
"zh"
:
"列出已下载的 node 版本"
}
]
}
,
"ll"
:
{
"#desc"
:
{
"en"
:
"List all available packages in metadata"
,
"zh"
:
"列出元数据中所有可用的包"
}
,
"--csv"
:
{
"#desc"
:
{
"en"
:
"Output package list in CSV format"
,
"zh"
:
"以 CSV 格式输出包列表"
}
}
,
"--filter"
:
{
"#desc"
:
{
"en"
:
"Filter package list by keyword (fuzzy match)"
,
"zh"
:
"按关键字过滤包列表（模糊匹配）"
}
,
"#n"
:
{
"#desc"
:
{
"en"
:
"Filter keyword"
,
"zh"
:
"过滤关键字"
}
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x pkg ll"
,
"en"
:
"List all available packages"
,
"zh"
:
"列出所有可用的包"
}
,
{
"cmd"
:
"x pkg ll --csv"
,
"en"
:
"Output all packages in CSV format"
,
"zh"
:
"以 CSV 格式输出所有包"
}
,
{
"cmd"
:
"x pkg ll --filter jq"
,
"en"
:
"Filter packages matching 'jq'"
,
"zh"
:
"过滤匹配 'jq' 的包"
}
]
}
,
"xbin"
:
{
"#desc"
:
{
"en"
:
"Generate wrapper functions for packages and display their bin paths"
,
"zh"
:
"为包生成包装函数并显示其 bin 文件路径"
}
,
"init"
:
{
"#desc"
:
{
"en"
:
"generate a function and use package through this function"
,
"zh"
:
"生成一个函数,并通过该函数使用应用"
}
}
,
"path"
:
{
"#desc"
:
{
"en"
:
"Display bin path"
,
"zh"
:
"显示二进制文件路径"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x pkg xbin init <jq|package name> <v0.0.6|version> <test_jq|Custom function name>"
,
"en"
:
"Generate a function called test_jq, and use the application through this function"
,
"zh"
:
"生成一个叫 test_jq 的函数,并通过该函数使用应用"
}
,
{
"cmd"
:
"x pkg xbin path node v18.2.0"
,
"en"
:
"Generate the bin file path of the v18.2.0 application of node"
,
"zh"
:
"生成 node 的 v18.2.0 版本的应用的 bin 文件路径"
}
]
}
,
"_ls_urls"
:
{
"#tag"
:
[
"inner"
]
,
"#desc"
:
{
