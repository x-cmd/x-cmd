:
{
"#tag"
:
[
"inner"
]
,
"#desc"
:
{
"en"
:
"Display http code and delay time of  download URLs on the current network"
,
"zh"
:
"显示当前网络上所有可下载的 URL 的 http 代码和延迟时间"
}
,
"#1"
:
{
"#exec:stdout"
:
"___x_cmd_pkg___advise ls_all_cand"
}
}
,
"_smoke"
:
{
"#tag"
:
[
"inner"
]
,
"#desc"
:
{
"en"
:
"Test pkg package"
,
"zh"
:
"测试 pkg 包"
}
,
"#1"
:
{
"#exec:stdout"
:
