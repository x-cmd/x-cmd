:
{
"#subcmd"
:
true
,
"#desc"
:
{
"en"
:
"Unregister the specified pkg package from the current environment"
,
"cn"
:
"将指定 pkg 包从当前环境中注销"
}
,
"$ref"
:
"x-advise://pkg/data/sphere.option.jso"
}
,
