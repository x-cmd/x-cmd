{
"#tldr"
:
[
{
"cmd"
:
"x cve year --tsv 2024"
,
"en"
:
"Stream every CVE published in 2024 (raw TSV)"
,
"cn"
:
"流式输出 2024 年发布的所有 CVE（原始 TSV）"
}
,
{
"cmd"
:
"x cve year --tsv 2024 --score 9"
,
"en"
:
"Only CVEs with CVSS score ≥ 9"
,
"cn"
:
"仅显示 CVSS 评分 ≥ 9 的 CVE"
}
,
{
"cmd"
:
"x cve year --tsv 2024 --grep chromium"
,
"en"
:
"Filter rows whose cve / ghsa / desc contains 'chromium' (case-insensitive)"
,
"cn"
:
"过滤 cve / ghsa / desc 中包含 chromium 的行（不区分大小写）"
}
,
{
"cmd"
:
"x cve year --tsv 2023 2024 2025"
,
"en"
:
"Stream three years at once"
,
"cn"
:
"一次输出三个年份"
}
]
,
"--score"
:
{
"#desc"
:
{
"en"
:
"Minimum CVSS base score (float); rows without a score are excluded"
,
"cn"
:
"最小 CVSS 基础分（浮点）；无分数的行将被排除"
}
,
"#arg"
:
"SCORE"
}
,
"--grep"
:
{
"#desc"
:
{
"en"
:
"Case-insensitive substring match against cve / ghsa / desc"
,
"cn"
:
"对 cve / ghsa / desc 进行不区分大小写的子串匹配"
}
,
"#arg"
:
"PATTERN"
}
,
"--yml"
:
{
"#desc"
:
{
"en"
:
"Pretty-print as human-readable text (one block per CVE)"
,
"cn"
:
"以人类可读文本输出（每条 CVE 一块）"
}
}
,
"--tsv"
:
{
"#desc"
:
{
"en"
:
"Emit raw TSV (default for piping)"
,
"cn"
:
"输出原始 TSV（管道场景的默认格式）"
}
}
,
"--csv"
:
{
"#desc"
:
{
"en"
:
"Emit raw CSV"
,
"cn"
:
"输出原始 CSV"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Emit raw JSON"
,
"cn"
:
"输出原始 JSON"
}
}
,
"--ghproxy"
:
{
"#desc"
:
{
"en"
:
"Fetch through the gh-proxy.com mirror"
,
"cn"
:
"通过 gh-proxy.com 镜像获取"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag"
,
"cn"
:
"使用非默认缓存标签"
}
}
,
"--offline"
:
{
"#desc"
:
{
"en"
:
"Use only the local cache; do not fetch missing year files"
,
"cn"
:
"仅使用本地缓存；不下载缺失的年份文件"
}
}
}

