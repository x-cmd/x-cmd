{
"#tldr"
:
[
{
"cmd"
:
"x cve data status"
,
"en"
:
"Show cache location, mirror, and per-year file age"
,
"cn"
:
"显示缓存路径、镜像地址、每个年份文件的年龄"
}
,
{
"cmd"
:
"x cve data update"
,
"en"
:
"Refresh the manifest and every year file in parallel"
,
"cn"
:
"并发刷新 manifest 和所有年份文件"
}
,
{
"cmd"
:
"x cve data root"
,
"en"
:
"Print the cache root directory"
,
"cn"
:
"打印缓存根目录"
}
,
{
"cmd"
:
"x cve data base"
,
"en"
:
"Print the upstream base URL the fetcher talks to"
,
"cn"
:
"打印 fetcher 所访问的上游基地址"
}
]
,
"status"
:
{
"#desc"
:
{
"en"
:
"Show cache directory, mirror, and per-year file age (default subcommand)"
,
"cn"
:
"显示缓存目录、镜像地址、每个年份文件的年龄（默认子命令）"
}
}
,
"update|refresh"
:
{
"#desc"
:
{
"en"
:
"Refresh the manifest + every year file (HTTP/2 parallel)"
,
"cn"
:
"刷新 manifest 与所有年份文件（HTTP/2 并发）"
}
}
,
"root"
:
{
"#desc"
:
{
"en"
:
"Print the on-disk cache root path"
,
"cn"
:
"打印本地缓存根路径"
}
}
,
"index"
:
{
"#desc"
:
{
"en"
:
"Print the on-disk path of index.tsv"
,
"cn"
:
"打印 index.tsv 的本地路径"
}
}
,
"year"
:
{
"#desc"
:
{
"en"
:
"Print the on-disk path of cve-YYYY.tsv for the given year"
,
"cn"
:
"打印指定年份 cve-YYYY.tsv 的本地路径"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"4-digit year, e.g. 2024"
,
"cn"
:
"4 位年份，例如 2024"
}
}
}
,
"base"
:
{
"#desc"
:
{
"en"
:
"Print the upstream base URL (depends on --tag / --ghproxy)"
,
"cn"
:
"打印上游基地址（取决于 --tag / --ghproxy）"
}
}
,
"ensure-index"
:
{
"#desc"
:
{
"en"
:
"Download index.tsv if missing or stale (1-day TTL)"
,
"cn"
:
"若 index.tsv 缺失或过期则下载（1 天 TTL）"
}
}
,
"ensure-year"
:
{
"#desc"
:
{
"en"
:
"Download cve-YYYY.tsv if missing or stale (1 day for current year, 30 days for older years)"
,
"cn"
:
"若 cve-YYYY.tsv 缺失或过期则下载（当年 1 天 TTL，往年 30 天 TTL）"
}
}
,
"ensure-years"
:
{
"#desc"
:
{
"en"
:
"Batch-download several years in one curl invocation (HTTP/2 multiplexing)"
,
"cn"
:
"一次 curl 调用并发下载多个年份（HTTP/2 多路复用）"
}
}
,
"fetch"
:
{
"#desc"
:
{
"en"
:
"Fetch a single URL to a file (escape hatch)"
,
"cn"
:
"将单个 URL 下载到本地文件（高级接口）"
}
}
,
"fetch-parallel"
:
{
"#desc"
:
{
"en"
:
"Fetch multiple URLs in parallel (escape hatch)"
,
"cn"
:
"并发下载多个 URL（高级接口）"
}
}
}

