{
"#tldr"
:
[
{
"cmd"
:
"x cve info --yml CVE-2024-0001"
,
"en"
:
"Look up a single CVE"
,
"cn"
:
"查询单条 CVE"
}
,
{
"cmd"
:
"x cve info --yml CVE-2024-0001 CVE-2023-0567 CVE-2026-15895"
,
"en"
:
"Look up several CVEs at once; year files are downloaded in parallel"
,
"cn"
:
"同时查询多条 CVE；年份文件并发下载"
}
,
{
"cmd"
:
"x cve info --tsv CVE-2024-0001"
,
"en"
:
"Output as raw TSV (good for piping)"
,
"cn"
:
"输出原始 TSV，方便管道"
}
]
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Render the result as YAML (default)"
,
"cn"
:
"以 YAML 格式输出（默认）"
}
}
,
"--tsv"
:
{
"#desc"
:
{
"en"
:
"Render the result as TSV (the raw row)"
,
"cn"
:
"以 TSV 格式输出原始行"
}
}
,
"--csv"
:
{
"#desc"
:
{
"en"
:
"Render the result as CSV"
,
"cn"
:
"以 CSV 格式输出"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Render the result as JSON"
,
"cn"
:
"以 JSON 格式输出"
}
}
,
"--raw"
:
{
"#desc"
:
{
"en"
:
"Print only the CVE id (one per line, no other fields)"
,
"cn"
:
"仅打印 CVE id（每行一个，不含其他字段）"
}
}
,
"--ghproxy"
:
{
"#desc"
:
{
"en"
:
"Fetch through the gh-proxy.com mirror (helps when GitHub raw is slow/blocked)"
,
"cn"
:
"通过 gh-proxy.com 镜像获取（GitHub raw 受限或较慢时使用）"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag (e.g. a local mirror URL)"
,
"cn"
:
"使用非默认缓存标签（如本地镜像 URL）"
}
}
,
"--offline"
:
{
"#desc"
:
{
"en"
:
"Do not touch the network; fail if the year file is not already cached"
,
"cn"
:
"不访问网络；若年份文件未缓存则失败"
}
}
}

