{
"#tldr"
:
[
{
"cmd"
:
"x cve recent"
,
"en"
:
"Show the 20 most recently published CVEs (default N=20)"
,
"zh"
:
"显示最近发布的 20 条 CVE（默认 N=20）"
}
,
{
"cmd"
:
"x cve recent -n 100"
,
"en"
:
"Show the 100 most recent CVEs"
,
"zh"
:
"显示最近 100 条 CVE"
}
,
{
"cmd"
:
"x cve recent --tsv -n 50"
,
"en"
:
"Output raw TSV for piping"
,
"zh"
:
"以原始 TSV 输出，方便管道"
}
]
,
"#option"
:
{
"-n"
:
{
"#desc"
:
{
"en"
:
"How many recent CVEs to show (default: 20)"
,
"zh"
:
"显示多少条最近的 CVE（默认 20）"
}
,
"#arg"
:
"N"
}
,
"--yml"
:
{
"#desc"
:
{
"en"
:
"Pretty-print as one line per CVE (default)"
,
"zh"
:
"每条 CVE 一行展示（默认）"
}
}
,
"--tsv"
:
{
"#desc"
:
{
"en"
:
"Emit raw TSV"
,
"zh"
:
"输出原始 TSV"
}
}
,
"--csv"
:
{
"#desc"
:
{
"en"
:
"Emit raw CSV"
,
"zh"
:
"输出原始 CSV"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Emit raw JSON"
,
"zh"
:
"输出原始 JSON"
}
}
,
"--ghproxy"
:
{
"#desc"
:
{
"en"
:
"Fetch through the gh-proxy.com mirror"
,
"zh"
:
"通过 gh-proxy.com 镜像获取"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag"
,
"zh"
:
"使用非默认缓存标签"
}
}
}
}

