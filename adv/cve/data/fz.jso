{
"#tldr"
:
[
{
"cmd"
:
"x cve fz"
,
"en"
:
"Interactive fzf picker over every cached CVE (preview pane = x cve info --yml)"
,
"zh"
:
"对所有已缓存 CVE 的交互式 fzf 选择器（预览面板 = x cve info --yml）"
}
]
,
"#option"
:
{
"--no-refresh"
:
{
"#desc"
:
{
"en"
:
"Skip the automatic 1-hour freshness check on this year + last year"
,
"zh"
:
"跳过对今年与去年文件的 1 小时新鲜度检查"
}
}
,
"--ghproxy"
:
{
"#desc"
:
{
"en"
:
"Fetch through the gh-proxy.com mirror"
,
"zh"
:
"通过 gh-proxy.com 镜像获取"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag"
,
"zh"
:
"使用非默认缓存标签"
}
}
}
}

