{
"#tldr"
:
[
{
"cmd"
:
"x cve detail --yml CVE-2024-0001"
,
"en"
:
"Fetch the full upstream record — yml block: metadata, descriptions, affected, CWE, CVSS, references, timeline, ADP"
,
"zh"
:
"拉取完整上游记录 — yml 块：元数据、描述、受影响范围、CWE、CVSS、参考、时间线、ADP"
}
,
{
"cmd"
:
"x cve detail --json CVE-2024-0001"
,
"en"
:
"Stream the raw upstream JSON"
,
"zh"
:
"流式输出上游原始 JSON"
}
,
{
"cmd"
:
"x cve detail --tsv CVE-2024-0001"
,
"en"
:
"One TSV row per affected product/version pair (id / state / vendor / product / version / cwe / score / vector / desc)"
,
"zh"
:
"每个受影响产品/版本一条 TSV 行"
}
,
{
"cmd"
:
"x cve detail CVE-2024-0001 CVE-2026-9999"
,
"en"
:
"Fetch multiple records in one call"
,
"zh"
:
"一次调用拉取多条记录"
}
]
,
"--yml"
:
{
"#desc"
:
{
"en"
:
"Render as rich yml blocks (default mode)"
,
"zh"
:
"以丰富的 yml 块形式输出（默认模式）"
}
}
,
"--tsv"
:
{
"#desc"
:
{
"en"
:
"Compact TSV: one row per affected product/version pair"
,
"zh"
:
"精简 TSV：每个受影响产品/版本一条行"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Pass-through raw upstream JSON"
,
"zh"
:
"直接输出上游原始 JSON"
}
}
,
"--ghproxy"
:
{
"#desc"
:
{
"en"
:
"Fetch through the gh-proxy.com mirror"
,
"zh"
:
"通过 gh-proxy.com 镜像获取"
}
}
}

