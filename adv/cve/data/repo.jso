{
"#tldr"
:
[
{
"cmd"
:
"x cve repo update"
,
"en"
:
"Clone or pull CVEProject/cvelistV5 to the local cache"
,
"cn"
:
"将 CVEProject/cvelistV5 克隆或拉取到本地缓存"
}
,
{
"cmd"
:
"x cve repo cd"
,
"en"
:
"cd into the local cvelistV5 clone (creates it if missing)"
,
"cn"
:
"cd 进入本地 cvelistV5 克隆（若不存在则创建）"
}
,
{
"cmd"
:
"x cve repo info CVE-2024-0001"
,
"en"
:
"Print the raw JSON for a single CVE id from the local clone"
,
"cn"
:
"从本地克隆打印指定 CVE id 的原始 JSON"
}
,
{
"cmd"
:
"x cve repo all"
,
"en"
:
"Print every CVE JSON file path under the local clone"
,
"cn"
:
"打印本地克隆下所有 CVE JSON 文件路径"
}
]
,
"update"
:
{
"#desc"
:
{
"en"
:
"Clone CVEProject/cvelistV5 to the local cache if missing, otherwise pull"
,
"cn"
:
"若本地无 cvelistV5 克隆则克隆，否则执行 git pull"
}
}
,
"cd"
:
{
"#desc"
:
{
"en"
:
"Ensure the local clone exists, then cd into it"
,
"cn"
:
"确保本地克隆存在后 cd 进去"
}
}
,
"info"
:
{
"#desc"
:
{
"en"
:
"Print the raw JSON for a single CVE id from the local clone"
,
"cn"
:
"从本地克隆打印指定 CVE id 的原始 JSON"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"CVE id, e.g. CVE-2024-0001"
,
"cn"
:
"CVE id，例如 CVE-2024-0001"
}
}
}
,
"all"
:
{
"#desc"
:
{
"en"
:
"List every CVE JSON file path under the local clone"
,
"cn"
:
"列出本地克隆下所有 CVE JSON 文件路径"
}
}
}

