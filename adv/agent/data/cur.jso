{
"#subcmd"
:
true
,
"#tip:note"
:
[
{
"en"
:
"`--cur` lets you temporarily switch AI tools for the current terminal session only.\nIt overrides --cfg without changing your saved defaults.\nExample: `x agent --cur set zero_harness=codex` then `x agent request \"test\"` — uses codex without changing defaults\n"
}
]
,
"set"
:
{
"#desc"
:
{
"en"
:
"Set temporary configuration values"
}
,
"zero_harness="
:
{
"#nospace"
:
true
,
"#desc"
:
{
"en"
:
"Temporary default AI tool"
}
}
,
"#n"
:
{
"#cand"
:
[
{
"zero_harness="
:
{
"#nospace"
:
true
,
"#desc"
:
{
"en"
:
"Temporary default AI tool"
}
}
}
]
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x agent --cur set zero_harness=kimi-cli"
,
"en"
:
"Example: Temporarily switch to kimi-cli (current terminal only)"
}
]
}

