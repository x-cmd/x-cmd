:
{
"en"
:
"Job identifier"
}
}
}
,
"--job-dir"
:
{
"#desc"
:
{
"en"
:
"Specify parent directory for jobs"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__dir"
}
}
,
"#tldr"
