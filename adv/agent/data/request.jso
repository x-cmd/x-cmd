{
"#tip"
:
[
{
"en"
:
"request vs job:\n\n- request: One-off Q&A, e.g. \"explain code\", \"generate regex\"\n\n- job: Complex long-term tasks with auto-iteration, e.g. \"refactor entire module\"\n"
}
,
{
"en"
:
"Security and permission warning:\n\n`x agent request` is designed for unattended execution and enables auto-execution permissions for the AI tool:\n\n- Claude: `--dangerously-skip-permissions`\n- Codex: `--dangerously-bypass-approvals-and-sandbox`\n- Cursor/Gemini/Kimi etc.: corresponding yolo / auto-approve modes\n\nThis means the AI will run commands, read/write files, and modify code **without asking for confirmation**.\n\nRecommended only in isolated environments, containers, CI, or backed-up local projects.\n"
}
]
,
"#synopsis"
:
[
"x agent request [options] <prompt>"
]
,
"--harness"
:
{
"#desc"
:
{
"en"
:
"Specify AI tool (override default config)"
}
,
"#1"
:
{
"$ref"
:
"x-advise://agent/data/harness.jso"
}
}
,
"-f|--file"
:
{
"#multiple"
:
true
,
"#desc"
:
{
"en"
:
"Attach file to prompt; file content is injected into the prompt (can be used multiple times)\n"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"-o|--output"
:
{
"#desc"
:
{
"en"
:
"Save AI response to specified file; use with --overwrite to force replace\n"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"--overwrite"
:
{
"#desc"
:
{
"en"
:
"Force overwrite existing output file (use with --output)"
}
}
,
"--debug"
:
{
"#desc"
:
{
"en"
:
"Output raw JSON and event logs for troubleshooting"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Request JSON formatted output from AI for script parsing\n"
}
}
,
"--pipe"
:
{
"#desc"
:
{
"en"
:
"Read content from stdin/pipe to append to prompt"
}
}
,
"--tool"
:
{
"#desc"
:
{
"en"
:
"Coarse-grained restriction of what the AI can do. Default 'all' means no restriction.\nOnly supported by x-chat and claude harnesses; other harnesses ignore it with a warning.\nAvailable values:\n- all: no restriction (default), keeps each harness's original auto-execution permissions\n- read-only: read/search only (read files, grep/glob, web search); no file modification, no command execution\n- read-write: read-only + file read/write; no command execution\n"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Mode name (all / read-only / read-write)"
}
}
}
,
"--stdout-file"
:
{
"#desc"
:
{
"en"
:
"Capture AI execution stdout to file"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"--stderr-file"
:
{
"#desc"
:
{
"en"
:
"Capture AI execution stderr to file"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__file"
}
}
,
"--timeout"
:
{
"#desc"
:
{
"en"
:
"Request timeout in seconds, 0 means no timeout"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Seconds (positive integer)"
}
}
}
,
"--workspace"
:
{
"#desc"
:
{
"en"
:
"Bind working directory, enable state memory; AI can create/read state files there\n"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__dir"
}
}
,
"--new-workspace-session"
:
{
"#desc"
:
{
"en"
:
"Bind workspace but create a new session per request"
}
}
,
"--session-desc"
:
{
"#desc"
:
{
"en"
:
"Custom description for the current session"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Description text"
}
}
}
,
"--reference-workspace"
:
{
"#desc"
:
{
"en"
:
"Reference external workspace as read-only context; external directory is not modified\n"
}
,
"#1"
:
{
"#exec"
:
"___x_cmd_advise__dir"
}
}
,
"--no-thinking"
:
{
"#desc"
:
{
"en"
:
"Skip AI thinking process, output result directly (save tokens)"
}
}
,
"#n"
:
{
"#desc"
:
{
"en"
:
"Prompt content, supports natural language task description"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x agent request \"Explain this code\""
,
"en"
:
"Example: One-off Q&A — explain code"
}
,
{
"cmd"
:
"x agent request --harness claude --file main.py \"Review and suggest improvements\""
,
"en"
:
"Example: Specific AI tool + attach code file for review"
}
,
{
"cmd"
:
"x agent request -f api.ts -f types.ts \"Generate API documentation\""
,
"en"
:
"Example: Attach multiple files to generate API docs"
}
,
{
"cmd"
:
"x agent request --output result.md --overwrite \"Write a README\""
,
"en"
:
"Example: Generate content and save to file (force overwrite)"
}
,
{
"cmd"
:
"x agent request --json \"List all exported functions in this module\""
,
"en"
:
"Example: Request JSON output for script parsing"
}
,
{
"cmd"
:
"x agent request --workspace ./myproject \"Analyze codebase structure\""
,
"en"
:
"Example: Bind working directory, AI can read/write project files"
}
,
{
"cmd"
:
"x agent request --no-thinking \"Convert 2024-01-15 to Unix timestamp\""
,
"en"
:
"Example: Simple conversion, skip thinking to save tokens"
}
,
{
"cmd"
:
"x agent request --tool read-only --file main.py \"Explain how this module works\""
,
"en"
:
"Example: Read-only analysis, no file modification or command execution"
}
,
{
"cmd"
:
"x agent request --tool read-write --workspace ./myproject \"Refactor the config loader\""
,
"en"
:
"Example: Allow file read/write, but no command execution"
}
,
{
"cmd"
:
"echo \"Error log content\" | x agent request --pipe \"Analyze this error\""
,
"en"
:
"Example: Pipe input + AI analysis"
}
]
}

