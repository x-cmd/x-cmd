{
"#tldr"
:
[
{
"cmd"
:
"x cwe fz"
,
"en"
:
"Interactive fzf picker over every cached CWE (preview pane = full record)"
,
"cn"
:
"对所有已缓存 CWE 的交互式 fzf 选择器（预览面板 = 完整记录）"
}
]
,
"--no-refresh"
:
{
"#desc"
:
{
"en"
:
"Skip the automatic 30-day freshness check on the catalog"
,
"cn"
:
"跳过对目录的 30 天新鲜度检查"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag"
,
"cn"
:
"使用非默认缓存标签"
}
}
,
"-q|--query"
:
{
"#desc"
:
{
"en"
:
"Pre-populate the fzf query"
,
"cn"
:
"预填 fzf 查询字符串"
}
,
"#1"
:
{
"#desc"
:
{
