{
"#tldr"
:
[
{
"cmd"
:
"x cwe ls"
,
"en"
:
"Auto: fzf picker if stdout is a TTY, raw TSV if piped; auto-refreshes cache if older than 30 days"
,
"cn"
:
"自动：stdout 是 TTY 时进入 fzf 选择器，管道则输出原始 TSV；若缓存超过 30 天则自动刷新"
}
,
{
"cmd"
:
"x cwe ls --tsv"
,
"en"
:
"Force raw TSV (good for piping to awk/grep/fzf --filter)"
,
"cn"
:
"强制输出原始 TSV（适合管道至 awk/grep/fzf --filter）"
}
,
{
"cmd"
:
"x cwe ls --yml"
,
"en"
:
"Stream every row as human-readable blocks"
,
"cn"
:
"以人类可读块流式输出每条记录"
}
,
{
"cmd"
:
"x cwe ls --json"
,
"en"
:
"Stream every row as JSON (one record per line)"
,
"cn"
:
"以 JSON 流式输出每条记录（每行一条）"
}
,
{
"cmd"
:
"x cwe ls --csv"
,
"en"
:
"Stream every row as CSV"
,
"cn"
:
"以 CSV 流式输出每条记录"
}
,
{
"cmd"
:
"x cwe ls --table"
,
"en"
:
"Pretty fixed-width table (header + aligned columns)"
,
"cn"
:
"等宽对齐表格（含表头）"
}
,
{
"cmd"
:
"x cwe ls fz"
,
"en"
:
"Force interactive fzf picker (preview pane = full record)"
,
"cn"
:
"强制进入 fzf 选择器（带 --yml 预览面板）"
}
]
,
"--all|-a"
:
{
"#desc"
:
{
"en"
:
"`x cwe ls` 默认就是 --all；显式提供以便脚本使用"
,
"cn"
:
"与默认行为一致；显式提供以便脚本使用"
}
}
,
"--no-refresh"
:
{
"#desc"
:
{
"en"
:
"Skip the automatic 30-day freshness check on the catalog"
,
"cn"
:
"跳过对目录的 30 天新鲜度检查"
}
}
,
"--yml"
:
{
"#desc"
:
{
"en"
:
"Render each row as a human-readable block"
,
"cn"
:
"每条记录以人类可读块输出"
}
}
,
"--tsv"
:
{
"#desc"
:
{
"en"
:
"Emit raw TSV (default for pipes)"
,
"cn"
:
"输出原始 TSV（管道场景的默认）"
}
}
,
"--csv"
:
{
"#desc"
:
{
"en"
:
"Emit raw CSV"
,
"cn"
:
"输出原始 CSV"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Emit raw JSON (one record per line)"
,
"cn"
:
"输出原始 JSON（每行一条记录）"
}
}
,
"--table"
:
{
"#desc"
:
{
"en"
:
"Pretty fixed-width table with header"
,
"cn"
:
"等宽对齐表格（含表头）"
}
}
,
"fz|--fz"
:
{
"#desc"
:
{
"en"
:
"Interactive fzf picker (preview pane = full record)"
,
"cn"
:
"交互式 fzf 选择器（预览面板 = 完整记录）"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag"
,
"cn"
:
"使用非默认缓存标签"
}
}
}

