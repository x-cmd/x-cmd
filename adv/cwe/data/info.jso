{
"#tldr"
:
[
{
"cmd"
:
"x cwe info CWE-79"
,
"en"
:
"Print the full record for CWE-79 (XSS) as a YAML block"
,
"zh"
:
"以 YAML 块输出 CWE-79（XSS）的完整记录"
}
,
{
"cmd"
:
"x cwe info 79"
,
"en"
:
"Bare-id form (the `CWE-` prefix is optional)"
,
"zh"
:
"裸 id 形式（`CWE-` 前缀可选）"
}
,
{
"cmd"
:
"x cwe info CWE-79 CWE-89 CWE-1004"
,
"en"
:
"Look up several CWE ids in one call"
,
"zh"
:
"一次查询多个 CWE id"
}
,
{
"cmd"
:
"x cwe info CWE-79 --json"
,
"en"
:
"Emit one JSON line per id"
,
"zh"
:
"每个 id 输出一个 JSON 行"
}
,
{
"cmd"
:
"x cwe info CWE-79 --raw"
,
"en"
:
"Emit just the canonical id (good for pipelines)"
,
"zh"
:
"仅输出标准 id（适合管道）"
}
]
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Render the record as a human-readable YAML block (default)"
,
"zh"
:
"以人类可读 YAML 块输出（默认）"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Emit the record as a single JSON line"
,
"zh"
:
"以单行 JSON 输出"
}
}
,
"--raw"
:
{
"#desc"
:
{
"en"
:
"Emit only the canonical CWE id"
,
"zh"
:
"仅输出标准 CWE id"
}
}
,
"--no-refresh"
:
{
"#desc"
:
{
"en"
:
"Skip the automatic 30-day freshness check on the catalog"
,
"zh"
:
"跳过对目录的 30 天新鲜度检查"
}
}
,
"--offline"
:
{
"#desc"
:
{
"en"
:
"Use only the local cache; do not attempt to refresh"
,
"zh"
:
"仅使用本地缓存，不尝试刷新"
}
}
,
"--tag"
:
{
"#desc"
:
{
"en"
:
"Use a non-default cache tag"
,
"zh"
:
"使用非默认缓存标签"
}
}
}

