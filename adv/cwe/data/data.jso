{
"#tldr"
:
[
{
"cmd"
:
"x cwe data status"
,
"en"
:
"Show cache location, mirror, and catalog age"
,
"zh"
:
"显示缓存路径、镜像地址、目录年龄"
}
,
{
"cmd"
:
"x cwe data update"
,
"en"
:
"Re-download the catalog from MITRE"
,
"zh"
:
"从 MITRE 重新下载目录"
}
,
{
"cmd"
:
"x cwe data root"
,
"en"
:
"Print the cache root directory"
,
"zh"
:
"打印缓存根目录"
}
,
{
"cmd"
:
"x cwe data base"
,
"en"
:
"Print the upstream base URL the fetcher talks to"
,
"zh"
:
"打印 fetcher 所访问的上游基地址"
}
]
,
"status"
:
{
"#desc"
:
{
"en"
:
"Show cache directory, mirror, and catalog age (default subcommand)"
,
"zh"
:
"显示缓存目录、镜像地址、目录年龄（默认子命令）"
}
}
,
"update|refresh"
:
{
"#desc"
:
{
"en"
:
"Refresh the catalog from MITRE (forces re-download)"
,
"zh"
:
"从 MITRE 刷新目录（强制重新下载）"
}
}
,
"root"
:
{
"#desc"
:
{
"en"
:
"Print the on-disk cache root path"
,
"zh"
:
"打印本地缓存根路径"
}
}
,
"csv"
:
{
"#desc"
:
{
"en"
:
"Print the on-disk path of the cached 2000.csv"
,
"zh"
:
"打印已缓存 2000.csv 的本地路径"
}
}
,
"zip"
:
{
"#desc"
:
{
"en"
:
"Print the on-disk path of the cached 2000.csv.zip"
,
"zh"
:
"打印已缓存 2000.csv.zip 的本地路径"
}
}
,
"base"
:
{
"#desc"
:
{
"en"
:
"Print the upstream base URL (depends on --tag)"
,
"zh"
:
"打印上游基地址（取决于 --tag）"
}
}
,
"ensure"
:
{
"#desc"
:
{
"en"
:
"Download the catalog if missing or stale (30-day TTL)"
,
"zh"
:
"若目录缺失或过期则下载（30 天 TTL）"
}
}
,
"fetch"
:
{
"#desc"
:
{
"en"
:
"Fetch a single URL to a file (escape hatch)"
,
"zh"
:
"将单个 URL 下载到本地文件（高级接口）"
}
}
}

