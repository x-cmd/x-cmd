"文件路径"
}
}
,
"#desc"
:
{
"en"
:
"Attach a file as additional context (forwarded to `x agent request`)."
,
"cn"
:
"附加文件作为额外上下文（透传给 `x agent request`）。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Prompt text (use `-` or omit to read from stdin)."
,
"cn"
:
"提示文本（用 `-` 或省略以从 stdin 读取）。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"echo 'summarize: foo bar baz' | x ai request"
,
"en"
:
"Single-shot AI call via the configured harness."
,
"cn"
:
"通过当前 harness 发起单次 AI 调用。"
}
,
{
"cmd"
:
"x ai request --system 'You are concise.' 'TL;DR of Go generics'"
,
"en"
:
"Single-shot AI call with a custom system prompt."
,
"cn"
:
"使用自定义 system prompt 发起单次 AI 调用。"
}
]
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai review"
,
"en"
:
"Review unstaged changes."
,
"cn"
:
"审查未暂存的改动。"
}
,
{
"cmd"
:
"x ai review --yml --branch main"
,
"en"
:
"Review branch differences in YAML."
,
"cn"
:
"以 YAML 审查分支差异。"
}
,
{
"cmd"
:
"x ai commit --generate"
,
"en"
:
"Draft a commit subject from staged diff."
,
"cn"
:
"根据暂存区差异生成提交信息。"
}
,
{
"cmd"
:
"x ai translate --to zh README.md"
,
"en"
:
"Translate a README into Chinese."
,
