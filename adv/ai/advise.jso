{
"#name"
:
{
"ai"
:
null
,
"en"
:
"AI-powered shell helpers"
,
"cn"
:
"AI 驱动的 Shell 辅助命令"
}
,
"#desc"
:
{
"en"
:
"Code review, commit messages, translation, issue triage and changelog drafting from the shell."
,
"cn"
:
"在 Shell 中完成代码审查、提交信息生成、翻译、Issue 分流与更新日志撰写。"
}
,
"#synopsis"
:
[
"x ai <subcmd> [--options] [args]"
]
,
"#subcmd:workflow"
:
[
"review"
,
"commit"
,
"changelog"
]
,
"#subcmd:content"
:
[
"translate"
,
"reply"
,
"triage"
,
"spec"
]
,
"#subcmd:low level"
:
[
"request"
]
,
"review"
:
{
"#desc"
:
{
"en"
:
"AI code review over a file, directory, git diff, --staged set or branch range."
,
"cn"
:
"对文件、目录、git diff、--staged 暂存区或分支差异进行 AI 代码审查。"
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output the review as structured YAML."
,
"cn"
:
"以结构化 YAML 输出审查结果。"
}
}
,
"--json|-j"
:
{
"#desc"
:
{
"en"
:
"Output the review as raw text — pipe to jq for JSON."
,
"cn"
:
"以原始文本输出，可用 jq 处理。"
}
}
,
"--md|--markdown"
:
{
"#desc"
:
{
"en"
:
"Output the review as Markdown (default format)."
,
"cn"
:
"以 Markdown 格式输出（默认格式）。"
}
}
,
"--tsv|-t"
:
{
"#desc"
:
{
"en"
:
"Output the review as tab-separated values."
,
"cn"
:
"以 TSV 格式输出审查结果。"
}
}
,
"--staged"
:
{
"#desc"
:
{
"en"
:
"Review `git diff --cached` instead of the working tree."
,
"cn"
:
"审查 `git diff --cached` 而非工作区。"
}
}
,
"--branch"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"BRANCH"
,
"cn"
:
"分支名"
}
}
,
"#desc"
:
{
"en"
:
"Review diff from BRANCH...HEAD (e.g. --branch main)."
,
"cn"
:
"审查 BRANCH...HEAD 的差异（如 --branch main）。"
}
}
,
"--max-lines"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"Number of lines"
,
"cn"
:
"行数"
}
}
,
"#desc"
:
{
"en"
:
"Truncate large diffs to N lines (default 1500)."
,
"cn"
:
"截断大差异到 N 行（默认 1500）。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Path to file or directory to review (omit to use git diff)."
,
"cn"
:
"要审查的文件或目录路径（省略则使用 git diff）。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai review"
,
"en"
:
"Review unstaged working-tree changes."
,
"cn"
:
"审查未暂存的工作区改动。"
}
,
{
"cmd"
:
"x ai review --staged"
,
"en"
:
"Review staged changes."
,
"cn"
:
"审查已暂存的改动。"
}
,
{
"cmd"
:
"x ai review --yml --branch main"
,
"en"
:
"Review all changes since main, output YAML."
,
"cn"
:
"审查自 main 以来的全部改动，YAML 输出。"
}
,
{
"cmd"
:
"x ai review lib/main"
,
"en"
:
"Review a single file."
,
"cn"
:
"审查单个文件。"
}
]
}
,
"commit"
:
{
"#desc"
:
{
"en"
:
"Generate or validate Conventional Commits subjects from git history or staged diff."
,
"cn"
:
"基于 git 历史或暂存区差异生成或校验 Conventional Commits 提交信息。"
}
,
"--check"
:
{
"#desc"
:
{
"en"
:
"Validate commits in branch range against Conventional Commits, AI-suggest fixes."
,
"cn"
:
"校验分支范围内的提交是否符合 Conventional Commits 规范，让 AI 给出修正建议。"
}
}
,
"--generate|--gen"
:
{
"#desc"
:
{
"en"
:
"Draft a Conventional Commits subject for the staged diff (default if any staged changes)."
,
"cn"
:
"为暂存区差异生成 Conventional Commits 提交信息（有暂存改动时默认）。"
}
}
,
"--auto"
:
{
"#desc"
:
{
"en"
:
"Auto-pick generate vs. check based on staged state."
,
"cn"
:
"根据暂存状态自动选择 generate 或 check。"
}
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output the result as YAML."
,
"cn"
:
"以 YAML 输出结果。"
}
}
,
"--limit"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"Number of commits"
,
"cn"
:
"提交数"
}
}
,
"#desc"
:
{
"en"
:
"Cap commit-history scan at N commits (check mode, default 50)."
,
"cn"
:
"check 模式下最多扫描 N 个提交（默认 50）。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai commit --generate"
,
"en"
:
"Draft a commit subject from staged diff."
,
"cn"
:
"根据暂存区差异生成提交信息。"
}
,
{
"cmd"
:
"x ai commit --check"
,
"en"
:
"Check the branch for Conventional Commits compliance."
,
"cn"
:
"检查分支的提交是否符合 Conventional Commits 规范。"
}
,
{
"cmd"
:
"x ai commit --check --yml --limit 20"
,
"en"
:
"Check last 20 commits, YAML output."
,
"cn"
:
"检查最近 20 个提交，YAML 输出。"
}
]
}
,
"changelog"
:
{
"#desc"
:
{
"en"
:
"Draft a Keep-A-Changelog entry from commits since the last tag (or `--since REV`)."
,
"cn"
:
"根据自上次标签（或 `--since REV`）以来的提交生成更新日志条目。"
}
,
"--since|--from"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"REV"
,
"cn"
:
"版本引用"
}
}
,
"#desc"
:
{
"en"
:
"Lower bound of the commit range — any revision git accepts (tag, commit id, branch). Default: last tag."
,
"cn"
:
"提交范围的下界 —— 接受 git 任意版本引用（tag、commit id、分支均可）。默认：最近的标签。"
}
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output as YAML."
,
"cn"
:
"以 YAML 输出。"
}
}
,
"--json|-j"
:
{
"#desc"
:
{
"en"
:
"Output as JSON."
,
"cn"
:
"以 JSON 输出。"
}
}
,
"--md|--markdown"
:
{
"#desc"
:
{
"en"
:
"Output as Markdown (default format)."
,
"cn"
:
"以 Markdown 格式输出（默认格式）。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Optional path to a pre-computed commit log file."
,
"cn"
:
"可选：预先准备好的 commit 日志文件路径。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai changelog"
,
"en"
:
"Draft a changelog entry from HEAD to the last tag."
,
"cn"
:
"从 HEAD 到上一个标签生成更新日志。"
}
,
{
"cmd"
:
"x ai changelog --since v0.5.0"
,
"en"
:
"Draft a changelog entry from v0.5.0 to HEAD."
,
"cn"
:
"从 v0.5.0 到 HEAD 生成更新日志。"
}
]
}
,
"translate"
:
{
"#desc"
:
{
"en"
:
"Translate the contents of a file (or stdin) into `--to LANG` (default: en)."
,
"cn"
:
"将文件（或 stdin）内容翻译为 `--to LANG`（默认：en）。"
}
,
"--to"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"LANG"
,
"cn"
:
"语言代码"
}
}
,
"#desc"
:
{
"en"
:
"Target language (default: en)."
,
"cn"
:
"目标语言（默认：en）。"
}
}
,
"--from"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"LANG"
,
"cn"
:
"语言代码"
}
}
,
"#desc"
:
{
"en"
:
"Source language hint (default: auto)."
,
"cn"
:
"源语言提示（默认：自动识别）。"
}
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output as YAML."
,
"cn"
:
"以 YAML 输出。"
}
}
,
"--json|-j"
:
{
"#desc"
:
{
"en"
:
"Output as JSON."
,
"cn"
:
"以 JSON 输出。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Path to the file to translate, or `-` for stdin."
,
"cn"
:
"要翻译的文件路径，`-` 表示 stdin。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai translate --to zh README.md"
,
"en"
:
"Translate a README into Chinese."
,
"cn"
:
"将 README 翻译为中文。"
}
,
{
"cmd"
:
"cat msg.txt | x ai translate --to ja"
,
"en"
:
"Translate a piped message into Japanese."
,
"cn"
:
"将管道消息翻译为日文。"
}
]
}
,
"reply"
:
{
"#desc"
:
{
"en"
:
"Draft a short AI reply in a chosen persona. Input text is passed through verbatim — whitespace, tabs and formatting are preserved."
,
"cn"
:
"以指定角色生成简短 AI 回复。输入内容原样传递，空白、制表符与格式均不被修改。"
}
,
"--persona|--as"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"NAME"
,
"cn"
:
"角色名"
}
}
,
"#desc"
:
{
"en"
:
"Reply persona (default: helpful assistant)."
,
"cn"
:
"回复角色（默认：helpful assistant）。"
}
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output as YAML."
,
"cn"
:
"以 YAML 输出。"
}
}
,
"--json|-j"
:
{
"#desc"
:
{
"en"
:
"Output as JSON."
,
"cn"
:
"以 JSON 输出。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Text to reply to, passed through verbatim. Combine with `-`/`--pipe` to append stdin as a <STDIN> section."
,
"cn"
:
"要回复的内容，原样传递不做修改。可与 `-`/`--pipe` 组合，将 stdin 追加为 <STDIN> 区块。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai reply --persona senior \"thanks for the PR — please rebase\""
,
"en"
:
"Reply as a senior maintainer."
,
"cn"
:
"以资深维护者身份回复。"
}
,
{
"cmd"
:
"x ai reply - < issue.md"
,
"en"
:
"Draft a reply from a piped issue body."
,
"cn"
:
"根据管道输入的 issue 内容起草回复。"
}
]
}
,
"triage"
:
{
"#desc"
:
{
"en"
:
"AI triage of an issue/PR body — priority, area, labels, blockers."
,
"cn"
:
"对 issue/PR 内容进行 AI 分流 — 优先级、所属模块、标签与阻塞项。"
}
,
"--labels"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"LABELS"
,
"cn"
:
"标签列表"
}
}
,
"#desc"
:
{
"en"
:
"Comma-separated candidate label set to choose from."
,
"cn"
:
"可选的候选标签集合（逗号分隔）。"
}
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output as YAML."
,
"cn"
:
"以 YAML 输出。"
}
}
,
"--json|-j"
:
{
"#desc"
:
{
"en"
:
"Output as JSON."
,
"cn"
:
"以 JSON 输出。"
}
}
,
"--md|--markdown"
:
{
"#desc"
:
{
"en"
:
"Output as Markdown (default format)."
,
"cn"
:
"以 Markdown 格式输出（默认格式）。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Path to issue body, or `-` for stdin."
,
"cn"
:
"issue 内容路径，`-` 表示 stdin。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai triage issue.md"
,
"en"
:
"Triage the issue body in issue.md."
,
"cn"
:
"对 issue.md 中的内容进行 triage。"
}
,
{
"cmd"
:
"x ai triage --labels bug,security,chore"
,
"en"
:
"Triage with custom label set."
,
"cn"
:
"使用自定义标签集进行 triage。"
}
]
}
,
"spec"
:
{
"#desc"
:
{
"en"
:
"Generate a structured spec (goal, non-goals, design, milestones) for a topic."
,
"cn"
:
"为某个主题生成结构化规格说明（目标、非目标、设计、里程碑）。"
}
,
"--yml|--yaml"
:
{
"#desc"
:
{
"en"
:
"Output as YAML."
,
"cn"
:
"以 YAML 输出。"
}
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"Topic description (free text)."
,
"cn"
:
"主题描述（自由文本）。"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x ai spec offline cache for repo metadata"
,
"en"
:
"Draft a spec for an offline metadata cache."
,
"cn"
:
"为离线元数据缓存起草规格说明。"
}
]
}
,
"request"
:
{
"#desc"
:
{
"en"
:
"Low-level escape hatch — passthrough to `x agent request`. Use `x ask --quick` for clean one-shot answers."
,
"cn"
:
"底层透传 —— 直接调用 `x agent request`。需要纯净输出请用 `x ask --quick`。"
}
,
"--system"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"PROMPT"
,
"cn"
:
"提示文本"
}
}
,
"#desc"
:
{
"en"
:
"System prompt to prepend."
,
"cn"
:
"前置 system prompt。"
}
}
,
"--harness"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"NAME"
,
"cn"
:
"名称"
}
}
,
"#desc"
:
{
"en"
:
"Forward `--harness NAME` to `x agent request`."
,
"cn"
:
"透传 `--harness NAME` 给 `x agent request`。"
}
}
,
"--json"
:
{
"#desc"
:
{
"en"
:
"Ask the model to respond in JSON (forwarded to `x agent request`)."
,
"cn"
:
"要求模型以 JSON 形式回复（透传给 `x agent request`）。"
}
}
,
"--file|-f"
:
{
"#1"
:
{
"#desc"
:
{
"en"
:
"PATH"
,
"cn"
