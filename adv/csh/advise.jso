{
"#name"
:
{
"tcsh"
:
null
,
"en"
:
"Enhanced modules for tcsh"
}
,
"#desc"
:
{
"en"
:
"tcsh is essentially the C shell with programmable command-line completion, command-line editing, and a few other features.\nThis module mainly provides support for calling the x-cmd toolset on tcsh; and add features such as chatting with @gpt and ChatGPT, and generating tcsh commands with LLMs.\n"
}
,
"#subcmd:Enhance"
:
[
"setup|--setup"
]
,
"setup|--setup"
:
{
"#subcmd"
:
true
,
"#desc"
:
{
"en"
:
"Inject x-cmd into the tcsh environment"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x tcsh setup"
,
"en"
:
"Modify the $HOME/.tcshrc file to introduce the x-cmd toolkit (including the x command, c command, @gpt, comma command, etc.) into the tcsh environment."
}
]
,
"#other"
:
{
"en"
:
{
"Please visit our homepage for more information:"
:
"https://x-cmd.com/mod/tcsh"
}
}
}

