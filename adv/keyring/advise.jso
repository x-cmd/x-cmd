}
]
,
"#synopsis"
:
[
"x keyring cls [--ns <name>] [-a] [<service>]"
]
,
"--ns|--namespace"
:
{
"#desc"
:
{
"cn"
:
"namespace 名(默认 x-cmd-keyring,跨 Apple 设备共享)"
,
"en"
:
"namespace name (default x-cmd-keyring, shared across Apple devices)"
}
}
,
"-a|--all"
:
{
"#desc"
:
{
"cn"
:
"列所有 namespace"
,
"en"
:
"list every namespace"
}
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"可选 service 过滤"
,
"en"
:
"optional service filter"
}
}
}
,
"crm"
:
{
"#desc"
:
{
"cn"
:
"iCloud Keychain 删除(macOS-only)"
,
"en"
:
"iCloud Keychain delete (macOS-only)"
}
,
"#synopsis"
:
[
"x keyring crm [--ns <name>] <service>"
]
,
"--ns|--namespace"
:
{
"#desc"
:
{
"cn"
:
"namespace 名(默认 x-cmd-keyring)"
,
"en"
:
"namespace name (default x-cmd-keyring)"
}
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"service 名"
,
"en"
:
"service name"
}
}
}
,
"backend"
:
{
"#desc"
:
{
"cn"
:
"切换 / 查询 OS 后端(keychain / secret_service / kwallet / windows / null)"
,
"en"
:
"Switch or query the OS backend (keychain / secret_service / kwallet / windows / null)"
}
,
"#synopsis"
:
[
"x keyring backend ls|get|set"
]
,
"#tip"
:
[
{
"cn"
:
"优先级:env > marker 文件 > OS 自动识别(Darwin = keychain, Linux = secret_service, Windows = 本地 Credential Manager)。"
,
"en"
:
"Priority: env > marker file > OS autodetect (Darwin = keychain, Linux = secret_service, Windows = local Credential Manager)."
}
,
{
"cn"
:
"`windows` 后端:Windows 上用 Credential Manager 存储(`x keyring backend set windows`);首次调用带 ~1s 冷启动,适合少调场景。"
,
"en"
:
"`windows` backend: stores in Windows Credential Manager (`x keyring backend set windows`); first call has ~1s cold start, fine for low-frequency access."
}
,
{
"cn"
:
"`null` = 禁用 keyring,适合 CI / sandbox。"
,
"en"
:
"`null` = disable keyring; useful for CI / sandbox."
}
]
,
"#tldr"
:
[
{
"cmd"
:
"x keyring backend ls"
,
"cn"
:
"列出所有可用后端"
,
"en"
:
"List available backends"
}
,
{
"cmd"
:
"x keyring backend get"
,
"cn"
:
"打印当前生效的后端"
,
"en"
:
"Show the active backend"
}
,
{
"cmd"
:
"x keyring backend set secret_service"
,
"cn"
:
"pin 到 secret_service"
,
"en"
:
"Pin to secret_service"
}
,
{
"cmd"
:
"x keyring backend set windows"
,
"cn"
:
"pin 到 Windows Credential Manager"
,
"en"
:
"Pin to Windows Credential Manager"
}
,
{
"cmd"
:
"x keyring backend set null"
,
"cn"
:
"禁用 keyring(拒所有调用)"
,
"en"
:
"Disable the keychain entirely (refuses all ops)"
}
]
}
}

