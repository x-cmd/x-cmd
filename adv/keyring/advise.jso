"printf '%s' \"$pw\" | x keyring set github alice"
,
"cn"
:
"脚本里 pipe stdin(推荐 printf,不要 echo)"
,
"en"
:
"Pipe via stdin in a script (prefer printf, not echo)"
}
,
{
"cmd"
:
"x keyring set --ns deploy-bot github alice"
,
"cn"
:
"覆盖默认 namespace,让 deploy 脚本独立于 x-cmd-<UID>"
,
"en"
:
"Override the default namespace so deploy-bot has its own slot"
}
]
,
"--ns|--namespace"
:
{
"#desc"
:
{
"cn"
:
"namespace 名(默认 x-cmd-<UID>)"
,
"en"
:
"namespace name (default x-cmd-<UID>)"
}
}
,
