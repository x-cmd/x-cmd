,
"en"
:
"Language (zh_cn / en_us / ja_jp, default zh_cn)"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"语言"
,
"en"
:
"Language"
}
}
}
,
"--id_type"
:
{
"#synopsis"
:
"<id_type>"
,
"#desc"
:
{
"cn"
:
