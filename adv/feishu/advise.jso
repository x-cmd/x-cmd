:
[
{
"cmd"
:
"x feishu abot send --file --chatid <chat_id> /path/to/file.pdf"
,
"cn"
:
"发送文件到指定会话"
,
"en"
:
"Send file to specified chat"
}
,
{
"cmd"
:
"x feishu abot send --file --chatid <chat_id> --fp /path/to/file.pdf"
,
"cn"
:
"发送文件并保存到数据文件"
,
"en"
:
"Send file and save it to the data file"
}
]
}
,
"--card"
:
{
"#subcmd"
:
true
,
"#desc"
:
{
"cn"
:
"发送 Markdown 卡片消息（基于飞书 Schema 2.0 interactive 卡片，支持代码块、表格等完整 Markdown 渲染）"
,
"en"
:
"Send a Markdown card message (Feishu Schema 2.0 interactive card, supports full Markdown including code blocks and tables)"
}
,
"--chatid"
:
{
"#synopsis"
:
"<chat_id>"
,
"#desc"
:
{
"cn"
:
"会话 ID"
,
"en"
:
"Chat ID"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"会话 ID"
,
"en"
:
"Chat ID"
}
}
}
,
"--messageid"
:
{
"#synopsis"
:
"<message_id>"
,
"#desc"
:
{
"cn"
:
"目标消息 ID；指定后将以回复该消息的形式发送（走回复接口，此时可省略 --chatid）"
,
"en"
:
"Target message ID; when set, delivers as a reply to that message (uses the reply API; --chatid can be omitted)"
}
,
"#1"
:
{
"#desc"
:
{
"cn"
:
"目标消息 ID"
,
"en"
:
"Target message ID"
}
}
}
,
"-f|--file"
:
{
"#synopsis"
:
"<path>"
,
"#desc"
:
{
"cn"
:
"从指定文件读取 Markdown 内容"
,
"en"
:
"Read Markdown content from a file"
}
}
,
"--fp"
:
{
"#desc"
:
{
"cn"
:
"将发送的卡片内容记录到数据文件"
,
"en"
:
"Record sent card content to the data file"
}
}
,
"-j|--json"
:
{
"#desc"
:
{
"cn"
:
"输出飞书 API 原始 JSON 响应"
,
"en"
:
"Output raw JSON response from Feishu API"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x feishu abot send --card --chatid <chat_id> -f ./README.md"
,
"cn"
:
"把 Markdown 文件作为卡片发送（最常用）"
,
"en"
:
"Send a Markdown file as a card (most common)"
}
,
{
"cmd"
:
"x feishu abot send --card --chatid <chat_id> '**任务完成** ✅ 详见 [构建报告](https://github.com/x-cmd/x-cmd)'"
,
"cn"
:
"单行 Markdown 直接传字符串（支持加粗、链接、emoji）"
,
"en"
:
"Send a single-line Markdown string (bold, links, emoji supported)"
}
,
{
"cmd"
:
"git log --oneline -10 | x feishu abot send --card --chatid <chat_id> -"
,
"cn"
:
"通过管道从 stdin 读取命令输出作为卡片正文"
,
"en"
:
"Pipe command output from stdin as the card body"
}
]
}
}
