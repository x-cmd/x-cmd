,
"#desc"
:
{
"en"
:
"List all organizations"
,
"zh"
:
"罗列所有组织"
}
,
"#tldr"
:
[
{
"cmd"
:
"x gh org ls"
,
"en"
:
"List all organizations for the user"
,
"zh"
:
"罗列当前用户参与的所有组织"
}
,
{
"cmd"
:
"x gh org ls --user <user>"
,
"en"
:
"List all organizations for the <user>"
,
"zh"
:
"罗列 <user> 用户参与的所有组织"
}
]
}
,
