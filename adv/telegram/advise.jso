:
[
"--poll"
,
"--stop_poll"
]
,
"#desc"
:
{
"zh"
:
"使用 Telegram 群机器人发送消息（等同于 x telegram bot send）"
,
"en"
:
"Send messages using a Telegram group bot (equivalent to `x telegram bot send`)"
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram send --text \"x-cmd v1.0 released successfully\""
,
"zh"
:
"发送文本消息到 Telegram 群"
,
"en"
:
"Send text type messages to Telegram group"
}
,
{
"cmd"
:
"x telegram send --text --chatid \"@channelusername\" \"x-cmd v1.0 released successfully\""
,
"zh"
:
"发送文本消息到 Telegram 频道"
,
"en"
:
"Send text type messages to Telegram channel"
}
,
{
"cmd"
:
"x telegram send --text --chatid \"-967810017\" --fp \"x-cmd v1.0 released successfully\""
,
"zh"
:
"发送文本消息并保存到数据文件"
,
"en"
:
"Send text message and save it to the data file"
}
,
{
"cmd"
:
"x telegram send --image --chatid \"-967810017\" --file_path ./a.png"
,
"zh"
:
"发送 a.png 图片到 Telegram 群"
,
"en"
:
"Send a.png images to Telegram group"
}
]
