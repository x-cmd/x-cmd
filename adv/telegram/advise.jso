"cmd"
:
"x telegram bot send --poll --chatid \"-967810017\" --question \"A Test\" --options test1,test2"
,
"zh"
:
"发送投票消息到 Telegram 群"
,
"en"
:
"Send a poll to a Telegram group"
}
]
,
"--question"
:
{
"#desc"
:
{
"zh"
:
"投票的问题（1-300字）"
,
"en"
:
"Poll question, 1-300 characters"
}
}
,
"--options"
:
{
"#desc"
:
{
"zh"
:
"一个包含 2 到 10 个答案选项的列表"
,
"en"
:
"A list of 2-10 answer options"
}
}
,
"--chatid"
:
{
"#desc"
:
{
"zh"
:
"群 ID 或频道用户名（格式为 @频道用户名）"
,
"en"
:
"Unique identifier for the target chat or username of the target channel (in the format @channelusername)"
}
}
,
"--token"
:
{
"#desc"
:
{
"zh"
:
"指定群机器人发送消息所用的 token"
,
"en"
:
"The token used by the specified group of bots to send messages"
}
}
,
"--fp"
:
{
"#desc"
:
{
"zh"
:
"将发送的消息内容记录到数据文件"
,
"en"
:
"Record sent message content to the data file"
}
}
}
,
