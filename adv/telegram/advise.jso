,
"en"
:
"Send text type messages to Telegram channel"
}
,
{
"cmd"
:
"x telegram bot send --text --chatid \"-967810017\" --fp \"x-cmd v1.0 released successfully\""
,
"zh"
:
"发送文本消息并保存到数据文件"
,
"en"
:
"Send text message and save it to the data file"
}
,
{
"cmd"
:
"x telegram bot send --image --chatid \"-967810017\" --file_path ./a.png"
,
"zh"
:
"发送 a.png 图片到 Telegram 群"
,
"en"
:
"Send a.png images to Telegram group"
}
]
,
