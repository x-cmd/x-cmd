:
"Send messages using a Telegram group bot"
}
,
"send"
:
{
"#subcmd:Multimedia"
:
[
"--file"
,
"--image"
,
"--video"
,
"--audio"
,
"--voice"
,
"--animation"
,
"--video_note"
]
,
"#subcmd:Location"
:
[
"--venue"
,
"--location"
]
,
"#subcmd:Poll"
:
[
"--poll"
,
"--stop_poll"
]
,
"#desc"
:
{
"zh"
:
"使用 Telegram 群机器人发送消息"
,
"en"
:
"Send messages using a Telegram group bot"
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram bot send --text \"x-cmd v1.0 released successfully\""
,
"zh"
:
"发送文本消息到 Telegram 群"
,
"en"
:
"Send text type messages to Telegram group"
}
,
{
"cmd"
:
"x telegram bot send --text --chatid \"@channelusername\" \"x-cmd v1.0 released successfully\""
,
"zh"
:
