"service"
:
{
"#desc"
:
{
"zh"
:
"管理网关服务"
,
"en"
:
"Manage Gateway Service"
}
,
"start"
:
{
"#desc"
:
{
"zh"
:
"启动网关服务"
,
"en"
:
"Start Gateway service"
}
}
,
"stop"
:
{
"#desc"
:
{
"zh"
:
"停止网关服务"
,
"en"
:
"Stop Gateway service"
}
}
,
"status"
:
{
"#desc"
:
{
"zh"
:
"查看网关服务"
,
"en"
:
"Show gateway service status + probe the Gateway"
}
}
,
"log"
:
{
"#desc"
:
{
"zh"
:
"查看网关服务日志"
,
"en"
:
"Show gateway service log"
}
}
}
,
"data"
:
{
"#desc"
:
{
"zh"
:
"管理 Telegram 机器人数据文件"
,
"en"
:
"Manage Telegram bot data files"
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram bot data which <chat_id>"
,
"zh"
:
"查看指定会话的数据文件路径"
,
"en"
:
"Show data file path for specified chat"
}
,
{
"cmd"
:
"x telegram bot data get <chat_id>"
,
"zh"
:
"输出已发送的消息记录"
,
"en"
:
"Output sent message records"
}
]
,
"get"
:
{
"#desc"
:
{
"zh"
:
"输出已发送的消息记录"
,
"en"
:
"Output sent message records"
}
,
"#1"
:
{
"#synopsis"
:
"<chat_id>"
,
"#desc"
:
{
"zh"
:
"会话 ID"
,
"en"
:
"Chat ID"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram bot data get <chat_id>"
,
"zh"
:
"输出该会话已发送的消息记录"
,
"en"
:
"Output sent message records for the specified chat"
}
]
}
}
}
,
"listen"
:
{
"#desc"
:
{
"zh"
:
"长轮询监听 Telegram 消息"
,
"en"
:
"Long-poll for Telegram messages"
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram listen"
,
"zh"
:
"启动长轮询监听 Telegram 消息"
,
"en"
:
"Start long-polling listener for Telegram messages"
}
,
{
"cmd"
:
"x telegram listen --fp"
,
"zh"
:
"启动监听并保存消息到数据文件"
,
"en"
:
"Start listener and save messages to data file"
}
,
{
"cmd"
:
"x telegram listen --json"
,
"zh"
:
"以 JSON 格式输出消息"
,
"en"
:
"Output messages in JSON format"
}
]
,
"--fp"
:
{
"#desc"
:
{
"zh"
:
"将接收到的消息保存到数据文件"
,
"en"
:
"Save received messages to data file"
}
}
,
"--json"
:
{
"#desc"
:
{
"zh"
:
"以 JSON 格式输出消息"
,
"en"
:
"Output messages in JSON format"
}
}
,
"--timeout"
:
{
"#desc"
:
{
"zh"
:
"超时时间（秒）"
,
"en"
:
"Timeout in seconds"
}
}
,
"--offset"
:
{
"#desc"
:
{
"zh"
:
"起始 offset"
,
"en"
:
"Starting offset"
}
}
}
,
"parse"
:
{
"#desc"
:
{
"zh"
:
"解析 Telegram 消息数据，自动下载媒体文件"
,
"en"
:
"Parse Telegram messages, automatically download media files"
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram parse -967810017 1:10"
,
"zh"
:
"解析群 -967810017 第 1 到 10 行消息记录"
,
"en"
:
"Parse message records from line 1 to 10 for chat -967810017"
}
,
{
"cmd"
:
"x telegram parse -967810017 5"
,
"zh"
:
"解析群 -967810017 第 5 行起的消息记录"
,
"en"
:
"Parse message records starting from line 5 for chat -967810017"
}
]
,
"#1"
:
{
"#synopsis"
:
"<chatid>"
,
"#desc"
:
{
"zh"
:
"Telegram 群 ID 或频道 ID"
,
"en"
:
"Telegram chat ID or channel ID"
}
}
,
"#2"
:
{
"#synopsis"
:
"<range>"
,
"#desc"
:
{
"zh"
:
"消息行号范围，格式为 start:end 或 start"
,
"en"
:
"Message line range, format as start:end or start"
}
}
}
,
"init"
:
{
"#desc"
:
{
"en"
:
"Initialize the configuration using interactive mode"
,
"zh"
:
"使用交互模式初始化配置"
}
}
,
"react"
:
{
"#desc"
:
{
"zh"
:
"监听 Telegram 消息，根据指定模式自动回复消息"
,
"en"
:
"Listen for Telegram messages and reply automatically based on the specified mode"
}
,
"#tldr"
:
[
{
"cmd"
:
"x telegram react"
,
"zh"
:
"启动默认模式（echo模式），原文返回"
,
"en"
:
"Start in default mode (echo), returning the original message"
}
,
{
"cmd"
:
"x telegram react --runner repl"
,
"zh"
:
"启动交互式指令模式，将收到的消息作为命令执行并返回结果"
,
"en"
:
"Start interactive REPL mode, executing messages as commands and returning output"
}
,
{
"cmd"
:
"x telegram react --runner echo"
,
"zh"
:
"启动简单回显服务，测试通信是否正常"
,
"en"
:
"Start a simple echo service to test if communication is working"
}
