"#tldr"
:
[
{
"cmd"
:
"x theme ls --info"
,
"en"
:
"List the theme information of all current environments"
,
"zh"
:
"罗列当前所有环境的主题信息"
,
"de"
:
"Die Theme-Informationen aller aktuellen Umgebungen auflisten"
,
