,
"#tldr"
:
[
{
"cmd"
:
"x claude"
,
"zh"
:
"使用 Claude Code"
,
"en"
:
"Use Claude Code"
}
,
{
"cmd"
:
"x claude sess"
,
"zh"
:
"启动 FZF App，以交互方式浏览和管理本地会话"
,
"en"
:
"Launch the FZF app to interactively browse and manage local sessions"
}
,
{
"cmd"
:
"x claude attribution rm"
,
"zh"
:
"移除 Claude Code 在每次提交时自动添加的 Co-Author 签名"
,
"en"
:
"Remove Claude Code's automatic Co-Author signature from commits"
}
,
{
"cmd"
:
"x claude stl setup"
,
"zh"
:
"设定 Claude Code 状态栏使用 el 主题（默认主题）"
,
"en"
:
"Set up the Claude Code statusline using the el theme (default)"
}
,
{
"cmd"
:
"x claude usage"
,
"zh"
:
"统计最近 7 天的 token 使用情况和成本"
,
"en"
:
"Show token usage and costs for the last 7 days"
}
,
{
"cmd"
:
"x claude ds"
,
"zh"
:
"启动 claude-code 并接入 DeepSeek V4 模型"
,
"en"
:
"Launch claude-code and connect to the DeepSeek V4 model."
}
,
{
"cmd"
:
"x claude use minimax"
,
"zh"
:
"配置 claude-code 使用 MiniMax Coding Plan"
,
"en"
:
"Configure claude-code to use the MiniMax Coding Plan"
}
,
{
"cmd"
:
"x claude use other \"https://token-plan-cn.xiaomimimo.com/anthropic\" MIMO_API_KEY mimo-v2.5-pro"
,
"zh"
:
"配置 claude-code 使用 Xiaomi Token Plan 套餐"
,
"en"
:
"Configure claude-code to use Xiaomi Token Plan"
}
]
}

