}
}
,
"rm"
:
{
"#desc"
:
{
"zh"
:
"删除用户或项目中的 skill"
,
"en"
:
"Remove a skill from the user or project"
}
,
"--global|-g"
:
{
"#desc"
:
{
"zh"
:
"在全局用户环境中删除 skill"
,
"en"
:
"Remove the skill from the global user environment"
}
}
,
"#1"
:
{
"#desc"
:
{
"zh"
:
"要删除的 skill ID"
,
"en"
:
"Skill ID to remove"
}
,
"#exec:stdout"
:
"___x_cmd skill --advise_list_active \".claude/skills\" \"$HOME/.claude/skills\""
}
}
,
"use"
:
{
"#desc"
:
{
"zh"
:
"在全局用户环境中启用指定 skill，相当于 add --global"
,
"en"
:
"Enable the specified skill in the global user environment, equivalent to add --global"
}
,
"#1"
:
{
"#desc"
:
{
"zh"
:
"要添加的 skill ID"
,
"en"
:
"Skill ID to add"
}
,
"#exec:stdout"
:
"___x_cmd skill --advise_list_full"
}
}
,
"unuse"
:
{
"#desc"
:
{
"zh"
:
"在全局用户环境中停用指定的 skill，相当于 rm --global"
,
"en"
:
"Disable the specified skill in the global user environment, equivalent to rm --global"
}
,
"#1"
:
{
"#desc"
:
{
"zh"
:
"要删除的 skill ID"
,
"en"
:
"Skill ID to remove"
}
,
"#exec:stdout"
:
"___x_cmd skill --advise_list_active \"$HOME/.claude/skills\""
}
}
,
"suggest"
:
{
"#desc"
:
{
"zh"
:
"根据当前项目的上下文文件，生成推荐的 skill 列表"
,
"en"
:
"Generate recommended skills list based on the current project context files."
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x claude skill ll"
,
"zh"
:
"列出可以添加的技能模板"
,
"en"
:
"List available skill templates"
}
,
{
"cmd"
:
"x claude skill ls"
,
"zh"
:
"列出用户和项目中的技能"
,
"en"
:
"List skills in user and project directories"
}
,
{
"cmd"
:
"x claude skill add anthropics/docx"
,
"zh"
:
"在当前项目环境中添加 anthropics 的 docx skill"
,
"en"
:
"Add anthropics’ docx skill to the current project environment"
}
,
{
"cmd"
:
"x claude skill use anthropics/docx"
,
"zh"
:
"在全局用户环境中启用 anthropics 的 docx skill"
,
"en"
:
"Enable anthropics’ docx skill in the global user environment"
}
]
}
