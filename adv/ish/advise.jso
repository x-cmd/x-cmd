:
"iSH Utility, Note that this module is in the experimental stage"
}
,
"#desc"
:
{
"en"
:
"The ish module integrates various utility functions that iSH users may need.\n"
}
,
"cr"
:
{
"#desc"
:
{
"en"
:
"Change the iSH software source mirror to speed up package downloads and update the alpine version."
}
,
"#tldr"
:
[
{
"cmd"
:
"x ish cr"
,
"en"
:
"Enter the interface for changing software source image."
}
]
}
,
"#tldr"
:
[
{
"cmd"
:
"m"
,
"en"
:
"x-cmd in ish environment defaults to m as an abbreviation for x ish, m is the first letter of word machine"
}
,
{
"cmd"
:
"x ish ver"
,
"en"
:
"Check the version of iSH"
}
,
{
"cmd"
:
"x ish prep"
,
"en"
:
"Prepare the iSH environment by installing the useful packages"
}
,
{
"cmd"
:
"x ish cr"
,
"en"
:
"Change apk repo to v3.18 by default, then update"
}
,
{
"cmd"
:
"x ish ka"
,
"en"
:
"Keep the app running in the background using location permissions, note that you need to authorize it as always in settings"
}
]
,
"#other"
:
{
"en"
:
{
"Please visit our homepage for more information:"
