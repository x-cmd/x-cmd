{
"#name"
:
{
"dnf"
:
null
,
"en"
:
"dnf command enhancements"
,
"zh"
:
"dnf 命令增强"
}
,
"#subcmd_help_tip"
:
true
,
"#subcmd:Enhance"
:
[
"install"
,
"mirror"
,
"proxy"
,
"fz"
]
,
"#tldr"
:
[
{
"cmd"
:
"x dnf"
,
"en"
:
"Use the interactive app to search for all available packages"
,
"zh"
:
"使用交互式 APP 搜索所有可用的软件包"
}
,
{
"cmd"
:
"x dnf mirror set ali"
,
"en"
:
"Set the mirror source of dnf to Aliyun mirror"
,
"zh"
:
"设置 dnf 的镜像源为阿里云镜像站"
}
,
{
"cmd"
:
"x dnf mirror ls"
,
"en"
:
"List the available mirror source"
,
"zh"
:
"列出当前可用的镜像源"
}
,
{
"cmd"
:
"x dnf install curl"
,
"en"
:
"Install curl using dnf"
,
"zh"
:
"使用 dnf 安装 curl"
}
,
{
"cmd"
:
"x dnf proxy use http://127.0.0.0:8888"
,
"en"
:
"Set the proxy used for dnf"
,
"zh"
:
"设置 dnf 使用的代理"
}
]
,
"nv"
:
{
"#tag"
:
[
"inner"
]
,
"#desc"
:
{
"en"
:
"Use the interactive UI to select which apps to install"
,
"zh"
:
"使用交互式 UI 来选择需要安装的应用"
}
}
,
"fz"
:
{
"#desc"
:
{
"en"
:
"Using fzf as an interactive UI to select the applications you want to install"
,
"zh"
:
"使用 fzf 作为交互式 UI 来选择需要安装的应用"
}
}
,
"install"
:
{
"#desc"
:
{
"en"
:
"Install applications using dnf"
,
"zh"
:
"通过 dnf 安装应用"
}
}
,
"mirror"
:
{
"#desc"
:
{
"en"
:
"Setting the dnf mirror for debian/ubuntu"
,
"zh"
:
"设置 dnf 的镜像源"
}
,
"$ref"
:
"x-advise://dnf/data/mirror.jso"
}
,
"proxy"
:
{
"#desc"
:
{
"en"
:
"Display or change the current proxy used for dnf"
,
"zh"
:
"显示或更改 dnf 当前使用的代理"
}
,
"use"
:
{
"#desc"
:
{
"en"
:
"Set the proxy used for dnf"
,
"zh"
:
"设置 dnf 使用的代理"
}
}
,
"unuse"
:
{
"#desc"
:
{
"en"
:
"Unset the proxy used for dnf"
,
"zh"
:
"取消设置 dnf 使用的代理"
}
}
,
"try"
:
{
"#desc"
:
{
"zh"
:
"设置仅对当前 Shell 有效的代理"
,
"en"
:
"Set a proxy that is only valid for the current Shell"
}
}
,
"untry"
:
{
"#desc"
:
{
"zh"
:
"取消设置仅对当前 Shell 有效的代理"
,
"en"
:
"Unset a proxy that is only valid for the current Shell"
}
}
,
"run"
:
{
"#desc"
:
{
"zh"
:
"运行代理的代码"
,
"en"
:
"Run the code of the proxy"
}
}
,
"#tldr"
:
[
{
"cmd"
:
"x dnf proxy use http://127.0.0.1:8234"
,
"en"
:
"Set the proxy used for dnf"
,
"zh"
:
"设置 dnf 使用的代理"
}
,
{
"cmd"
:
"x dnf proxy try http://127.0.0.1:8234"
,
"zh"
:
"设置临时的仅对当前 shell 有效的代理（优先级比 use 高）"
,
"en"
:
"Set a temporary proxy that is only valid for the current Shell"
}
]
}
,
"#n"
:
{
"#desc"
:
{
"en"
:
"extends `dnf` subcmd or options"
,
"zh"
:
"继承 `dnf` 子命令或参数选项"
}
,
"#exec"
:
"___x_cmd_advise__comp_from_xcmd $((offset-1))"
}
,
"#other"
:
{
"en"
:
{
"Please visit our homepage for more information:"
:
"https://x-cmd.com"
}
,
"zh"
:
{
"请访问我们的主页以获取更多信息："
:
"https://x-cmd.com"
}
}
}

