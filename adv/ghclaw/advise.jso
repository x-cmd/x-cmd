}
,
"#1"
:
{
"#desc"
:
{
"en"
:
"GitHub username"
,
"cn"
:
"GitHub 用户名"
}
}
}
,
"--interval"
:
{
"#desc"
:
{
"en"
:
"Poll interval, human time (e.g. 30s, 1min, 2h30m); default 60s"
,
"cn"
:
"轮询间隔，人性化时间（如 30s、1min、2h30m），默认 60 秒"
}
,
"#1"
:
{
"#desc"
:
{
"en"
:
