}
}
,
"-m"
:
{
"#desc"
:
{
"zh"
:
"Whisper 模型 (默认: base, 实时用)"
,
"en"
:
"Whisper model (default: base, for real-time)"
}
}
,
"-l"
:
{
"#desc"
:
{
"zh"
:
"语言代码 (默认: auto)"
,
"en"
:
"Language code (default: auto)"
}
}
,
