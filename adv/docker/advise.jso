}
,
"$ref"
:
"x-advise://docker/data/images.jso"
}
,
"ecpull"
:
{
"#desc"
:
{
"en"
:
"Pull Docker base images from Amazon ECR"
,
"zh"
:
"通过 Amazon ECR 拉取 Docker 基础镜像"
}
,
"#tldr"
:
[
{
"cmd"
:
"x docker ecpull alpine"
,
"zh"
:
"从 ECR 拉取 alpine 镜像"
,
"en"
:
"Pull the alpine image from ECR"
}
,
{
"cmd"
:
"x docker ecpull ubuntu:20.04"
,
"zh"
:
"从 ECR 拉取带有特定标签的 ubuntu 镜像（如 20.04）"
,
"en"
:
"Pull the ubuntu image with a specific tag (e.g., 20.04) from ECR"
}
]
}
,
"container"
:
{
"#desc"
:
{
"en"
:
"Manage containers"
,
"zh"
:
"管理容器"
}
,
"--app"
:
{
"#desc"
:
{
"en"
:
"Managing Docker Containers with Interactive Tables"
,
"zh"
:
"使用交互表格管理 Docker 容器"
}
}
,
"$ref"
:
"x-cmd-advise://docker/data/container/advise.t.jso"
}
,
