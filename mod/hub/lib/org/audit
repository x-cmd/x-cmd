# shellcheck shell=dash

# 审计日志查询（admin+；detail 已由服务端按角色脱敏——owner 全量 / admin 打码）

___x_cmd_hub_org_audit(){
    local X_help_cmd='___x_cmd_hub___help org audit'
    help:arg-null:parse

    local op="${1:-ls}"
    case "$op" in
        ls)     shift
            "___x_cmd_hub_org_audit_$op" "$@"                 ;;
        *) ___x_cmd_hub_u_subcmd_invalid org audit "$@"       ;;
    esac
}

___x_cmd_hub_org_audit_ls(){
    local X_help_cmd='___x_cmd_hub___help org audit ls'
    help:arg-null:parse

    local org=; local action=; local page=1; local limit=20
    while [ $# -gt 0 ]; do
        case "$1" in
            --org)          org="$2";    shift 2 ;;
            --action)       action="$2"; shift 2 ;;
            --page|-p)      page="$2";   shift 2 ;;
            --limit|-l)     limit="$2";  shift 2 ;;
            *)              break ;;
        esac
    done
    [ -n "$org" ] || M='Please provide --org <org>' arg:ret:64

    local resp=
    resp="$(___x_cmd_hub_u_curl get "/api/v0/org/$org/audit" \
        "page==${page}" "limit==${limit}" ${action:+"action==${action}"})" || {
        ___x_cmd_hub_u_handle_resp false "Failed to list audit of $org"
        return 1
    }

    printf "%s" "$resp" | ___x_cmd jo
}
