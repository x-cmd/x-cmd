    esac
}

___x_cmd_hub_site_media_upload(){
    local X_help_cmd='___x_cmd_hub___help site media upload'
    help:arg:parse

    [ $# -gt 0 ] || { ___x_cmd help -m hub site media upload; return; }

    local id="$1"; shift
    [ -n "$id" ] || { ___x_cmd_ui_tf false "Site ID is required"; return 1; }

    local file="$1"
    [ -f "$file" ] || { ___x_cmd_ui_tf false "File not found: $file"; return 1; }

    local resp=
    resp="$(___x_cmd_hub_u_curl post "/api/v0/file/share/site/$(___x_cmd url encode "$id")/media" \
        -F "file=@${file}")" || {
