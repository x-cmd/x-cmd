
# x tsv kv fromjson
# x tsv kv tojson
# x tsv kv expand

___x_cmd_tsv_kv(){
    [ $# -gt 0 ]    ||  set -- --help

    local op="$1"
    case "$op" in
        -h|--help)      ___x_cmd help -m tsv kv "$@" ; return 0 ;;
        fromjson)
            ___x_cmd_tsv_kv_"$op" "$@" ;;
        *)
            N=tsv M="Unknown op -> $op" log:ret:64

    esac
}

___x_cmd_tsv_kv_fromjson(){
    ___x_cmd awk        \
        -f "$___X_CMD_ROOT_MOD/tsv/lib/awk/fromjson.awk"
}
