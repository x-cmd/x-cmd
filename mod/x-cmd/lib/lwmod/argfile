___x_cmd_work1(){
    local multi_line_tmp=""

    local key1=""
    local key2=""
    local silent=""

    local arglist

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m work1 "$@" ; return 0 ;;
            --key1)         key1="$2" ;     arg:2:shift ;;
            --key2)         key2="$2" ;     arg:2:shift ;;
            --silent)       silent=1;       shift ;;

            --)             shift; break ;;
            -*)             N=work1 M="Unknown options -> $1" log:ret:64 ;;

            *)              arg:add arglist "$1" ; shift
        esac
    done

    eval 'set -- $arglist "$@"'
}


# Best solution to support argument behind.

___x_cmd_work2(){
    local multi_line_tmp=""

    local key1=""
    local key2=""
    local silent=""

    ___x_cmd_work2___argparse_(){
        local count=0
        while [ $# -gt 0 ]; do
            count=$((count+1))
            case "$1" in
                -h|--help)      ___x_cmd help -m work2 "$@" ; return 0 ;;
                --key1)         key1="$2" ;     arg:2:shift ;;
                --key2)         key2="$2" ;     arg:2:shift ;;
                --silent)       silent=1 ;      shift ;;

                --)             shift; break ;;
                -*)             N=work1 M="Unknown options -> $1" log:ret:64 ;;

                *)              _argparse_="$_argparse_ \"\$${count}\"" ; shift
            esac
        done
    }

    local _argparse_
    ___x_cmd_work2___argparse_ "$@" || return $?
    eval set -- "$_argparse_"
    unset -f ___x_cmd_work2___argparse_
}



