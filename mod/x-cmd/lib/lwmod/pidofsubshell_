
___x_cmd_pidofsubshell_quick_(){
    if [ -n "$BASHPID" ]; then
        x_="$BASHPID"
        return
    fi

    if [ -n "$ZSH_VERSION" ]; then
        x_="${sysparams[pid]}"
        return
    fi

    x_=
}

___x_cmd_pidofsubshell(){
    local x_
    ___x_cmd_pidofsubshell_quick_
    if [ -z "$x_" ]; then   sh -c 'printf "%s\n" "$PPID"'
    else                    printf "%s\n" "$x_"
    fi
}

___x_cmd_pidofsubshell_(){
    ___x_cmd_pidofsubshell_quick_
    [ -n "$x_" ] || {
        local random="$RANDOM"
        [ -n "$random" ] || {
            x_=""; ___x_cmd rand int_
            random="$x_"
        }

        x_=""; ___x_cmd epoch get_
        local fp="$___X_CMD_ROOT_TMP/pidofsubshell.pid.$$.${random}.${x_}"
        sh -c 'printf "%s\n" "$PPID"' >"$fp"
        read -r x_ <"$fp"
        ___x_cmd rmrf "$fp"
        # x_=$(sh -c 'printf "%s\n" "$PPID"')   # This is wrong.
        [ -n "$x_" ]
    }


}
