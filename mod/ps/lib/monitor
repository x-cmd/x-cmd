# shellcheck shell=dash

___x_cmd_ps_monitor(){
    local count=5
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m ps monitor "$@" ; return 0 ;;
            -c|--count)     count="$2"; shift 2 ;;
            *)              break ;;
        esac
    done

    case "$count" in ''|*[!0-9]*) M=ps N="Invalid --count: $count" log:ret:1 ;; esac
    [ "$count" -ge 0 ] || M=ps N="Invalid --count: $count" log:ret:1

    local pid="$1"
    ___x_cmd_cmds ps -p "$pid" -o pid= >/dev/null 2>&1 \
        || M=ps N="No running process with PID $pid" log:ret:1

    if ___x_cmd os is darwin; then
        ___x_cmd_ps_monitor_darwin "$pid" "$count"
    else
        ___x_cmd_ps_monitor_linux "$pid" "$count"
    fi
}
