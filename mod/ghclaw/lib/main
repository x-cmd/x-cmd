# shellcheck shell=dash

___x_cmd log init ghclaw
xrc:mod:lib     ghclaw   util listen ls stop consume/_index

___x_cmd_ghclaw___main(){
    [ "$#" -gt 0 ] ||   set -- --help

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m ghclaw "$@";    return 0 ;;
        listen)         ___x_cmd_ghclaw___listen "$@";    return $? ;;
        consume)        ___x_cmd_ghclaw___consume "$@";   return $? ;;
        ls)             ___x_cmd_ghclaw___ls "$@";        return $? ;;
        stop)           ___x_cmd_ghclaw___stop "$@";      return $? ;;
        run)            ___x_cmd_ghclaw___run "$@";       return $? ;;

        *)              N=ghclaw M="Unknown subcmd -> $op" log:ret:64 ;;
    esac
}

# x ghclaw run [kind flags] <target> [--interval <human-time>]
#   One-shot: start the listen worker, consume in the foreground, then stop
#   the listener on exit (= listen + consume + stop).
___x_cmd_ghclaw___run(){
    case "$1" in
        -h|--help) ___x_cmd help -m ghclaw run; return ;;
    esac

    ___x_cmd_ghclaw___listen "$@" || return $?

    ___x_cmd_ghclaw___consume "$@"
    local exitcode="$?"

    ___x_cmd_ghclaw___stop "$@"
    return "$exitcode"
}
