# shellcheck shell=dash disable=SC2016

# x ghclaw ls — list active listen workers (target, pid, start time, state)
___x_cmd_ghclaw___ls(){
    local x_=""
    local out listing
    out="$(___x_cmd worker ls --ns ghclaw-default-worker --tsv 2>/dev/null)" || out=""

    listing=""
    [ -z "$out" ] || listing="$(
        while IFS="$___X_CMD_UNSEENCHAR_HT" read -r name pid fp stime state; do
            case "$name:$state" in
                listen-*:ongoing)   ;;
                *)                  continue ;;
            esac
            ___x_cmd_ghclaw___workertarget_ "$name"
            printf '%-32s %-8s %-28s %s\n' "$x_" "$pid" "$(___x_cmd date dump "$stime")" "$state"
        done <<A
$out
A
    )"

    if [ -z "$listing" ]; then
        ghclaw:info --start "x ghclaw listen --repo <owner/repo> [--interval 1min]" \
                    "[LS] no active listeners (ns=ghclaw-default-worker)"
    else
        printf '%-32s %-8s %-28s %s\n' TARGET PID STARTED STATE
        printf '%s\n' "$listing"
        ghclaw:info --stop "x ghclaw stop <target>" \
                    "[LS] showing ongoing listeners"
    fi
}
