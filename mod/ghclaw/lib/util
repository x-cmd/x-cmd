# shellcheck shell=dash disable=SC2016

# Internal helpers shared across ghclaw subcommands.

# Worker name -> original target. GitHub owner names can't contain '_', so
# the FIRST '_' in 'listen-<owner>_<repo>' is the sanitized '/'.
___x_cmd_ghclaw___workertarget_(){
    x_="${1#listen-}"
    local head="${x_%%_*}"
    [ "$head" = "$x_" ] || x_="$head/${x_#"$head"_}"
}

# Pre-check/prepare the gh CLI for later `gh api` calls: if the binary is
# missing, try `x env use gh` to provision it on the spot. Token comes from
# three sources (env -> `x gh --cur` gh config -> gh's own login state).
# Returns 0 = ready; 1 = unavailable (reason already printed; the caller
# decides whether to skip or abort).
# NOTE: a token fetched from gh config is kept as a plain shell variable and
# never exported — call gh via ___x_cmd_ghclaw___gh, which passes it as a
# one-shot env prefix, so it never leaks session-wide.
___x_cmd_ghclaw___prepare_gh_cli(){
    ___x_cmd_hascmd gh || ___x_cmd env use gh || {
        ghclaw:error "gh CLI not found; install it or run 'x env use gh'"
        return 1
    }

    [ -n "${GH_TOKEN:-${GITHUB_TOKEN:-}}" ] && return 0

    ___x_cmd gh --cur GH_TOKEN:=token 2>/dev/null
    [ -n "${GH_TOKEN:-}" ] && return 0

    gh auth token >/dev/null 2>&1 && return 0

    ghclaw:error "no GitHub token: set GH_TOKEN, or 'x gh init', or 'gh auth login'"
    return 1
}

# Single entry point for gh calls: GH_TOKEN is passed as a one-shot env
# prefix to the gh process only — never exported, so unrelated child
# processes can't inherit it.
___x_cmd_ghclaw___gh(){
    if [ -n "${GH_TOKEN:-}" ]; then
        GH_TOKEN="$GH_TOKEN" command gh "$@"
    else
        command gh "$@"
    fi
}
