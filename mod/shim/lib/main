# shellcheck shell=dash

xrc:mod:lib shim

___x_cmd_shim___main(){
    [ "$#" -gt 0 ] ||   set -- -h

    local op="$1";      shift
    case "$op" in
        gen|cat)
                        ___x_cmd_shim_"$op" "$@" ;;
        -h|--help)      x help -m shim;   return ;;

        create)       ___x_cmd_shim_create "$@" ;;
    esac
}

# x shim create $HOME/.local/bin "..."

___x_cmd_shim_create(){
    [ $# -gt 0 ]    ||      set -- --help

    case "$1" in
        -h|--help)          ___x_cmd help -m shim create "$@" ; return 0 ;;
    esac

    [ $# -gt 1 ]    ||      N=shim M="Expect bin folder and bin path" log:ret:64

    local targetfp="$1" ;   shift

    ___x_cmd mkdirp "$targetfp"

    local binarg

    local binname
    local binpath

    local IFS=" "
    for binarg in "$@" ; do
        case "$binarg" in
            *=*)    binpath="${binarg#*=}" ;    binname="${binarg%%=*}" ;;
            *)      binpath="${binarg}";        binname="${binpath#*/}" ;;
        esac
        [ -x "$binpath" ]               ||      N=shim M="Exepct to be executable -> $binpath"  log:ret:64
        [ ! -e "$targetfp/$binname" ]   ||      N=shim M="Already existed-> $targetfp/$binname" log:ret:64
    done

    local x_

    local fun=___x_cmd_shim__gen_shcode_local
    ! ___x_cmd is win || fun=___x_cmd_shim__gen_batcode_local

    for binarg in "$@" ; do
        case "$binarg" in
            *=*)    binpath="${binarg#*=}" ;    binname="${binarg%%=*}" ;;
            *)      binpath="${binarg}";        binname="${binpath#*/}" ;;
        esac

        ___x_cmd_abspath_ "$binpath"
        "$fun" -- "$x_" >"$targetfp/$binname"
    done
}
