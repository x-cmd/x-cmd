# shellcheck shell=dash

___x_cmd_gitconfig_apply(){
    local x_=""
    local ___X_CMD_WSROOT_=""
    ___x_cmd wsroot_ || return 1
    local fp="${1:-"$___X_CMD_WSROOT_/.x-cmd/git/config.yml"}"

    if [ -f "$fp" ]; then
        ___x_cmd_gitconfig___resolve_git_dir_ || return 1
        x mkdirp "$x_/.x-cmd"
        x touch "$x_/.x-cmd/.config.apply"

        local cmd
        if cmd=$(x y2j "$fp" | x ja t | ___x_cmd_cmds_awk \
            -v GITDIR="$(x wsroot)/.git/hook"   \
            -f "$___X_CMD_ROOT_MOD/awk/lib/core.awk"     \
            -f "$___X_CMD_ROOT_MOD/awk/lib/shx.awk"         \
            -f "$___X_CMD_ROOT_MOD/awk/lib/j/json.awk"      \
            -f "$___X_CMD_ROOT_MOD/awk/lib/j/jiter.awk"     \
            -f "${___X_CMD_ROOT_MOD}/gitconfig/lib/awk/apply.awk"); then

            eval "$cmd"
            # echo "$cmd"
            x:info "x gitconfig apply SUCCESS ==> $fp"
        fi
    fi

    local hookcfg="$___X_CMD_WSROOT_/.x-cmd/git/hook.yml"
    if [ -f "$hookcfg" ]; then
        x githook apply "$hookcfg"
        x:info "x githook apply SUCCESS ==> $hookcfg"
    fi
}
