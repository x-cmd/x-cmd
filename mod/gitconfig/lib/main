# shellcheck shell=dash

xrc:mod:lib gitconfig           apply

___x_cmd_gitconfig___main(){
    [ -n "$1" ] || set -- "--help"
    local op="$1";  shift
    case "$op" in
        apply|_themehintrequired)
            ___x_cmd_gitconfig_"$op" "$@" ;;
        -h|--help)
            x help -m gitconfig
            return 1 ;;
        *)
            ___x_cmd_gitconfig_apply "$op" "$@" ;;
    esac
}

# shellcheck disable=SC2120


___x_cmd_gitconfig___git_dir_(){
    [ -n "$___X_CMD_WSROOT_" ] || ___x_cmd wsroot_ || return
    local start="${1:-$___X_CMD_WSROOT_}"
    x_="$(___x_cmd_cmds git -C "$start" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
    return 0
}

# x_: ensure find .git dir
___x_cmd_gitconfig___resolve_git_dir_(){
    if ___x_cmd locatefolder_ "$x_" ".git"; then
        if [ -d "${x_}/.git" ]; then
            x_="${x_}/.git"
        else
            ___x_cmd_gitconfig___git_dir_ || return 1
        fi
    else
        ___x_cmd_gitconfig___git_dir_ || return 1
    fi
    return 0
}

___x_cmd_gitconfig__themehintrequired(){
    local x_=""

    ___x_cmd wsroot_ || return

    ___x_cmd_gitconfig___resolve_git_dir_ || return

    if [ -f "${___X_CMD_WSROOT_}/.x-cmd/git/hook.yml" ]; then
        [ -d "$___X_CMD_ROOT_GDATA/githook/hooks/${___X_CMD_GITHOOK_VERSION-"v0.0.2"}" ] || return 0
        [ -d "${x_}/.x-cmd/hooks/${___X_CMD_GITHOOK_VERSION-"v0.0.2"}" ] || return 0
    fi

    if [ -f "${___X_CMD_WSROOT_}/.x-cmd/git/config.yml" ]; then
        [ -f "${x_}/.x-cmd/.config.apply" ] || return 0
        [ "${x_}/.x-cmd/.config.apply" -ot "${___X_CMD_WSROOT_}/.x-cmd/git/config.yml" ]
        return
    fi

    return 1
}
