___x_cmd_claw_run_status___human(){
    local use_color=1
    [ -t 1 ] || use_color=0

    local c_title="" c_section="" c_key="" c_value="" c_green="" c_red="" c_yellow="" c_dim="" c_cyan="" c_end=""
    if [ "$use_color" -eq 1 ]; then
        c_title="$(___x_cmd ui style bold)$(___x_cmd ui style cyan)"
        c_section="$(___x_cmd ui style bold)$(___x_cmd ui style yellow)"
        c_key="$(___x_cmd ui style dim)"
        c_value="$(___x_cmd ui style bold)"
        c_green="$(___x_cmd ui style green)"
        c_red="$(___x_cmd ui style red)"
        c_yellow="$(___x_cmd ui style yellow)"
        c_dim="$(___x_cmd ui style dim)"
        c_cyan="$(___x_cmd ui style cyan)"
        c_end="$(___x_cmd ui style end)"
    fi

    local dash="${c_dim}—${c_end}"
    local runtime_color="$c_yellow"
    [ "$runtime_status" = "active" ] && runtime_color="$c_green"

    printf "%sx-claw status%s\n\n" "$c_title" "$c_end"

    printf "%s◆ Overview%s\n" "$c_section" "$c_end"
    printf "  %s%-14s%s %s %s\n" "$c_key" "Service:" "$c_end" "$(___x_cmd_claw_run_status___fmt_state service "$service_status")" "$(___x_cmd_claw_run_status___fmt_service_text "$service_status")"
    printf "  %s%-14s%s %s%s%s\n" "$c_key" "Runtime:" "$c_end" "$runtime_color" "$runtime_status" "$c_end"
    printf "  %s%-14s%s %s\n" "$c_key" "Agent harness:" "$c_end" "${harness:-$dash}"
    printf "  %s%-14s%s %s\n" "$c_key" "MQ pending:" "$c_end" "$mq_pending"
    printf "  %s%-14s%s %s\n" "$c_key" "Workspace:" "$c_end" "$___X_CMD_CLAW_BOT_WS"
    printf "  %s%-14s%s %s\n" "$c_key" "Log dir:" "$c_end" "$___X_CMD_CLAW_BOT_STDOUT_LOG_DIR"

    printf "\n%s◆ Heartbeat%s\n" "$c_section" "$c_end"
    printf "  %s%-14s%s %s\n" "$c_key" "Health:" "$c_end" "$(___x_cmd_claw_run_status___fmt_heartbeat_health "$last_tick_ts")"
    printf "  %s%-14s%s %s\n" "$c_key" "Worker:" "$c_end" "heartbeat-orchestrator"
    printf "  %s%-14s%s %s %s\n" "$c_key" "Worker status:" "$c_end" "$(___x_cmd_claw_run_status___fmt_state worker "$heartbeat_worker")" "$heartbeat_worker"
    printf "  %s%-14s%s %s %s\n" "$c_key" "Runner:" "$c_end" "$(___x_cmd_claw_run_status___fmt_state runner "$heartbeat_runner")" "$heartbeat_runner"
    if [ "$idle_count" -eq 1 ]; then
        printf "  %s%-14s%s %d min\n" "$c_key" "Idle for:" "$c_end" "$idle_count"
    else
        printf "  %s%-14s%s %d mins\n" "$c_key" "Idle for:" "$c_end" "$idle_count"
    fi
    local session_unit="session"
    [ "$agent_unavailable_count" -ne 1 ] && session_unit="sessions"
    if [ -n "$agent_unavailable_list" ]; then
        printf "  %s%-14s%s %d %s (%s)\n" "$c_key" "Agent cooldown:" "$c_end" "$agent_unavailable_count" "$session_unit" "$agent_unavailable_list"
    else
        printf "  %s%-14s%s %d %s\n" "$c_key" "Agent cooldown:" "$c_end" "$agent_unavailable_count" "$session_unit"
    fi
    if [ -n "$last_tick" ] && [ "$last_tick_ts" -gt 0 ] 2>/dev/null; then
        printf "  %s%-14s%s %s (%s)\n" "$c_key" "Last tick:" "$c_end" "$last_tick" "$(___x_cmd_claw_run_status___fmt_reltime "$last_tick_ts")"
    else
        printf "  %s%-14s%s %s\n" "$c_key" "Last tick:" "$c_end" "$dash"
    fi

    printf "\n%s◆ IM Connections%s\n" "$c_section" "$c_end"
    if [ -z "$im_list" ]; then
        printf "  %s(none)%s\n" "$c_dim" "$c_end"
    else
        printf "%s\n" "$im_list" | while IFS="$___X_CMD_UNSEENCHAR_HT" read -r im_name chatid chat_type service_status worker_status unread_count last_active last_active_ts app_name group_name; do
            printf "  ● %s%s%s\n" "$c_value" "$im_name" "$c_end"
            local last_active_fmt="$last_active"
            if [ -n "$last_active" ] && [ "$last_active" != "—" ]; then
                last_active_fmt="$(printf "%s" "$last_active" | cut -c1-16)"
            fi
            local last_active_rel=""
            if [ -n "$last_active_ts" ] && [ "$last_active_ts" -gt 0 ] 2>/dev/null; then
                last_active_rel="$(___x_cmd_claw_run_status___fmt_reltime "$last_active_ts")"
            fi
            printf "      %s%-11s%s %s\n" "$c_key" "Chat:" "$c_end" "${chatid:-$dash}"
            local im_name_disp="$group_name"
            [ -z "$im_name_disp" ] || [ "$im_name_disp" = "—" ] && im_name_disp="$app_name"
            [ -z "$im_name_disp" ] || [ "$im_name_disp" = "—" ] && im_name_disp="$dash"
            printf "      %s%-11s%s %s\n" "$c_key" "Name:" "$c_end" "$im_name_disp"
            printf "      %s%-11s%s %s\n" "$c_key" "Type:" "$c_end" "${chat_type:-$dash}"
            printf "      %s%-11s%s %s %s\n" "$c_key" "Service:" "$c_end" "$(___x_cmd_claw_run_status___fmt_state service "$service_status")" "$(___x_cmd_claw_run_status___fmt_service_text "$service_status")"
            printf "      %s%-11s%s %s %s\n" "$c_key" "Worker:" "$c_end" "$(___x_cmd_claw_run_status___fmt_state worker "$worker_status")" "$worker_status"
            printf "      %s%-11s%s %s\n" "$c_key" "Unread:" "$c_end" "$unread_count"
            if [ -n "$last_active_fmt" ] && [ "$last_active_fmt" != "—" ]; then
                printf "      %s%-11s%s %s (%s)\n" "$c_key" "Last active:" "$c_end" "$last_active_fmt" "$last_active_rel"
            else
                printf "      %s%-11s%s %s\n" "$c_key" "Last active:" "$c_end" "$dash"
            fi
            printf "\n"
        done
    fi

    printf "\n%s◆ Cron Jobs%s\n" "$c_section" "$c_end"
    if [ -z "$cron_list" ]; then
        printf "  %s(none)%s\n" "$c_dim" "$c_end"
    else
        local cron_total=0 cron_failed=0
        cron_total="$(printf "%s\n" "$cron_list" | ___x_cmd awk0 -v FS="$___X_CMD_UNSEENCHAR_HT" 'NR>1 && $1!="" {total++} END {print total+0}')"
        cron_failed="$(printf "%s\n" "$cron_list" | ___x_cmd awk0 -v FS="$___X_CMD_UNSEENCHAR_HT" 'NR>1 && $1!="" {if ($7=="failed") failed++} END {print failed+0}')"
        printf "  %s%-11s%s %d total" "$c_key" "Summary:" "$c_end" "$cron_total"
        if [ "$cron_failed" -gt 0 ]; then
            printf ", %s%d failed%s" "$c_red" "$cron_failed" "$c_end"
        fi
        printf "\n\n"
        printf "%s\n" "$cron_list" | ___x_cmd awk0 -m date -v FS="$___X_CMD_UNSEENCHAR_HT" \
            -v c_section="$c_section" -v c_key="$c_key" -v c_value="$c_value" \
            -v c_green="$c_green" -v c_red="$c_red" -v c_yellow="$c_yellow" \
            -v c_dim="$c_dim" -v c_end="$c_end" \
            -f "$___X_CMD_ROOT_MOD/claw/lib/awk/status_cron_human.awk"
    fi

    printf "%sTip:%s Use %sx claw status --yaml%s for machine-readable output.\n" "$c_dim" "$c_end" "$c_cyan" "$c_end"
    printf "     Run %sx claw log%s to view real-time logs.\n" "$c_cyan" "$c_end"
    if [ "$service_status" != "running" ]; then
        printf "     Run %sx claw service start%s to start the background service.\n" "$c_cyan" "$c_end"
    fi
    printf "     Run %sx claw connect <weixin|qywx|feishu|telegram>%s to add an IM channel.\n" "$c_cyan" "$c_end"
}

___x_cmd_claw_run_status(){
    local output_format=human
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --yaml)     output_format=yaml; shift ;;
            -h|--help)  ___x_cmd help -m claw status "$@"; return 0 ;;
            *)          ___x_cmd_claw_run_status___usage; return 64 ;;
        esac
    done

    local service_status="" runtime_status="" harness=""
    local heartbeat_worker="" heartbeat_runner=""
    local idle_count=0 agent_unavailable_count=0 agent_unavailable_list="" last_tick="" last_tick_ts=0
    local current_ts=0
    local mq_pending=0
    local im_list=""
    local cron_tz="" cron_list=""

    ___x_cmd_claw_run_status___collect

    case "$output_format" in
        yaml)   ___x_cmd_claw_run_status___yaml ;;
        human)  ___x_cmd_claw_run_status___human ;;
        *)      ___x_cmd_claw_run_status___usage; return 64 ;;
    esac
}
