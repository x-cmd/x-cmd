# shellcheck shell=dash


___x_cmd_claw_run___mq___dispatch_chat(){

    if [ -n "$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR" ]; then
        local logfp="$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR/chat_worker.log"
        ___x_cmd ensurefp "$logfp"
        exec >>"$logfp" 2>&1
    fi


    local msg="$1"
    local reset_failure="${2:-}"

    local chatid
    case "$msg" in
        weixin:*)
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name chat-weixin-clawbot; then
                    ___x_cmd worker run --ns x-claw-default-worker --name chat-weixin-clawbot -- ___x_cmd_claw_run___chat_worker___weixin "$reset_failure"
                fi
                ;;
        telegram:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-telegram-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-telegram-${chatid}" -- ___x_cmd_claw_run___chat_worker___telegram "${chatid}" "$reset_failure"
                fi
                ;;
        feishu:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-feishu-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-feishu-${chatid}" -- ___x_cmd_claw_run___chat_worker___feishu "${chatid}" "$reset_failure"
                fi
                ;;
        qywx:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-qywx-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-qywx-${chatid}" -- ___x_cmd_claw_run___chat_worker___qywx "${chatid}" "$reset_failure"
                fi
                ;;
    esac
}


