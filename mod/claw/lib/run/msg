# shellcheck shell=dash


___x_cmd_claw_run___mq___dispatch_chat(){

    if [ -n "$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR" ]; then
        local logfp="$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR/chat_worker.log"
        ___x_cmd ensurefp "$logfp"
        exec >>"$logfp" 2>&1
    fi


    local msg="$1"
    local reset_failure="${2:-}"

    local chatid
    case "$msg" in
        weixin:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-weixin-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-weixin-${chatid}" -- ___x_cmd_claw_run___chat_worker___weixin "${chatid}" "$reset_failure"
                fi
                ;;
        telegram:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-telegram-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-telegram-${chatid}" -- ___x_cmd_claw_run___chat_worker___telegram "${chatid}" "$reset_failure"
                fi
                ;;
        feishu:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-feishu-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-feishu-${chatid}" -- ___x_cmd_claw_run___chat_worker___feishu "${chatid}" "$reset_failure"
                fi
                ;;
        qywx:*)
                chatid="${msg#*:}"
                if ! ___x_cmd worker isalive --ns x-claw-default-worker --name "chat-qywx-${chatid}"; then
                    ___x_cmd worker run --ns x-claw-default-worker --name "chat-qywx-${chatid}" -- ___x_cmd_claw_run___chat_worker___qywx "${chatid}" "$reset_failure"
                fi
                ;;
    esac
}

___x_cmd_claw_run___chat_worker___weixin(){
    if [ -n "$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR" ]; then
        local logfp="$___X_CMD_CLAW_BOT_RECENT_STDOUT_LOG_DIR/chat_worker.log"
        ___x_cmd ensurefp "$logfp"
        exec >>"$logfp" 2>&1
    fi

    local chatid="${1:-}"
    local reset_failure="${2:-}"
    [ -n "$chatid" ] || {
        claw:error "[MSG] [weixin] No chatid provided for weixin chat worker. Exiting."
        return 1
    }

    ___x_cmd_claw_run___activate_im "weixin" "$chatid" || return $?

    # Only clear the session-reminder marker on a genuine user message
    # (reset_failure=1). Heartbeat-driven polls should not reset it, otherwise
    # the reminder could be suppressed repeatedly while the agent is in cooldown.
    if [ -n "$reset_failure" ]; then
        ___x_cmd rmrf "$___X_CMD_CLAW_WEIXIN_REMIND_MARKER/$chatid" 2>/dev/null || true
    fi

    ___x_cmd_claw_weixin_has_unread "$chatid" || return 0
    claw:info "[MSG] [weixin:$chatid] Unread messages detected, launching agent request"
    ___x_cmd_claw_run___agent___exec_chat "weixin" "$chatid" "$( ___x_cmd_claw_weixin_get_unread "$chatid" )" "" "$reset_failure"
}

