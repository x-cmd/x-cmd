# shellcheck shell=dash

___x_cmd_codex_doubao(){
    local op="${1:-}"
    case "$op" in
        -h|--help)      ___x_cmd help -m codex doubao; return 0 ;;
        --has-apikey)   ___x_cmd_codex_doubao_has_apikey; return ;;
        --)             shift ;;
    esac

    local codingapikey="" model=""
    ___x_cmd doubao --cur codingapikey:= model:= 2>/dev/null
    [ -n "$codingapikey" ] || codingapikey="${DOUBAO_API_KEY:-}"
    model="${model:-"doubao-seed-evolving"}"

    if [ -z "$codingapikey" ]; then
        codex:error "Need DOUBAO API key: set DOUBAO_API_KEY or configure 'x doubao'"
        return 1
    fi

    local bundled_catalog="${___X_CMD_ROOT_MOD}/codex/lib/other/ds.models.json"
    if [ ! -f "$bundled_catalog" ]; then
        codex:error "Missing bundled DOUBAO model catalog -> $bundled_catalog"
        return 1
    fi

    local base_url="https://ark.cn-beijing.volces.com/api/coding/v3"

    DOUBAO_API_KEY="$codingapikey" \
    ___x_cmd_codex___runcmd \
        --config "model=\"$model\"" \
        --config 'model_provider="doubao"' \
        --config 'preferred_auth_method="apikey"' \
        --config 'forced_login_method="api"' \
        --config 'model_reasoning_effort="high"' \
        --config "model_catalog_json=\"$bundled_catalog\"" \
        --config 'model_providers.doubao.name="doubao"' \
        --config "model_providers.doubao.base_url=\"$base_url\"" \
        --config 'model_providers.doubao.wire_api="responses"' \
        --config 'model_providers.doubao.env_key="DOUBAO_API_KEY"' \
        "$@"
}

___x_cmd_codex_doubao_has_apikey(){
    local codingapikey=""
    ___x_cmd doubao --cur codingapikey:= 2>/dev/null
    [ -n "$codingapikey" ] || codingapikey="${DOUBAO_API_KEY:-}"
    [ -n "$codingapikey" ]
}
