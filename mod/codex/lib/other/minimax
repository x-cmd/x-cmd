# shellcheck shell=dash

___x_cmd_codex_minimax(){
    local op="${1:-}"
    case "$op" in
        -h|--help)      ___x_cmd help -m codex minimax; return 0 ;;
        --has-apikey)   ___x_cmd_codex_minimax_has_apikey; return ;;
        --)             shift ;;
    esac

    local apikey="" model=""
    ___x_cmd minimax --cur apikey:= model:= 2>/dev/null
    [ -n "$apikey" ] || apikey="${MINIMAX_API_KEY:-}"
    model="${model:-"MiniMax-M3"}"

    # The token-plan Responses endpoint differs from the anthropic/chat endpoint
    # stored in 'x minimax', so the endpoint is not inherited from it.
    local endpoint="${MINIMAX_CODEX_ENDPOINT:-"https://api.minimax.com/v1"}"

    if [ -z "$apikey" ]; then
        codex:error "Need MiniMax API key: set MINIMAX_API_KEY or configure 'x minimax'"
        return 1
    fi

    local bundled_catalog="${___X_CMD_ROOT_MOD}/codex/lib/other/minimax.models.json"
    if [ ! -f "$bundled_catalog" ]; then
        codex:error "Missing bundled MiniMax model catalog -> $bundled_catalog"
        return 1
    fi

    local base_url="${endpoint%/}/"

    MINIMAX_API_KEY="$apikey" \
    ___x_cmd_codex___runcmd \
        --config "model=\"$model\"" \
        --config 'model_provider="minimax"' \
        --config 'preferred_auth_method="apikey"' \
        --config 'forced_login_method="api"' \
        --config "model_providers.minimax.name=\"MiniMax\"" \
        --config "model_providers.minimax.base_url=\"$base_url\"" \
        --config 'model_providers.minimax.wire_api="responses"' \
        --config 'model_providers.minimax.env_key="MINIMAX_API_KEY"' \
        --config "model_catalog_json=\"$bundled_catalog\"" \
        "$@"
}


___x_cmd_codex_minimax_has_apikey(){
    local apikey=""
    ___x_cmd minimax --cur apikey:= 2>/dev/null
    [ -n "$apikey" ] || apikey="${MINIMAX_API_KEY:-}"
    [ -n "$apikey" ]
}
