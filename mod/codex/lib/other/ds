# shellcheck shell=dash

___x_cmd_codex_ds(){
    local op="${1:-}"
    case "$op" in
        -h|--help)      ___x_cmd help -m codex ds; return 0 ;;
        --)             shift ;;
    esac

    local apikey="" model="" endpoint=""
    ___x_cmd deepseek --cur apikey:= model:= endpoint:= 2>/dev/null
    [ -n "$apikey" ] || apikey="${DEEPSEEK_API_KEY:-}"
    model="${model:-"deepseek-v4-flash"}"
    endpoint="${endpoint:-"https://api.deepseek.com/"}"

    if [ -z "$apikey" ]; then
        codex:error "Need DeepSeek API key: set DEEPSEEK_API_KEY or configure 'x deepseek'"
        return 1
    fi

    local bundled_catalog="${___X_CMD_ROOT_MOD}/codex/lib/other/ds.models.json"
    if [ ! -f "$bundled_catalog" ]; then
        codex:error "Missing bundled DeepSeek model catalog -> $bundled_catalog"
        return 1
    fi

    local base_url="${endpoint%/}/"

    DEEPSEEK_API_KEY="$apikey" \
    ___x_cmd_codex___runcmd \
        --config "model=\"$model\"" \
        --config 'model_provider="deepseek"' \
        --config 'preferred_auth_method="apikey"' \
        --config 'forced_login_method="api"' \
        --config 'model_reasoning_effort="high"' \
        --config "model_catalog_json=\"$bundled_catalog\"" \
        --config 'model_providers.deepseek.name="deepseek"' \
        --config "model_providers.deepseek.base_url=\"$base_url\"" \
        --config 'model_providers.deepseek.wire_api="responses"' \
        --config 'model_providers.deepseek.env_key="DEEPSEEK_API_KEY"' \
        "$@"
}
