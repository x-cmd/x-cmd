# shellcheck shell=dash

___x_cmd_codex_zhipu(){
    local op="${1:-}"
    case "$op" in
        -h|--help)      ___x_cmd help -m codex zhipu; return 0 ;;
        --has-apikey)   ___x_cmd_codex_zhipu_has_apikey; return ;;
        --)             shift ;;
    esac

    local apikey="" model=""
    ___x_cmd zhipu --cur apikey:= model:= 2>/dev/null
    [ -n "$apikey" ] || apikey="${ZHIPU_API_KEY:-}"
    model="${model:-"glm-5.3"}"

    local endpoint="${ZHIPU_CODEX_ENDPOINT:-"https://open.bigmodel.cn/api/v1"}"

    if [ -z "$apikey" ]; then
        codex:error "Need Zhipu AI API key: set ZHIPU_API_KEY or configure 'x zhipu'"
        return 1
    fi

    local bundled_catalog="${___X_CMD_ROOT_MOD}/codex/lib/other/zhipu.models.json"
    if [ ! -f "$bundled_catalog" ]; then
        codex:error "Missing bundled Zhipu AI model catalog -> $bundled_catalog"
        return 1
    fi

    local base_url="${endpoint%/}/"

    ZHIPU_API_KEY="$apikey" \
    ___x_cmd_codex___runcmd \
        --config "model=\"$model\"" \
        --config 'model_provider="zhipu"' \
        --config 'preferred_auth_method="apikey"' \
        --config 'forced_login_method="api"' \
        --config 'model_reasoning_effort="max"' \
        --config "model_catalog_json=\"$bundled_catalog\"" \
        --config 'model_providers.zhipu.name="Zhipu AI"' \
        --config "model_providers.zhipu.base_url=\"$base_url\"" \
        --config 'model_providers.zhipu.wire_api="responses"' \
        --config 'model_providers.zhipu.env_key="ZHIPU_API_KEY"' \
        "$@"
}


___x_cmd_codex_zhipu_has_apikey(){
    local apikey=""
    ___x_cmd zhipu --cur apikey:= 2>/dev/null
    [ -n "$apikey" ] || apikey="${ZHIPU_API_KEY:-}"
    [ -n "$apikey" ]
}
