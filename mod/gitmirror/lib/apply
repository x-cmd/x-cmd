# x gitmirror apply [yml]...
#
# Read yml mirror spec(s) and pipe them to x gitmirror run.
#
# Pipeline (run internally):
#   yml | x yml y2j | x jq -r '.gitmirror[]? | [.src]+.dst | @tsv' | x gitmirror run
#
# Yml schema:
#   gitmirror:
#     - src: x-bash/repo
#       dst:
#         - gitee.com:x-bash/repo
#         - gitlab.com:x-bash/repo

___x_cmd_gitmirror_apply(){
    local n=1
    while [ $# -gt 0 ]; do
        case "$1" in
            -n)         n="$2" ; arg:2:shift ;;
            -h|--help)  ___x_cmd help -m gitmirror apply ; return 0 ;;
            *)          break ;;
        esac
    done

    local file
    if [ "$#" -eq 0 ] || [ "$1" = "-" ]; then
        x yml y2j 2>/dev/null
    else
        for file in "$@"; do
            [ -r "$file" ] || { gitmirror:warn "apply: cannot read $file"; continue; }
            x yml y2j < "$file" 2>/dev/null
        done
    fi | x jq -r '.gitmirror[]? | [.src] + .dst | @tsv' | x gitmirror run -n "$n"
}
