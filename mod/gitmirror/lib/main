# shellcheck shell=dash

# gitmirror stores nothing of its own — every local artifact
# (bare clones, worktrees) lives under x repo's root (~/.x-repo/...).
# repo is loaded here so callers get a consistent layout with `x repo`.
xrc:mod:lib     repo
xrc:mod:lib     gitmirror   sync run apply

___x_cmd_gitmirror___main(){
    [ "$#" -gt 0 ] ||   set -- --help

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m gitmirror "$@";    return 0 ;;

        sync)           ___x_cmd_gitmirror_sync          "$@" ;;
        run)            ___x_cmd_gitmirror_run           "$@" ;;
        apply)          ___x_cmd_gitmirror_apply         "$@" ;;

        *)              N=gitmirror M="Unknown subcmd -> $op" log:ret:64 ;;
    esac
}
