# shellcheck shell=dash


___x_cmd log init ai
xrc:mod:lib     ai               \
                _index           \
                request          \
                review           \
                commit           \
                translate        \
                triage           \
                spec             \
                reply            \
                changelog

___x_cmd_ai___main(){
    [ "$#" -gt 0 ] ||   set -- --help

    local op="$1"; shift
    case "$op" in
        -h|--help)              ___x_cmd help -m ai "$@" ;    return 0 ;;

        request)                ___x_cmd_ai_request         "$@" ;;
        review)                 ___x_cmd_ai_review          "$@" ;;
        commit)                 ___x_cmd_ai_commit          "$@" ;;
        translate)              ___x_cmd_ai_translate       "$@" ;;
        triage)                 ___x_cmd_ai_triage          "$@" ;;
        spec)                   ___x_cmd_ai_spec            "$@" ;;
        reply)                  ___x_cmd_ai_reply           "$@" ;;
        changelog)              ___x_cmd_ai_changelog       "$@" ;;

        *)                      N=ai M="Unknown subcmd -> $op" log:ret:64 ;;
    esac
}