# shellcheck shell=dash disable=SC2034

# x ai spec [--yml] <topic>
#
# Generate a structured specification for `<topic>`: goal, scope,
# non-goals, design, milestones, open questions. Local mirror of
# x-cmd-action/ai/spec.

___x_cmd_ai_spec(){
    [ "$#" -gt 0 ] || { ___x_cmd help -m ai spec ; return; }

    local format= topic=

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)              ___x_cmd help -m ai spec ; return ;;
            --yml|--yaml)        format="yml" ; shift ;;
            --json|-j)           format="json" ; shift ;;
            --)                  shift; topic="$*"; break ;;
            -*)                  N=ai M="Unknown flag -> $1" log:ret:64 ;;
            *)                   topic="$topic $1"; shift ;;
        esac
    done

    topic="$(printf '%s' "$topic" | ___x_cmd_cmds awk '{$1=$1};1')"
    [ -n "$topic" ] || N=ai M="Please provide a topic: x ai spec <topic>" log:ret:64

    local prompt="Write a structured specification. Output EXACTLY:

## Goal
<one sentence>

## Non-Goals
<bullet list>

## Design
<2-4 short paragraphs>

## Milestones
<numbered bullet list>

## Open Questions
<bullet list>

Topic: ${topic}
Be concrete. Prefer small, testable milestones."

    ai:debug --m:prompt "$prompt"
    local response
    response="$( ___x_cmd ask --quick "$prompt" )" || return $?

    case "${format:-md}" in
        yml)  printf '%s' "$response" | ___x_cmd_ai___format_yml ;;
        json) printf '%s' "$response" | ___x_cmd_ai___format_json ;;
        *)    printf '%s\n' "$response" ;;
    esac
}