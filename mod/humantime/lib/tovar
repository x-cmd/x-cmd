___x_cmd_humantime_tovar__(){
    local human="${1}"
    local num

    x_year=0
    x_month=0
    x_day=0
    x_hour=0
    x_minute=0
    x_second=0

    while [ -n "$human" ]; do
        num="${human%%[A-Za-z]*}"
        human="${human#"$num"}"
        case "$human" in
            mo*)    x_month=$((  x_month  + ${num:-0} ))
                    human="${human#mo}"
                    ;;
            y*)     x_year=$((   x_year   + ${num:-0} ))
                    human="${human#?}"
                    ;;
            w*)     x_day=$((    x_day    + ${num:-0} * 7 ))
                    human="${human#?}"
                    ;;
            d*)     x_day=$((    x_day    + ${num:-0} ))
                    human="${human#?}"
                    ;;
            h*)     x_hour=$((   x_hour   + ${num:-0} ))
                    human="${human#?}"
                    ;;
            m*)     x_minute=$(( x_minute + ${num:-0} ))
                    human="${human#?}"
                    ;;
            s*)     x_second=$(( x_second + ${num:-0} ))
                    human="${human#?}"
                    ;;
            *)      human="${human#?}"
                    ;;
        esac
    done
}