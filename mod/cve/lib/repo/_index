

___X_CMD_CVE_REPO_FP="$___X_CMD_ROOT_DATA/cve/repo/cvelistV5"

___x_cmd_cve_repo(){
    [ $# -gt 0 ]    ||  set -- --help
    local op="$1";      shift
    case "$op" in
        update|cd|info|all)
            ___x_cmd_cve_repo_"$op" "$@" ;;
    esac
}

___x_cmd_cve_repo_update(){
    local url="https://github.com/CVEProject/cvelistV5"
    local fp="$___X_CMD_CVE_REPO_FP"
    ___x_cmd git update "$url" "$fp"
}

___x_cmd_cve_repo_cd(){
    ___x_cmd_cve_repo_update || return $?
    ___x_cmd_innercd "$___X_CMD_CVE_REPO_FP"
}

___x_cmd_cve_repo_info(){
    local id="$1"
    local fp
    (
        ___x_cmd_cve_repo_cd
        fp="$(find cves --type f -name "$id".json)" || return $?
        ___x_cmd_cmds cat "$fp"
    )
}

___x_cmd_cve_repo_all(){
    local id="$1"
    local fp
    (
        ___x_cmd_cve_repo_cd
        find cves --type f -name "*.json"
    )
}


