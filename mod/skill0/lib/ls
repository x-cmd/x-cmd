
___x_cmd_skill0_ls(){
    [ $# -gt 0 ]    ||      set -- --help

    local fmt=auto

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m skill0 ls "$@" ; return 0 ;;
            --tsv|--csv|--auto)
                            fmt="${1#--}"; shift ;;
            *)              N=skill0 M="Unknown option -> $1" log:ret:64 ;;
        esac
    done

    ___x_cmd_skill0_ls___"$fmt"
}

___x_cmd_skill0_ls___auto(){
    if [ -t 1 ]; then
        ___x_cmd_skill0_ls___tsv | ___x_cmd column --tsv
    else
        ___x_cmd_skill0_ls___tsv
    fi
}

___x_cmd_skill0_ls___tsv(){
    ___x_cmd rat "$___X_CMD_ROOT_SKILL0/index.tsv"
}

___x_cmd_skill0_ls___csv(){
    ___x_cmd tsv tocsv <"$___X_CMD_ROOT_SKILL0/index.tsv"
}
