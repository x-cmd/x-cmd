# shellcheck shell=dash
# https://api-docs.minimaxi.com/

___x_cmd_minimax_chat(){
    local X_help_cmd='___x_cmd help -m minimax chat'; help:arg-null:parse
    local op="$1";
    case "$op" in
        request|exec)
            shift; ___x_cmd_minimax_chat_"$op" "$@" ;;
        *)  N=minimax M="Not support such [subcmd=$op]" log:ret:64
    esac
}

___x_cmd_minimax_chat_request(){
    local X_help_cmd='___x_cmd help -m minimax chat request'; help:arg:parse
    ___x_cmd chat --exec --provider minimax "$@"
}

___x_cmd_minimax_chat_exec(){
    local endpoint=""
    ___x_cmd_minimax_cur endpoint:=endpoint 2>/dev/null
    endpoint="${endpoint:-"$___X_CMD_MINIMAX_DEFAULT_ENDPOINT"}"

    ___X_CMD_OPENAI_CHAT_ACTUAL_URL_NOT_V1=1 \
    ___X_CMD_OPENAI_CHAT_ACTUAL_PROVIDER='minimax'   \
    ___X_CMD_OPENAI_CHAT_ACTUAL_PROVIDER_NAME='MiniMax'  \
    ___X_CMD_OPENAI_CHAT_ACTUAL_ENDPOINT="$endpoint"    \
    ___x_cmd openai chat exec "$@"
}
