# shellcheck shell=dash

___x_cmd log init ajv

___x_cmd_ajv___main(){
    [ "$#" -gt 0 ] ||   set -- --help

    local op="$1";      shift
    case "$op" in
        -h|--help)      ___x_cmd help -m ajv "$@";    return 0 ;;
        validate|compile|migrate|test)
                        ___x_cmd_ajv_"$op" "$@" ;;
        *)              ___x_cmd_ajv_validate "$op" "$@" ;;
    esac
}

___x_cmd_ajv___run(){
    ___x_cmd deno run --node-modules-dir=none \
        --allow-read --allow-env=AJV_SHOW_ALL \
        "$___X_CMD_ROOT_MOD/ajv/lib/ajv.ts" "$@"
}

___x_cmd_ajv___run_write(){
    local out="$1"; shift
    ___x_cmd deno run --node-modules-dir=none \
        --allow-read --allow-env=AJV_SHOW_ALL --allow-write="$out" \
        "$___X_CMD_ROOT_MOD/ajv/lib/ajv.ts" "$@"
}

___x_cmd_ajv_validate(){
    local schema="" data=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s)  schema="$2"; arg:2:shift ;;
            -d)  data="$2";   arg:2:shift ;;
            --all) export AJV_SHOW_ALL=1; shift ;;
            -h|--help) ___x_cmd help -m ajv validate "$@" ; return 0 ;;
            -*)  N=ajv M="parameter $1 is unknown" log:ret:64 ;;
            *)   break ;;
        esac
    done
    [ -n "$schema" ] || { N=ajv M="parameter -s is required" log:ret:64; }
    ___x_cmd_ajv___run validate "$schema" "$data" "$@"
}

___x_cmd_ajv_compile(){
    local schema=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s)  schema="$2"; arg:2:shift ;;
            --all) export AJV_SHOW_ALL=1; shift ;;
            -h|--help) ___x_cmd help -m ajv compile "$@" ; return 0 ;;
            -*)  N=ajv M="parameter $1 is unknown" log:ret:64 ;;
            *)   break ;;
        esac
    done
    ___x_cmd_ajv___run compile "$schema" "$@"
}

___x_cmd_ajv_migrate(){
    local schema="" output=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s)  schema="$2"; arg:2:shift ;;
            -o)  output="$2"; arg:2:shift ;;
            --all) export AJV_SHOW_ALL=1; shift ;;
            -h|--help) ___x_cmd help -m ajv migrate "$@" ; return 0 ;;
            -*)  N=ajv M="parameter $1 is unknown" log:ret:64 ;;
            *)   break ;;
        esac
    done
    [ -n "$schema" ] || { N=ajv M="parameter -s is required" log:ret:64; }
    [ -n "$output" ] || { N=ajv M="parameter -o is required" log:ret:64; }
    ___x_cmd_ajv___run_write "$output" migrate "$schema" "$output"
}

___x_cmd_ajv_test(){
    local schema="" data="" expect=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s)  schema="$2"; arg:2:shift ;;
            -d)  data="$2";   arg:2:shift ;;
            --valid)    expect=valid;   shift ;;
            --invalid)  expect=invalid; shift ;;
            --all) export AJV_SHOW_ALL=1; shift ;;
            -h|--help) ___x_cmd help -m ajv test "$@" ; return 0 ;;
            -*)  N=ajv M="parameter $1 is unknown" log:ret:64 ;;
            *)   break ;;
        esac
    done
    [ -n "$schema" ] || { N=ajv M="parameter -s is required" log:ret:64; }
    [ -n "$data" ]   || { N=ajv M="parameter -d is required" log:ret:64; }
    [ -n "$expect" ] || { N=ajv M="parameter --[in]valid is required" log:ret:64; }
    ___x_cmd_ajv___run test "$schema" "$data" "--$expect"
}

