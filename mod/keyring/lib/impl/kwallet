# shellcheck shell=dash

# Linux KWallet backend via kwalletcli5. Selected when `backend=kwallet`
# is set; secret_service is the default Linux backend.

___x_cmd_keyring___kwallet_get(){
    kwalletcli5 -f Passwords -e "$1" -p "x-cmd-keyring" get "$2" 2>/dev/null
}

___x_cmd_keyring___kwallet_set(){
    kwalletcli5 -f Passwords -e "$1" -p "x-cmd-keyring" set -- "$2" "$3" 2>/dev/null
}

___x_cmd_keyring___kwallet_ls(){
    kwalletcli5 -l -f Passwords -e "${1:-x-cmd-keyring}" 2>/dev/null
}

___x_cmd_keyring___kwallet_rm(){
    kwalletcli5 -f Passwords -e "$1" -p "x-cmd-keyring" del -- "$2" 2>/dev/null
}
