# shellcheck shell=dash

___X_CMD_KEYRING_BACKEND="${___X_CMD_KEYRING_BACKEND:-}"

___x_cmd_keyring___backend_marker_path_(){
    printf '%s\n' "${___X_CMD_ROOT_DATA:-$HOME/.x-cmd.root/data}/keyring/backend"
}

___x_cmd_keyring___backend_canonicalize_(){
    case "$1" in
        keychain|Keychain|macOS|mac_keychain|keychain_mac)
                                                    printf '%s\n' keychain ;;
        secret_service|SecretService|libsecret|secret-service)
                                                    printf '%s\n' secret_service ;;
        kwallet|KWallet|KWallet5|KWallet6)         printf '%s\n' kwallet ;;
        windows|credential_locker|credman|wincred) printf '%s\n' windows ;;
        null|disabled)                             printf '%s\n' null ;;
        *) return 1 ;;
    esac
}

___x_cmd_keyring___active_backend_(){
    if [ -n "${___X_CMD_KEYRING_BACKEND:-}" ]; then
        printf '%s\n' "$___X_CMD_KEYRING_BACKEND"
        return 0
    fi

    local marker
    marker="$(___x_cmd_keyring___backend_marker_path_)"
    if [ -r "$marker" ]; then
        IFS= read -r pin <"$marker"
        if [ -n "$pin" ]; then
            printf '%s\n' "$pin"
            return 0
        fi
    fi

    local x_="";  ___x_cmd os name_
    case "$x_" in
        darwin)            printf '%s\n' keychain ;;
        linux)             printf '%s\n' secret_service ;;
        win)               printf '%s\n' windows ;;
        *)                 N=keyring M="keyring backend not supported on this OS: $x_" log:ret:64 ;;
    esac
}

___x_cmd_keyring_backend(){
    [ "$#" -gt 0 ] || set -- ls

    local op="$1";      shift
    case "$op" in
        ls|list)        ___x_cmd_keyring_backend_ls       "$@" ;;
        get)            ___x_cmd_keyring_backend_get      "$@" ;;
        set)            ___x_cmd_keyring_backend_set      "$@" ;;
        *)              N=keyring M="Unknown backend subcmd -> $op" log:ret:64 ;;
    esac
}

___x_cmd_keyring_backend_get(){
    ___x_cmd_keyring___active_backend_
}

___x_cmd_keyring_backend_set(){
    [ "$#" -gt 0 ] || N=keyring M="keyring backend set: <name> required" log:ret:64
    local pin
    pin="$(___x_cmd_keyring___backend_canonicalize_ "$1")" || {
        N=keyring M="Unknown backend: $1 (expected: keychain|secret_service|kwallet|null)" log:ret:64
    }
    local marker
    marker="$(___x_cmd_keyring___backend_marker_path_)"
    ___x_cmd mkdirp "$(dirname "$marker")"
    printf '%s\n' "$pin" >"$marker"
    printf '%s\n' "$pin"
}

___x_cmd_keyring_backend_ls(){
    printf '%s\n' keychain secret_service kwallet windows null
}

___x_cmd_keyring___backend_get_(){
    case "$1" in
        keychain)        ___x_cmd_keyring___keychain_get        "$2" "$3" ;;
        secret_service)  ___x_cmd_keyring___secret_service_get  "$2" "$3" ;;
        kwallet)         ___x_cmd_keyring___kwallet_get         "$2" "$3" ;;
        windows)         ___x_cmd_keyring___windows_get         "$2" "$3" ;;
        null)            ___x_cmd_keyring___null_get ;;
        *)               return 1 ;;
    esac
}

___x_cmd_keyring___backend_set_(){
    case "$1" in
        keychain)        ___x_cmd_keyring___keychain_set        "$2" "$3" "$4" ;;
        secret_service)  ___x_cmd_keyring___secret_service_set  "$2" "$3" "$4" ;;
        kwallet)         ___x_cmd_keyring___kwallet_set         "$2" "$3" "$4" ;;
        windows)         ___x_cmd_keyring___windows_set         "$2" "$3" "$4" ;;
        null)            ___x_cmd_keyring___null_set ;;
        *)               return 1 ;;
    esac
}

___x_cmd_keyring___backend_ls_(){
    case "$1" in
        keychain)        ___x_cmd_keyring___keychain_ls        "$2" "$3" ;;
        secret_service)  ___x_cmd_keyring___secret_service_ls  "$2" "$3" ;;
        kwallet)         ___x_cmd_keyring___kwallet_ls         "$2" ;;
        windows)         ___x_cmd_keyring___windows_ls         "$2" "$3" ;;
        null)            ___x_cmd_keyring___null_ls ;;
        *)               return 1 ;;
    esac
}

___x_cmd_keyring___backend_rm_(){
    case "$1" in
        keychain)        ___x_cmd_keyring___keychain_rm        "$2" "$3" ;;
        secret_service)  ___x_cmd_keyring___secret_service_rm  "$2" "$3" ;;
        kwallet)         ___x_cmd_keyring___kwallet_rm         "$2" "$3" ;;
        windows)         ___x_cmd_keyring___windows_rm         "$2" "$3" ;;
        null)            return 1 ;;
        *)               return 1 ;;
    esac
}
