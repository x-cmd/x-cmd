# shellcheck shell=dash

xrc ui
xrc fsiter

___x_cmd log init eget

xrc:mod:lib     eget            \
    api         cache   detect  \
    extract     verify          \
    manifest    snap    which   \
    ls/_index   ls/ls_install   \
    resolve use upgrade download

___X_CMD_EGET_TMP="$___X_CMD_ROOT_TMP/eget"
___X_CMD_EGET_DATA="$___X_CMD_ROOT_DATA/eget"
___x_cmd mkdirp "${___X_CMD_EGET_DATA}" "${___X_CMD_EGET_TMP}"

___x_cmd_eget___main(){
    [ "$#" -gt 0 ] || set -- --help

    local op="$1"; shift
    case "$op" in
        -h|--help)          ___x_cmd help -m eget; return 0 ;;
        --version|-v)       ___x_cmd_eget___version; return 0 ;;
        snap)               ___x_cmd_eget_snap "$@"; return ;;
        ls|list)            ___x_cmd_eget_ls "$@"; return ;;
        asset)              ___x_cmd_eget_subcmd_asset "$@"; return ;;
        assetfit)           ___x_cmd_eget_subcmd_assetfit "$@"; return ;;
        classify)           ___x_cmd_eget_subcmd_classify "$@"; return ;;
        fit)                ___x_cmd_eget_subcmd_fit "$@"; return ;;
        parse)               ___x_cmd_eget_subcmd_parse "$@"; return ;;
        resolve)            ___x_cmd_eget_resolve "$@"; return ;;
        detect-scoring2)   ___x_cmd_eget_subcmd_detect_scoring2 "$@"; return ;;
        detect-test)        ___x_cmd_eget_subcmd_detect_test "$@"; return ;;
        detect-orig)        ___x_cmd_eget_subcmd_detect_orig "$@"; return ;;
        which)              ___x_cmd_eget_which "$@"; return ;;
        use)                ___x_cmd_eget_use "$@"; return ;;
        unuse)              ___x_cmd_eget_unuse "$@"; return ;;
        usels)              ___x_cmd_eget_usels "$@"; return ;;
        upgrade|update)     ___x_cmd_eget_upgrade "$@"; return ;;
        cache)              ___x_cmd_eget_cache "$@"; return ;;
        extract)            ___x_cmd_eget_subcmd_extract "$@"; return ;;
        verify)             ___x_cmd_eget_subcmd_verify "$@"; return ;;
        rate)               ___x_cmd_eget_api_rate "$@"; return ;;
        html)               ___x_cmd_eget_subcmd_html "$@"; return ;;
        remove)             ___x_cmd_eget___remove "$@"; return ;;
        download|run|get)   ___x_cmd_eget_download "$@"; return ;;
        *)                  ___x_cmd_eget_download "$op" "$@" ;;
    esac
}

___x_cmd_eget___version(){
    printf "x eget (x-cmd pure shell implementation)\nInspired by zyedidia/eget\n"
}

___x_cmd_eget_subcmd_detect_test(){
    # Run detect using scoring algorithm, print result
    local _target="" _system="" _tag=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system) shift; _system="$1" ;;
            -t|--tag)    shift; _tag="$1" ;;
            *)           _target="$1" ;;
        esac
        shift
    done
    [ -z "$_target" ] && { N=eget M="Usage: x eget detect-test <owner/repo> [-s system] [-t tag]" log:ret:64; return; }

    [ -z "$_system" ] && {
        local x_=""
        ___x_cmd os name_;  local osname="$x_"
        ___x_cmd os arch_;  local osarch="$x_"
        _system="${osname}/${osarch}"
    }

    ___X_CMD_EGET_VERBOSE="1" ___X_CMD_EGET_DETECT_MODE="scoring"
    ___x_cmd_eget_resolve_ "$_target" "github" "$_tag" "$_system" "" "0" "0" || {
        N=eget M="No asset found" log:ret:1; return;
    }
    local _pick="$x_"
    local asset_name="${_pick%%
*}"
    printf "\n[scoring] Selected: %s\n" "$asset_name"
}

# detect-scoring2 — run detect using BISCORING (bidirectional
# cross-platform scoring) algorithm. Same shape as detect-test
# but uses the scoring2 algo that excludes fallbacks the
# current platform wasn't designed for.
___x_cmd_eget_subcmd_detect_scoring2(){
    # Run detect using scoring2 algorithm, print result
    local _target="" _system="" _tag=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system) shift; _system="$1" ;;
            -t|--tag)    shift; _tag="$1" ;;
            *)           _target="$1" ;;
        esac
        shift
    done
    [ -z "$_target" ] && { N=eget M="Usage: x eget detect-scoring2 <owner/repo> [-s system] [-t tag]" log:ret:64; return; }
    [ -z "$_system" ] && {
        ___x_cmd os name_;  local osname="$x_"
        ___x_cmd os arch_;  local osarch="$x_"
        _system="${osname}/${osarch}"
    }

    ___X_CMD_EGET_VERBOSE="1" ___X_CMD_EGET_DETECT_MODE="scoring2"
    ___x_cmd_eget_resolve_ "$_target" "github" "$_tag" "$_system" "" "0" "0" || {
        N=eget M="No asset found" log:ret:1; return;
    }
    local _pick="$x_"
    local asset_name="${_pick%%
*}"
    printf "\n[scoring2] Selected: %s\n" "$asset_name"
}

___x_cmd_eget_subcmd_detect_orig(){
    # Run detect using original tier algorithm, print result
    local _target="" _system="" _tag=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -s|--system) shift; _system="$1" ;;
            -t|--tag)    shift; _tag="$1" ;;
            *)           _target="$1" ;;
        esac
        shift
    done
    [ -z "$_target" ] && { N=eget M="Usage: x eget detect-orig <owner/repo> [-s system] [-t tag]" log:ret:64; return; }

    [ -z "$_system" ] && {
        local x_=""
        ___x_cmd os name_;  local osname="$x_"
        ___x_cmd os arch_;  local osarch="$x_"
        _system="${osname}/${osarch}"
    }

    ___X_CMD_EGET_VERBOSE="1" ___X_CMD_EGET_DETECT_MODE="original"
    ___x_cmd_eget_resolve_ "$_target" "github" "$_tag" "$_system" "" "0" "0" || {
        N=eget M="No asset found" log:ret:1; return;
    }
    local _pick="$x_"
    local asset_name="${_pick%%
*}"
    printf "\n[original] Selected: %s\n" "$asset_name"
}

___x_cmd_eget___remove(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget remove; return 0 ;; esac
    local target_dir="${EGET_BIN:-.}"
    local file="$1"
    [ -n "$file" ] || { N=eget M="Missing file name for remove" log:ret:64; return; }
    local path="$target_dir/$file"
    [ -f "$path" ] || { N=eget M="File not found: $path" log:ret:1; return; }
    ___x_cmd rmrf "$path"
    eget:info "Removed $path"
}

# --- Subcommands ---

# html — scrape the GitHub releases page for release info. The diagnostic
# counterpart of the API path: when api.github.com is rate-limited or
# otherwise unreachable, the release page and its expanded_assets view are
# much more leniently throttled. Exposed as a subcmd so the parser is
# directly testable (and so the user can see what the HTML fallback sees).
# Mirrors the grep approach in edwinjhlee's comment on issue #33.
___x_cmd_eget_subcmd_html(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget html; return 0 ;; esac

    local target="" _tag=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -t|--tag) shift; _tag="$1" ;;
            -*)       N=eget M="html: unknown option: $1" log:ret:64; return ;;
            *)        [ -z "$target" ] && target="$1" || { N=eget M="html: unexpected argument: $1" log:ret:64; return; } ;;
        esac
        shift
    done

    [ -n "$target" ] || { N=eget M="html: missing target (user/repo)" log:ret:64; return; }
    case "$target" in
        */*) ;;
        *)    N=eget M="html: invalid target format: $target (expected user/repo)" log:ret:64; return ;;
    esac

    local owner="${target%%/*}" repo="${target#*/}"
    local json
    json="$( ___x_cmd_eget_api_release_html "github" "$owner" "$repo" "$_tag" )" || {
        N=eget M="html: failed to fetch release info for $target" log:ret:1; return
    }
    printf "%s" "$json" | ___x_cmd jq .
}

# asset — print a repo's release assets as unified JSON. Backs onto
# ___x_cmd_eget_api_release_unified_, so the output shape is identical
# whether the data came from the JSON API or the GitHub HTML fallback.
# Use it for piping into jq / x-cmd tooling, or as a debug view of what
# the download flow would see.
# Mirrors `x eget html` in CLI shape (--tag, target) but goes through the
# unified entry point instead of the HTML scraper directly.
#
# Output formats (default = json):
#   --json  the raw GitHub release object (default for backward compat)
#   --tsv   a flat name\turl\tsize\tdigest table (pipe-friendly, matches
#           the input shape ___x_cmd_eget_detect_* consume)
#   --yml   wrapped under eget/release (sibling of fit's
#           eget/platform/<6 platforms>, since asset returns ONE
#           release object instead of 6 per-platform entries)
#   --tty   pipe tsv through `x column --tsv` for an aligned table
#   --auto  tty → --tty, non-tty → --json
#
# --no-fallback: skip the HTML page fallback when the JSON API
# fails. Useful for tools that need the API's exact shape (digest,
# size, prerelease flag) — the HTML scrape loses all three.
___x_cmd_eget_subcmd_asset(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget asset; return 0 ;; esac

    local target="" _tag="" _pre_release="0" _forge="github" _no_fallback="0"
    local fmt=auto

    while [ $# -gt 0 ]; do
        case "$1" in
            -t|--tag)         shift; _tag="$1" ;;
            --pre-release)    _pre_release="1" ;;
            --no-fallback)    _no_fallback="1" ;;
            --json|--tsv|--yml|--tty|--auto)
                              fmt="${1#--}" ;;
            -*)               N=eget M="asset: unknown option: $1" log:ret:64; return ;;
            *)                [ -z "$target" ] && target="$1" || { N=eget M="asset: unexpected argument: $1" log:ret:64; return; } ;;
        esac
        shift
    done

    [ -n "$target" ] || { N=eget M="asset: missing target (user/repo)" log:ret:64; return; }
    case "$target" in
        */*) ;;
        *)    N=eget M="asset: invalid target format: $target (expected user/repo)" log:ret:64; return ;;
    esac

    local owner="${target%%/*}" repo="${target#*/}"
    local json
    if _no_fallback=1; then
        # Bypass ___x_cmd_eget_api_release_unified_'s HTML page fallback.
        # Direct API call only — useful when the caller needs fields the
        # HTML scrape doesn't expose (digest, size, prerelease flag).
        if ! json="$( ___x_cmd_eget_api_release "$_forge" "$owner" "$repo" "$_tag" "$_pre_release" "0" 2>/dev/null )"; then
            N=eget M="asset: failed to fetch release info for $target (check repo / tag, network, or run 'x eget rate')" log:ret:1
            return
        fi
    else
        if ! json="$( ___x_cmd_eget_api_release_unified_ "$_forge" "$owner" "$repo" "$_tag" "$_pre_release" "0" )"; then
            N=eget M="asset: failed to fetch release info for $target (check repo / tag, network, or run 'x eget rate')" log:ret:1
            return
        fi
    fi

    ___x_cmd_eget_subcmd_asset___"$fmt" "$json"
}

# Default: pretty-printed JSON. Backward-compatible with the
# original asset behavior (which piped through `x jq .`).
___x_cmd_eget_subcmd_asset___json(){
    printf "%s" "$1" | ___x_cmd jq .
}

# Flat asset table for piping. Same column order as
# detect_*'s expected input (name\turl\tsize\tdigest).
___x_cmd_eget_subcmd_asset___tsv(){
    printf "name\turl\tsize\tdigest\n"
    printf "%s" "$1" | ___x_cmd jq -r '.assets[] | [.name, .browser_download_url, (.size // 0 | tostring), (.digest // "")] | @tsv'
}

# Wrap the full release object under eget/release. The shape
# parallels assetmap's eget/platform/<6 platforms>: lsassetmap
# has 6 platform keys (a mapping of best-candidate per platform),
# asset has a single `release` key holding the whole GitHub
# release JSON. Both share the eget envelope so stat consumers
# see a uniform "eget:" top-level across the two subcommands. The
# collectedAt timestamp is captured once on the shell side via
# x date dump_ → $x_.
___x_cmd_eget_subcmd_asset___yml(){
    # Compose the full envelope as a JSON object first (yq handles
    # arbitrary nesting cleanly when the source is JSON), then let
    # yq do the JSON→YAML conversion in one pass. This avoids
    # fragile post-hoc indentation patching — yq computes the
    # indent for each level from the input depth.
    local x_
    x date dump_
    local _collected_at="$x_"

    # Wrap the release object under eget/release. The shell-quoting
    # here is intentional: we need the JSON literal to contain the
    # unparsed $1 as a sub-object, not the shell to interpolate it.
    # printf with %s keeps $1 byte-exact.
    local _envelope
    _envelope="$( printf '{"release-report":{"collectedAt":"%s","release":%s}}' \
        "$_collected_at" "$1" )"

    printf '%s' "$_envelope" | yq -P -I 0 .
}

___x_cmd_eget_subcmd_asset___auto(){
    if [ -t 1 ]; then
        ___x_cmd_eget_subcmd_asset___tty "$1"
    else
        ___x_cmd_eget_subcmd_asset___json "$1"
    fi
}

___x_cmd_eget_subcmd_asset___tty(){
    ___x_cmd_eget_subcmd_asset___tsv "$1" | ___x_cmd column --tsv
}

# fit — print the per-platform best-candidate map as TSV
# for the latest release. Same shape as `asset` but each line
# is one platform (darwin/arm64, darwin/amd64, linux/arm64,
# linux/amd64, win/arm64, win/amd64) instead of every asset.
# Empty platform (no candidate clears THRESHOLD) emits a row
# with only the platform column populated, so 6 rows always.
# Independent diagnostic — does NOT affect how `download`,
# `use`, `snap`, `resolve`, etc. pick assets for the local
# system.
___x_cmd_eget_subcmd_fit(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget fit; return 0 ;; esac

    local target="" _tag="" _pre_release="0" _forge="github"

    local fmt=auto

    while [ $# -gt 0 ]; do
        case "$1" in
            -t|--tag)         shift; _tag="$1" ;;
            --pre-release)    _pre_release="1" ;;
            --json|--tsv|--yml|--tty|--auto)
                              fmt="${1#--}"  ;;

            -*)               N=eget M="fit: unknown option: $1" log:ret:64; return ;;
            *)                [ -z "$target" ] && target="$1" || { N=eget M="fit: unexpected argument: $1" log:ret:64; return; } ;;
        esac
        shift
    done

    [ -n "$target" ] || { N=eget M="fit: missing target (user/repo)" log:ret:64; return; }
    case "$target" in
        */*) ;;
        *)    N=eget M="fit: invalid target format: $target (expected user/repo)" log:ret:64; return ;;
    esac

    local owner="${target%%/*}" repo="${target#*/}"

    ___x_cmd_eget_subcmd_fit___"$fmt"
}

___x_cmd_eget_subcmd_fit___yml(){
    # Round-trip via JSON so pair sig/hash URLs (looked up from
    # the release JSON in fit___json) survive the yml conversion.
    # The shell-side `x date dump_` capture gives us a single
    # consistent collectedAt stamp for batch runs.
    local x_
    x date dump_
    local _collected_at="$x_"

    local _json
    _json="$( ___x_cmd_eget_subcmd_fit___json )"

    local _envelope
    _envelope="$( printf '{"release-report":{"collectedAt":"%s","native":%s,"package":%s,"runtime":%s}}' \
        "$_collected_at" \
        "$(printf '%s' "$_json" | ___x_cmd jq '.native')" \
        "$(printf '%s' "$_json" | ___x_cmd jq '.package')" \
        "$(printf '%s' "$_json" | ___x_cmd jq '.runtime')" )"
    printf '%s' "$_envelope" | yq -P -I 0 .
}

___x_cmd_eget_subcmd_fit___json(){
    # Same reshape as yml but JSON. size/score are emitted as numbers
    # when set. Reshape lives in lib/jq/lsassetmap_tojson.jq.
    # Pair signature/hash URLs are attached from the release JSON
    # (we re-query it here so callers see sig/sha256 fields on each
    # selected asset without needing a second `x eget asset` call).
    local _release_json
    _release_json="$( ___x_cmd_eget_api_release_unified_ "$_forge" "$owner" "$repo" "$_tag" "$_pre_release" "0" 2>/dev/null )" || _release_json="{}"

    ___x_cmd_eget_subcmd_fit___tsv | ___x_cmd jq -Rrs \
        --argjson release "$_release_json" \
        -f "$___X_CMD_ROOT_MOD/eget/lib/jq/lsassetmap_tojson.jq"
}

___x_cmd_eget_subcmd_fit___auto(){
    if [ -t 1 ]; then
        ___x_cmd_eget_subcmd_fit___tty
    else
        ___x_cmd_eget_subcmd_fit___tsv
    fi
}

___x_cmd_eget_subcmd_fit___tty(){
    # x column is itself TTY-aware (header gets inverse-video on tty,
    # no escape codes on pipe), so --tsv is enough — no separate
    # flag to flip color on/off. Pipe forces tsv mode (vs auto's
    # 6-row fallback) so the human eye sees the table even when
    # stdout happens to be a tty.
    ___x_cmd_eget_subcmd_fit___tsv | ___x_cmd column --tsv
}

___x_cmd_eget_subcmd_fit___tsv(){
    # Fetch the same release JSON asset uses.
    local json
    if ! json="$( ___x_cmd_eget_api_release_unified_ "$_forge" "$owner" "$repo" "$_tag" "$_pre_release" "0" )"; then
        N=eget M="fit: failed to fetch release info for $target" log:ret:1
        return
    fi

    # Reshape to the asset TSV select_ feeds to detect.
    local assets_tsv
    assets_tsv="$( printf "%s" "$json" | ___x_cmd jq -r '.assets[] | "\(.name)\t\(.browser_download_url)\t\(.size)\t\(.digest // "")"' )"

    # Header + 6 platform rows.
    printf "platform\tname\turl\tsize\tscore\n"
    ___x_cmd_eget_detect_map "$assets_tsv" "any" "" "$repo"
}

# assetfit — per-asset fit label view. Sibling of lsassetmap:
# fit answers "which asset fits platform/runtime slot X",
# assetfit answers "for asset Y, which platform(s)/runtime(s)
# does it fit?". Each row is one asset, with its fit labels and
# the per-platform score(s). An asset that is a native binary
# for darwin/arm64 shows `platform/darwin/arm64` as its label;
# an asset that's a noarch RPM shows `runtime/rpm`; an asset
# that's both (rare) shows both labels joined with `+`.
#
# This is the inverse mapping of fit — useful for picking
# an asset manually (read off the labels, then run
# `x eget download owner/repo --asset <name>`).

# parse — release-data formatter. Reads raw release JSON from
# stdin (any source: curl, `x eget asset --json`, file
# redirect `< file.json`, etc.) and emits:
#   --tsv    asset rows: name \t url \t size \t digest
#   --json   the raw release object (passthrough; unwraps a
#            release-report envelope if caller piped one in)
#   --yml    release-report envelope wrapping --json
# No API fetch, no -f flag — this is the data-shape operator.
___x_cmd_eget_subcmd_parse(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget parse; return 0 ;; esac

    local fmt=auto
    while [ $# -gt 0 ]; do
        case "$1" in
            --json|--tsv|--yml|--tty|--auto)
                              fmt="${1#--}"  ;;
            -*)               N=eget M="parse: unknown option: $1" log:ret:64; return ;;
            *)                N=eget M="parse: unexpected argument: $1 (parse is stdin-only)" log:ret:64; return ;;
        esac
        shift
    done

    if [ "$fmt" = "auto" ]; then
        [ -t 1 ] && fmt=tty || fmt=tsv
    fi

    # Read the entire stdin. We cache it once because both the
    # --tsv and --json paths below consume stdin independently and
    # we don't want to fail on a missing pipe.
    local _release
    _release="$( cat )" || return 1

    case "$fmt" in
        tsv)
            printf '%s' "$_release" | ___x_cmd jq -r '
                ["name","url","size","digest"],
                ((.assets // [])[] | [.name, .browser_download_url, .size, (.digest // "")])
                | @tsv
            '
            ;;
        json)
            # Pass the raw release through; callers pipe it
            # forward unchanged. Unwrap a release-report envelope
            # so callers always see the release object itself.
            printf '%s' "$_release" | ___x_cmd jq -c '
                if type == "object" and has("release-report")
                then .["release-report"].release
                else .
                end
            '
            ;;
        yml)
            local x_
            x date dump_
            local _collected_at="$x_"
            local _release_obj
            _release_obj="$( printf '%s' "$_release" | ___x_cmd jq -c '
                if type == "object" and has("release-report")
                then .["release-report"].release
                else .
                end
            ' )"
            printf '{"release-report":{"collectedAt":"%s","release":%s}}' \
                "$_collected_at" "$_release_obj" \
                | yq -P -I 0 .
            ;;
        tty)
            printf '%s' "$_release" | ___x_cmd column --tsv --header \
                <<< "$( printf '%s\n' "$_release" \
                    | ___x_cmd jq -r '
                        (.assets // [])[]
                        | [.name, .browser_download_url, .size, (.digest // "")]
                        | @tsv
                    ' )"
            ;;
        *) N=eget M="parse: invalid format: $fmt" log:ret:64; return ;;
    esac
}

# classify — per-asset fit label classifier. Reads raw release
# JSON from stdin (same sources as parse) and emits:
#   --tsv    name \t url \t size \t fit
#   --json   [{name, url, size, fit, sha256?, sig?}, ...]
#   --yml    flat array of the same shape
# Same upstream pipe as parse (stdin only); both ops compose.
___x_cmd_eget_subcmd_classify(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget classify; return 0 ;; esac

    local fmt=auto
    while [ $# -gt 0 ]; do
        case "$1" in
            --json|--tsv|--yml|--tty|--auto)
                              fmt="${1#--}"  ;;
            -*)               N=eget M="classify: unknown option: $1" log:ret:64; return ;;
            *)                N=eget M="classify: unexpected argument: $1 (classify is stdin-only)" log:ret:64; return ;;
        esac
        shift
    done

    if [ "$fmt" = "auto" ]; then
        [ -t 1 ] && fmt=tty || fmt=tsv
    fi

    local _release
    _release="$( cat )" || return 1

    local _tsv
    _tsv="$( printf '%s' "$_release" | ___x_cmd jq -r '
        (.assets // [])[]
        | [.name, .browser_download_url, .size, (.digest // "")]
        | @tsv
    ' )"

    case "$fmt" in
        tsv)
            printf '%s' "$_tsv" | ___x_cmd_eget_subcmd_classify___emit_tsv
            ;;
        json)
            ___x_cmd_eget_subcmd_classify___emit_json "$_release" "$_tsv"
            ;;
        yml)
            ___x_cmd_eget_subcmd_classify___emit_json "$_release" "$_tsv" \
                | yq -P -I 0 .
            ;;
        tty)
            printf '%s' "$_tsv" | ___x_cmd_eget_subcmd_classify___emit_tsv \
                | ___x_cmd column --tsv
            ;;
        *) N=eget M="classify: invalid format: $fmt" log:ret:64; return ;;
    esac
}

# Run the awk classifier on a 4-column TSV stream (name \t url
# \t size \t digest) and emit a 5-column TSV with the per-asset
# fit label appended.
___x_cmd_eget_subcmd_classify___emit_tsv(){
    # The caller pipes the TSV stream into our stdin via the
    # command substitution that calls us. Read stdin directly —
    # any inner `cat -` would close stdin before awk reads it.
    awk -f "$___X_CMD_ROOT_MOD/eget/lib/awk/share.awk" \
        -f "$___X_CMD_ROOT_MOD/eget/lib/awk/assetfit.awk"
}

# Like the above but also pulls pair fields (sha256 / sig) from
# the original release JSON keyed by asset name. The pair
# suffix is appended to the asset name (e.g.
# `foo-1.0.tar.gz` + `.sha256`).
___x_cmd_eget_subcmd_classify___emit_json(){
    local _release="$1" _tsv="$2"
    ___x_cmd_eget_subcmd_classify___emit_tsv "$_tsv" \
        | awk 'BEGIN{FS=OFS="\t"; print "name\turl\tsize\tfit"} {print}' \
        | ___x_cmd jq -Rrs \
            --argjson release "$_release" '
            ([$release.assets[]?] | map({(.name): .browser_download_url}) | add // {}) as $by_name
            | split("\n") | .[1:] | map(select(length > 0)) | map(split("\t"))
            | map(. as $row | {
                name: $row[0], url: $row[1], size: (($row[2] | tonumber) // null), fit: $row[3]
            } | . + {
                sha256: ($by_name[.name + ".sha256"] // null),
                sig:    ($by_name[.name + ".sig"] // $by_name[.name + ".asc"]
                      // $by_name[.name + ".minisig"] // null)
            } | with_entries(select(.value != null)))
        '
}

# `x eget download owner/repo --asset <name>`).
___x_cmd_eget_subcmd_assetfit(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget assetfit; return 0 ;; esac

    local target="" _tag="" _pre_release="0" _forge="github" _verbose="0"

    local fmt=auto

    while [ $# -gt 0 ]; do
        case "$1" in
            -t|--tag)         shift; _tag="$1" ;;
            --pre-release)    _pre_release="1" ;;
            --verbose)        _verbose="1" ;;
            --json|--tsv|--yml|--tty|--auto)
                              fmt="${1#--}"  ;;

            -*)               N=eget M="assetfit: unknown option: $1" log:ret:64; return ;;
            *)                [ -z "$target" ] && target="$1" || { N=eget M="assetfit: unexpected argument: $1" log:ret:64; return; } ;;
        esac
        shift
    done

    [ -n "$target" ] || { N=eget M="assetfit: missing target (user/repo)" log:ret:64; return; }
    case "$target" in
        */*) ;;
        *)    N=eget M="assetfit: invalid target format: $target (expected user/repo)" log:ret:64; return ;;
    esac

    local owner="${target%%/*}" repo="${target#*/}"

    ___x_cmd_eget_subcmd_assetfit___"$fmt"
}

___x_cmd_eget_subcmd_assetfit___tsv(){
    # Fetch the same release JSON asset uses.
    local json
    if ! json="$( ___x_cmd_eget_api_release_unified_ "$_forge" "$owner" "$repo" "$_tag" "$_pre_release" "0" )"; then
        N=eget M="assetfit: failed to fetch release info for $target" log:ret:1
        return
    fi

    # Reshape to the asset TSV select_ feeds to detect.
    local assets_tsv
    assets_tsv="$( printf "%s" "$json" | ___x_cmd jq -r '.assets[] | "\(.name)\t\(.browser_download_url)\t\(.size)\t\(.digest // "")"' )"

    # Header: name, url, size, fit (single label per asset)
    printf "name\turl\tsize\tfit\n"
    AWK_REPO="$repo" AWK_FILTERS="" AWK_VERBOSE="0" \
        awk -f "$___X_CMD_ROOT_MOD/eget/lib/awk/share.awk" \
            -f "$___X_CMD_ROOT_MOD/eget/lib/awk/assetfit.awk" <<AIOEOF
$assets_tsv
AIOEOF
}

___x_cmd_eget_subcmd_assetfit___yml(){
    # --verbose: full release JSON under eget/collectedAt +
    # eget/assets (mirrors `asset` --yml's envelope, with the
    # full release object embedded so callers can see tags,
    # body, etc.). --default: a flat array of per-asset
    # objects with the same shape as --json (name/url/size/
    # fit/fit_score). The flat form is more useful for piping
    # into stat tools that just want the per-asset fit data.
    if [ "$_verbose" = "1" ]; then
        local x_
        x date dump_
        local _collected_at="$x_"

        local _json
        _json="$( ___x_cmd_eget_subcmd_assetfit___json )"

        local _envelope
        _envelope="$( printf '{"release-report":{"collectedAt":"%s","assets":%s}}' \
            "$_collected_at" "$_json" )"
        printf '%s' "$_envelope" | yq -P -I 0 .
        return
    fi
    ___x_cmd_eget_subcmd_assetfit___json | yq -P -I 0 .
}

___x_cmd_eget_subcmd_assetfit___json(){
    # Convert each TSV row from assetfit___tsv into a JSON object.
    # `fit` is the per-asset fit label (e.g. "platform/darwin/arm64"
    # or "runtime/rpm/x64"). `fit_score` is the per-slot score
    # (stringified because the same asset can fit multiple slots
    # with different scores; the format mirrors the TSV `fit_score`
    # column exactly). Pair signatures/hashes (sig, sha256, md5,
    # sha1, sha512, ...) are attached from the release JSON by
    # looking up sibling assets whose name has the matching
    # suffix appended.
    local _release_json
    _release_json="$( ___x_cmd_eget_api_release_unified_ "$_forge" "$owner" "$repo" "$_tag" "$_pre_release" "0" 2>/dev/null )" || _release_json="{}"

    ___x_cmd_eget_subcmd_assetfit___tsv | ___x_cmd jq -Rrs \
        --argjson release "$_release_json" '
        # Index release assets by name for pair lookup.
        ([$release.assets[]?] | map({(.name): .browser_download_url}) | add // {}) as $by_name
        | [
            $by_name["sha256" as $f | ""] // null   # placeholder, real split below
        ] as $_ignore
        | split("\n")
        | .[1:]
        | map(select(length > 0))
        | map(split("\t"))
        | map(. as $row | {
            name:      $row[0],
            url:       $row[1],
            size:      (($row[2] | tonumber) // null),
            fit:       $row[3],
            fit_score: $row[4]
        } | . + {
            # Pair fields. Suffixes are checked in fixed order —
            # longer/more specific wins (.sha256sum over .sum,
            # .minisig.json over .minisig).
            sig:        ($by_name[.name + ".sig"]             // $by_name[.name + ".asc"]             // $by_name[.name + ".minisig"]             // $by_name[.name + ".minisig.json"]             // $by_name[.name + ".pem"]             // null),
            sha256:     ($by_name[.name + ".sha256"]          // $by_name[.name + ".sha256sum"]       // null),
            sha512:     ($by_name[.name + ".sha512"]          // $by_name[.name + ".sha512sum"]       // null),
            sha1:       ($by_name[.name + ".sha1"]            // null),
            md5:        ($by_name[.name + ".md5"]             // $by_name[.name + ".sum"]              // null)
        } | with_entries(select(.value != null)))
    '
}

___x_cmd_eget_subcmd_assetfit___auto(){
    if [ -t 1 ]; then
        ___x_cmd_eget_subcmd_assetfit___tty
    else
        ___x_cmd_eget_subcmd_assetfit___tsv
    fi
}

___x_cmd_eget_subcmd_assetfit___tty(){
    ___x_cmd_eget_subcmd_assetfit___tsv | ___x_cmd column --tsv
}

___x_cmd_eget_subcmd_extract(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget extract; return 0 ;; esac
    [ "$#" -gt 0 ] || { N=eget M="extract: missing archive file" log:ret:64; return; }
    local archive="$1"; shift
    local file_glob="" all="0" to="." name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--file)  shift; file_glob="$1" ;;
            --all)      all="1" ;;
            --to)       shift; to="$1" ;;
            --name)     shift; name="$1" ;;
            *)          name="$1" ;;
        esac
        shift
    done
    : "${name:=$( basename "$archive" )}"
    name="${name%%.*}"
    ___x_cmd_eget_extract "$archive" "$file_glob" "$all" "$to" "$name"
}

___x_cmd_eget_subcmd_verify(){
    case "${1:-}" in -h|--help) ___x_cmd help -m eget verify; return 0 ;; esac
    [ "$#" -ge 2 ] || { N=eget M="verify: usage: x eget verify <file> <expected_hash>" log:ret:64; return; }
    local filepath="$1" expected="$2"
    ___x_cmd_eget_verify "$filepath" "$expected"
}
