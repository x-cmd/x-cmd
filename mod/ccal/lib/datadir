# shellcheck shell=dash

___x_cmd_ccal_datadir(){
    case "$1" in
        -h|--help)      ___x_cmd help -m ccal datadir    "$@"; return 0 ;;
    esac

    local index_folder="$___X_CMD_CCAL_LUNAR_INDEX_FOLDER"
    local data_url="https://codeberg.org/x-cmd/ccal-data/releases/download/${___X_CMD_CCAL_DATA_VERSION}/ccal-data.tar.xz"

    if [ -d "$index_folder" ]; then
        printf "index: %s\n" "$index_folder"
        printf "data: %s\n" "$___X_CMD_CCAL_DATA_FILE"
    else
        ccal:error "Data is not downloaded."
        ccal:info "Try 'x ccal update' to retrieve data from -> $data_url"
        return 1
    fi
}
