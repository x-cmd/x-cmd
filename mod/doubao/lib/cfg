# shellcheck shell=dash disable=SC2034

xrc cfgy
___x_cmd_doubao_cfg(){
    [ "$#" -gt 0 ] || {
        ___x_cmd_doubao_init
        return
    }

    local op="$1"; shift
    case "$op" in
        -h|--help)      ___x_cmd help -m doubao --cfg ;;
        --minimal-init) ___x_cmd_doubao_minimal_init "$@" ;;
        def_)           ___x_cmd_doubao_def_ "$@" ;;
        *)              ___x_cmd_doubao_cfg___invoke "$op" "$@" ;;
    esac
}

___x_cmd_doubao_def_(){
    local op="$1";
    case "$op" in
        model)      x_="$___X_CMD_DOUBAO_DEFAULT_FIRST_MODEL" ;;
        endpoint)   x_="$___X_CMD_DOUBAO_DEFAULT_ENDPOINT" ;;
        *) ;;
    esac
}

___x_cmd_doubao_cur(){
    local X_help_cmd=; X_help_cmd='___x_cmd help -m doubao --cur' help:arg:parse
    ___x_cmd_doubao_cfg --current "$@"
}

___x_cmd_doubao_minimal_init(){
    local cur_apikey=""
    if [ -f "$(___x_cmd_doubao_cur --get config)" ]; then
        ___x_cmd_doubao_cur cur_apikey:=apikey
    fi

    doubao:info "To get Doubao API key -> https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey"

    ___x_cmd_doubao_cfg___invoke --init ${cur_apikey:+"--ctrl_exit_strategy"} \
        apikey      "Set up the Doubao API key"                               \
                    "$cur_apikey"   '=~*' "^[A-Za-z0-9-]+$"

    ___x_cmd_doubao_has_apikey 2>/dev/null >&2
}

___x_cmd_doubao_init(){
    local cur_apikey=; local cur_agentapikey; local cur_codingapikey; local cur_model=; local cur_maxtoken=; local cur_temperature=; local cur_proxy=; local cur_endpoint

    if [ -f "$(___x_cmd_doubao_cur --get config)" ]; then
        ___x_cmd_doubao_cur cur_apikey:=apikey cur_agentapikey:=agentapikey cur_codingapikey:=codingapikey cur_model:=model cur_maxtoken:=maxtoken cur_temperature:=temperature cur_proxy:=proxy cur_endpoint:=endpoint 2>/dev/null
    fi

    # https://ark.volcengine.com/region:cn-beijing/docs/coding-plan-personal-get-started
    doubao:info "To get Doubao API key -> https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey"
    # Agent Plan: https://ark.cn-beijing.volces.com/api/plan
    # Coding Plan: https://ark.cn-beijing.volces.com/api/coding

    ___x_cmd_doubao_cfg___invoke --init ${cur_apikey:+"--ctrl_exit_strategy"} \
        apikey          "Set up the Doubao API key"                              \
                        "$cur_apikey"          '=~*' "^[A-Za-z0-9-]+$" --        \
        agentapikey    "Set up the Doubao Agent Plan API key"                   \
                        "$cur_agentapikey"   ' =~*' "^[A-Za-z0-9-]+$" --        \
        codingapikey   "Set up the Doubao Coding Plan API key"                  \
                        "$cur_codingapikey"   '=~*' "^[A-Za-z0-9-]+$" --        \
        model           "Set up the Doubao API model"                            \
                        "${cur_model:-"$___X_CMD_DOUBAO_DEFAULT_FIRST_MODEL"}" '=' doubao-seed-evolving doubao-seed-2.1-pro doubao-seed-2.1-lite doubao-seed-2.0-mini glm-5.3 glm-5.3-flash deepseek-v4.1-flash deepseek-v4.1-flash-economy deepseek-v4-flash deepseek-v4-pro kimi-k3 kimi-k3.1-pro --  \
        maxtoken        "Set up the Doubao API maxtoken"                          \
                        "${cur_maxtoken:-32k}" --                                 \
        temperature     "Set up the Doubao API temperature"                       \
                        "${cur_temperature:-"1.0"}" --                              \
        proxy           "Set up the network proxy for API requests (optional)"      \
                        "$cur_proxy" '=~'    "^([a-z0-9]+://)?[0-9.:]+$" --         \
        endpoint        "Set up the endpoint (optional)"                            \
                        "${cur_endpoint:-"$___X_CMD_DOUBAO_DEFAULT_ENDPOINT"}"

}

___x_cmd_doubao_has_apikey(){
    local apikey=
    ___x_cmd_doubao_cur apikey:= 2>/dev/null
    [ -n "$apikey" ] || {
        doubao:error "Please setting up your apikey first ==> 'x doubao --cfg apikey=<your apikey>'"
        doubao:warn "You can get the Doubao API Key from ==>  https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey"
        return 1
    }
}

___X_CMD_DOUBAO_CFG_VARLIST="apikey,agentapikey,codingapikey,model,maxtoken,temperature,seed,proxy,endpoint"
___x_cmd_doubao_cfg___invoke(){
    ___X_CMD_DOUBAO_CFG_DATA_FALLBACK_apikey="${ARK_API_KEY:-$DOUBAO_API_KEY}"

    ___x_cmd_cfgy_obj   \
        --prefix            ___X_CMD_DOUBAO_CFG_DATA                \
        --default-config    "${___X_CMD_ROOT_CFG}/doubao/X.cfg.yml" \
        --current-config    "${___X_CMD_DOUBAO_LOCAL_CONFIG}"       \
        --current-profile   "${___X_CMD_DOUBAO_LOCAL_PROFILE}"      \
        --varlist           "$___X_CMD_DOUBAO_CFG_VARLIST"          \
        "$@"
}

