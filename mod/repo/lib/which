# shellcheck shell=dash

___x_cmd_repo_which(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo which "$@" ; return 0 ;;
    esac

    local x_
    ___x_cmd_repo_which_ "$@" || return $?
    printf "%s\n" "$x_"
}

# Resolve a repo id to its default worktree path.
# Supports:
#   - owner/name                    -> github.com/owner/name
#   - github.com/owner/name         -> github.com/owner/name
#   - gh/owner/name                 -> github.com/owner/name
#   - codeberg.org/owner/name       -> codeberg.org/owner/name
#   - cb/owner/name                 -> codeberg.org/owner/name
#   - gitlab.com/owner/name         -> gitlab.com/owner/name
#   - gl/owner/name                 -> gitlab.com/owner/name
#   - gitee.com/owner/name          -> gitee.com/owner/name
#   - gt/owner/name                 -> gitee.com/owner/name
#   - bitbucket.org/owner/name      -> bitbucket.org/owner/name
#   - bb/owner/name                 -> bitbucket.org/owner/name
#   - /<fuzzy>                      -> fuzzywhich
___x_cmd_repo_which_(){
    local addr="$1"
    local wtname=""

    case "$addr" in
        */*@*|*:*@*)
            ___x_cmd_repo_wtname_encode_ "${addr##*@}"
            wtname="@$x_"
            addr="${addr%@*}"
            ;;
    esac

    local hostname

    case "$addr" in
        /*)
            x_=$(___x_cmd_repo_fuzzywhich "${addr#/}" 2>/dev/null) || return $?
            ;;

        git@*:*)
            hostname="${addr%:*}"
            hostname="${hostname#git@}"
            x_="$___X_CMD_REPO_ROOT/$hostname/${addr#*:}"
            ;;

        github.com/*/*|gh/*/*)
            x_="$___X_CMD_REPO_ROOT/github.com/${addr#*/}"
            ;;
        codeberg.org/*/*|cb/*/*)
            x_="$___X_CMD_REPO_ROOT/codeberg.org/${addr#*/}"
            ;;
        gitlab.com/*/*|gl/*/*)
            x_="$___X_CMD_REPO_ROOT/gitlab.com/${addr#*/}"
            ;;
        gitee.com/*/*|gt/*/*)
            x_="$___X_CMD_REPO_ROOT/gitee.com/${addr#*/}"
            ;;
        bitbucket.org/*/*|bb/*/*)
            x_="$___X_CMD_REPO_ROOT/bitbucket.org/${addr#*/}"
            ;;
        */*/*)
            x_="$___X_CMD_REPO_ROOT/${addr#/}"
            ;;
        */*)
            x_="$___X_CMD_REPO_ROOT/github.com/${addr}"
            ;;
    esac

    x_="${x_}${wtname}"
}

# Resolve a repo id to a git-cloneable URL.
# Passes through complete URLs (contains :// or scp-like user@host:path).
# Maps provider shorthands to their HTTPS canonical URLs.
___x_cmd_repo_giturl_(){
    local addr="$1"

    case "$addr" in
        *://*|*@*:*)    x_="$addr"; return 0 ;;
    esac

    case "$addr" in
        github.com/*/*)
            x_="https://github.com/${addr#github.com/}"
            ;;
        gh/*/*)
            x_="https://github.com/${addr#gh/}"
            ;;
        codeberg.org/*/*)
            x_="https://codeberg.org/${addr#codeberg.org/}"
            ;;
        cb/*/*)
            x_="https://codeberg.org/${addr#cb/}"
            ;;
        gitlab.com/*/*)
            x_="https://gitlab.com/${addr#gitlab.com/}"
            ;;
        gl/*/*)
            x_="https://gitlab.com/${addr#gl/}"
            ;;
        gitee.com/*/*)
            x_="https://gitee.com/${addr#gitee.com/}"
            ;;
        gt/*/*)
            x_="https://gitee.com/${addr#gt/}"
            ;;
        bitbucket.org/*/*)
            x_="https://bitbucket.org/${addr#bitbucket.org/}"
            ;;
        bb/*/*)
            x_="https://bitbucket.org/${addr#bb/}"
            ;;
        */*)
            x_="https://github.com/${addr}"
            ;;
        *)
            return 1
            ;;
    esac
}
