
___x_cmd_repo_getgitdir_(){
    local project_dir="$1"
    x_="$project_dir/.git"
    [ -e "$x_" ]  ||  {
        x_=""
        N=repo M="Path exists but no .git -> $project_dir" log:ret:1
    }

    if [ -f "$x_/config" ]; then
        return 0
    elif [ -f "$x_" ]; then
        read -r x_ <"$x_"
        case "$x_" in
            "gitdir: "*)    x_="${x_#"gitdir: "}" ;;
            *)              N=repo M="Expect a valid worktree .git file -> $project_dir/.git " log:ret:1
        esac
    else
        N=repo M="Expecting a directory or a worktree .git file -> $x_" log:ret:1
    fi
}

___x_cmd_repo_getgitdir(){
    local x_=""
    ___x_cmd_repo_getgitdir_ "$@" || return $?
    printf "%s\n" "$x_"
}
