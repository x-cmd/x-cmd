___x_cmd_repo_wt(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo wt ; return 0 ;;
        ls)         shift; ___x_cmd_repo_wt_ls "$@" ;;
        rm)         shift; ___x_cmd_repo_wt_rm "$@" ;;
        create)     shift; ___x_cmd_repo_wt_add "$@" ;;
        *)
            ___x_cmd_repo_wt_add "$@"
            ;;
    esac
}

# default: create-or-attach on <branch>
___x_cmd_repo_wt_add(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo wt create ; return 0 ;;
    esac

    local id="$1" branch="$2"
    local bare target

    [ -n "$branch" ] || { ___x_cmd help -m repo wt create ; return 1 ; }

    bare="$(___x_cmd_repo_bare "$id")" || return $?
    target="$(___x_cmd_repo_wt_path "$id" "$branch")" || return $?

    if git -C "$bare" rev-parse --verify --quiet "$branch" 2>/dev/null; then
        git -C "$bare" worktree add "$target" "$branch"
    else
        git -C "$bare" worktree add -b "$branch" "$target" HEAD
    fi
}

___x_cmd_repo_wt_ls(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo wt ls ; return 0 ;;
    esac

    local id="$1"
    local bare

    bare="$(___x_cmd_repo_bare "$id")" || return $?
    git -C "$bare" worktree list
}

___x_cmd_repo_wt_rm(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo wt rm ; return 0 ;;
    esac

    local id="$1" branch="$2"
    local bare target

    [ -n "$branch" ] || { ___x_cmd help -m repo wt rm ; return 1 ; }

    bare="$(___x_cmd_repo_bare "$id")" || return $?
    target="$(___x_cmd_repo_wt_path "$id" "$branch")" || return $?

    git -C "$bare" worktree remove "$target"
}