# shellcheck shell=dash

___x_cmd_repo_prepare(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo prepare "$@" ; return 0 ;;
    esac

    [ $# -gt 0 ] || { ___x_cmd help -m repo prepare ; return 1 ; }

    local id
    while [ $# -gt 0 ]; do
        id="$1"
        ___x_cmd_repo_update_one "$id" || return $?
        ___x_cmd_repo_resolve_ "$id" || return $?
        printf "%s\n" "$x_"
        shift
    done
}

___x_cmd_repo_wtname_encode_(){
    x_="$1"
    while true; do
        case "$x_" in
            */*)        x_="${x_%%"/"*}~${x_#*"/"}" ;;
            *)          break ;;
        esac
    done
}

___x_cmd_repo_wtname_encode(){
    local x_
    ___x_cmd_repo_wtname_encode_ "$@" || return $?
    printf "%s\n" "$x_"
}

___x_cmd_repo_wtname_decode(){
    local name="$1"
    while true; do
        case "$name" in
            *"~"*)      name="${name%%"~"*}/${name#*"~"}" ;;
            *)          break ;;
        esac
    done
    printf '%s\n' "$name"
}

___x_cmd_repo_wtname_decode_(){
    x_=$(___x_cmd_repo_wtname_decode "$@")
}