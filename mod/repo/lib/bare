___x_cmd_repo_bare(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo bare "$@" ; return 0 ;;
    esac

    local x_
    ___x_cmd_repo_resolve_ "$1" || return $?
    printf "%s\n" "$___X_CMD_REPO_ROOT/.bare/${x_#"$___X_CMD_REPO_ROOT/"}.git"
}

___x_cmd_repo_wt_path(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo wt-path "$@" ; return 0 ;;
    esac

    local id="$1" branch="$2"
    local x_
    ___x_cmd_repo_resolve_ "$id" || return $?

    printf '%s@%s\n' "$x_" "$(___x_cmd_repo_wtname_encode "$branch")"
}