# shellcheck shell=dash disable=SC2016

___x_cmd_repo_card(){
    local days=90
    local mode=auto
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)  ___x_cmd help -m repo card ; return 0 ;;
            --days)     days="$2" ; shift 2 ;;
            --days=*)   days="${1#--days=}" ; shift ;;
            --tty|--yml|--auto)
                        mode=${1#--}; shift ;;
            -*)         N=repo M="Unknown flag -> $1 (try --days N)" log:ret:64 ;;
            *)          break ;;
        esac
    done

    [ $# -gt 0 ] || N=repo M="Usage: x repo card [--days N] <id>" log:ret:64

    case "$days" in
        ''|*[!0-9]*) N=repo M="--days must be a positive integer, got -> $days" log:ret:64 ;;
    esac

    local id="$1"
    local owner_repo=""

    case "$id" in *@*) id="${id%@*}" ;; esac

    case "$id" in
        github.com/*) owner_repo="${id#github.com/}" ;;
        gh/*)         owner_repo="${id#gh/}" ;;
        */*)          owner_repo="$id" ;;
        *)            N=repo M="Invalid repo id -> $id (expect owner/repo)" log:ret:1 ;;
    esac

    # ___x_cmd ccmd 1h -- ___x_cmd_repo_card_emit_"$mode" "$owner_repo" "$days"
    # Note: ccmd 1h is a 1-hour result cache, not a wrapper. It caches
    # the function's stdout for 1h, which breaks when different inputs
    # (e.g. running x repo card for two different repos) hit the same
    # cached output. Call the emit function directly.
    ___x_cmd_repo_card_emit_"$mode" "$owner_repo" "$days"
}


___x_cmd_repo_card_emit_auto(){
    if [ -t 1 ]; then
        ___x_cmd_repo_card_emit_tty "$1" "$2"
    else
        ___x_cmd_repo_card_emit_yml "$1" "$2"
    fi
}


___x_cmd_repo_card_emit_tty(){
    ___x_cmd_repo_card_emit_yml "$1" "$2" | ___x_cmd_cmds awk -f "$___X_CMD_ROOT_MOD/repo/lib/awk/card.awk"
}

___x_cmd_repo_card_emit_yml(){
    ___x_cmd ccmd 3h -- ___x_cmd_repo_card_emit_yml___inner "$@"
}

___x_cmd_repo_card_emit_yml___inner(){
    local owner_repo="$1"
    local days="$2"
    local owner="${owner_repo%/*}"
    local repo="${owner_repo#*/}"

    local gh_token
    gh_token=$(gh auth token 2>/dev/null) || gh_token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
    if [ -z "$gh_token" ]; then
        N=repo M="No GitHub token. Run 'gh auth login' or set GH_TOKEN." log:ret:1
    fi

    # Four windows: 30-day (recent momentum), 90-day (quarter default,
    # user-overridable via --days), 180-day (half-year), 360-day (year).
    # Date math goes through `x date` (x-cmd's date module) instead of
    # the system `date` binary, so we don't need the macOS-vs-Linux
    # dual-syntax fallback (`-v-` / `-d "N days ago"`). One
    # `x date timestamp` gives the current epoch; subtracting 30/90/180/360
    # days in seconds gives the cutoff timestamps, and `x date dump`
    # formats each into YYYY-MM-DD for client-side comparison against
    # GraphQL date fields like publishedAt[:10].

    local x_
    ___x_cmd epoch get_
    local now_ts="$x_"

    local ts30=$(( now_ts - 30  * 86400 )) \
          ts90=$(( now_ts - 90  * 86400 )) \
          ts180=$(( now_ts - 180 * 86400 )) \
          ts360=$(( now_ts - 360 * 86400 ))
    local date30 date90 date180 date360
    ___x_cmd date dump_ --fmt '%Y-%m-%d' $ts30; date30=$x_
    ___x_cmd date dump_ --fmt '%Y-%m-%d' $ts90; date90=$x_
    ___x_cmd date dump_ --fmt '%Y-%m-%d' $ts180; date180=$x_
    ___x_cmd date dump_ --fmt '%Y-%m-%d' $ts360; date360=$x_
    local days90="$days"

    # GraphQL: every static repo field + 16 time-windowed search calls
    # (mergedPR / openPR / closedIssue / openIssue × 30d / 90d / 180d /
    # 360d) + defaultBranchRef for the HEAD SHA, all in one round-trip.
    #
    # History:
    # - GraphQL `search(...)` at root level works when aliased (the
    #   earlier failure was when search was nested inside a
    #   `repository(...)` selection — that returns 0 silently).
    # - `defaultBranchRef` is pulled into a separate aliased
    #   repository query because inlining it alongside a large
    #   field set hits an undocumented GraphQL cost ceiling.
    # - `history(since:DATE)` errors when multiple aliased instances
    #   are on the same level, and even a single instance is
    #   currently broken on GitHub's backend, so recentCommit goes
    #   via REST `/commits?since=DATE` below.
    local query response card_jq
    # No recentStar / recentFork: GitHub's GraphQL `stargazers` /
    # `forks` connections are capped at first:100 with no time-series
    # summary endpoint (unlike commits which have /stats/commit_activity).
    # For popular repos this undercounts by 1-2 orders of magnitude.
    # The total counts (star: ... / fork: ...) in the popularity:
    # section are exact (stargazerCount / forkCount), so dropping the
    # deltas is honest: the card shows "this repo has 115k stars" but
    # not "X stars in 30 days". Story: .x-cmd/story/260824.recentstar-fork-cap.md
    #
    # All jq filter logic lives in lib/awk/card.jq as named
    # functions (card_query / card_search_counts / card_commit_counts
    # / card_yaml); this shell function just feeds it inputs and
    # reads back outputs.
    card_jq_dir="${___X_CMD_ROOT_MOD}/repo/lib/awk"

    # Build 16 search query strings (4 metrics × 4 windows) — passing
    # them as full strings (not concatenated via GraphQL + operator)
    # avoids the > character being treated as a parse terminator.
    local r="repo:${owner_repo}"
    local _s1="$r is:pr is:merged created:>$date30"
    local _s2="$r is:pr is:merged created:>$date90"
    local _s3="$r is:pr is:merged created:>$date180"
    local _s4="$r is:pr is:merged created:>$date360"
    local _s5="$r is:pr state:open created:>$date30"
    local _s6="$r is:pr state:open created:>$date90"
    local _s7="$r is:pr state:open created:>$date180"
    local _s8="$r is:pr state:open created:>$date360"
    local _s9="$r is:issue state:closed created:>$date30"
    local _s10="$r is:issue state:closed created:>$date90"
    local _s11="$r is:issue state:closed created:>$date180"
    local _s12="$r is:issue state:closed created:>$date360"
    local _s13="$r is:issue state:open created:>$date30"
    local _s14="$r is:issue state:open created:>$date90"
    local _s15="$r is:issue state:open created:>$date180"
    local _s16="$r is:issue state:open created:>$date360"

    query=$(___x_cmd jq -nc -L "$card_jq_dir" \
        --arg o "$owner" --arg n "$repo" \
        --arg s1 "$_s1" --arg s2 "$_s2" --arg s3 "$_s3" --arg s4 "$_s4" \
        --arg s5 "$_s5" --arg s6 "$_s6" --arg s7 "$_s7" --arg s8 "$_s8" \
        --arg s9 "$_s9" --arg s10 "$_s10" --arg s11 "$_s11" --arg s12 "$_s12" \
        --arg s13 "$_s13" --arg s14 "$_s14" --arg s15 "$_s15" --arg s16 "$_s16" \
        'include "card";
         card_query($o; $n;
                    $s1;  $s2;  $s3;  $s4;
                    $s5;  $s6;  $s7;  $s8;
                    $s9;  $s10; $s11; $s12;
                    $s13; $s14; $s15; $s16)')

    response=$(curl -sS \
        -H "Authorization: bearer $gh_token" \
        -H "Content-Type: application/json" \
        -d "$query" https://api.github.com/graphql 2>/dev/null) || response=""
    if [ -z "$response" ]; then
        N=repo M="GraphQL fetch failed for -> $owner_repo" log:ret:1
    fi

    # Pull all 16 search counts from the GraphQL response in a single
    # jq call (instead of 16 separate invocations). The filter emits
    # one value per line in a fixed order; the heredoc + read block
    # below parses them into the named variables.
    local data
    data=$(___x_cmd jq -r -L "$card_jq_dir" 'include "card"; card_search_counts' <<A
$response
A
)
    local merged30 merged90 merged180 merged360 \
        openpr30 openpr90 openpr180 openpr360 \
        closei30 closei90 closei180 closei360 \
        openi30 openi90 openi180 openi360
    {
        read -r merged30
        read -r merged90
        read -r merged180
        read -r merged360
        read -r openpr30
        read -r openpr90
        read -r openpr180
        read -r openpr360
        read -r closei30
        read -r closei90
        read -r closei180
        read -r closei360
        read -r openi30
        read -r openi90
        read -r openi180
        read -r openi360
    } <<A
$data
A

    # recentCommit via /stats/commit_activity. This endpoint returns
    # daily commit counts for the last 52 weeks (no 100-cap) and is
    # public (no admin scope required). GitHub caches it for ~1h.
    # One call gets all 4 windows (30/90/180/360 days) via a single
    # jq filter that sums the tail of the flattened days array.
    #
    # GitHub computes this asynchronously: on a cold cache it answers 202
    # with an empty body or {}, and card_commit_counts then honestly reports
    # 0 for every window. Without a retry that silently turns "stats not
    # ready" into "no commits" — and the ccmd 3h result cache above pins the
    # bogus zeros for the next three hours. So retry until the body is an
    # array, but only for the not-ready shape: a `message` field means a real
    # 404/403 (archived, fork, blocked, or empty repo) that will never become
    # an array, and retrying it just burns 6s per repo.
    local commit_raw commit_data attempt
    commit_raw=""
    attempt=0
    while [ "$attempt" -lt 3 ]; do
        attempt=$((attempt + 1))
        commit_raw=$(curl -sS -H "Authorization: bearer $gh_token" \
            "https://api.github.com/repos/${owner_repo}/stats/commit_activity" 2>/dev/null)
        case "$(printf '%s' "$commit_raw" | ___x_cmd jq -r 'if type == "array" then "ok" elif type == "object" and has("message") then "dead" else "wait" end' 2>/dev/null)" in
            ok)   break ;;
            dead) commit_raw=""; break ;;
        esac
        commit_raw=""
        [ "$attempt" -lt 3 ] && sleep 3
    done
    if [ -z "$commit_raw" ]; then
        repo:warn "no commit_activity for $owner_repo; recording commit: 0"
        commit_raw='[]'
    fi
    commit_data=$(printf '%s' "$commit_raw" | ___x_cmd jq -r -L "$card_jq_dir" 'include "card"; card_commit_counts')
    local commit30 commit90 commit180 commit360
    {
        read -r commit30
        read -r commit90
        read -r commit180
        read -r commit360
    } <<A
$commit_data
A

    local collected_at
    collected_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    # Single jq pass. Static metrics in github:, every windowed stat
    # in recent: (grouped by 30d + N), and detail: holds the API-
    # derived HEAD SHA. No local clone / no git fetch on this path.
    ___x_cmd jq -r -L "$card_jq_dir" \
        --argjson merged30 "$merged30" \
        --argjson merged90 "$merged90" \
        --argjson merged180 "$merged180" \
        --argjson merged360 "$merged360" \
        --argjson openpr30 "$openpr30" \
        --argjson openpr90 "$openpr90" \
        --argjson openpr180 "$openpr180" \
        --argjson openpr360 "$openpr360" \
        --argjson closei30 "$closei30" \
        --argjson closei90 "$closei90" \
        --argjson closei180 "$closei180" \
        --argjson closei360 "$closei360" \
        --argjson openi30 "$openi30" \
        --argjson openi90 "$openi90" \
        --argjson openi180 "$openi180" \
        --argjson openi360 "$openi360" \
        --argjson commit30 "$commit30" \
        --argjson commit90 "$commit90" \
        --argjson commit180 "$commit180" \
        --argjson commit360 "$commit360" \
        --arg date30 "$date30" \
        --arg date90 "$date90" \
        --arg date180 "$date180" \
        --arg date360 "$date360" \
        --arg days90 "$days90" \
        --arg collected_at "$collected_at" \
        'include "card";
         card_yaml($merged30;  $merged90;  $merged180;  $merged360;
                  $openpr30;  $openpr90;  $openpr180;  $openpr360;
                  $closei30;  $closei90;  $closei180;  $closei360;
                  $openi30;   $openi90;   $openi180;   $openi360;
                  $commit30;  $commit90;  $commit180;  $commit360;
                  $date30;    $date90;    $date180;    $date360;
                  $days90;    $collected_at)' <<A
$response
A

}