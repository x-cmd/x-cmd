# x repo barefetch <id>...
#
# Bare clone (missing) + fetch (no merge).
# Intended for mirror use cases: never touches local refs/HEAD,
# only refreshes the remote-tracking refs of the bare repo at
# ~/.x-repo/.bare/<provider>/<owner>/<name>.git.
#
# Prints the bare path on stdout.

___x_cmd_repo_barefetch(){
    case "${1-}" in
        -h|--help)  ___x_cmd help -m repo barefetch "$@" ; return 0 ;;
    esac

    [ $# -gt 0 ] || { ___x_cmd help -m repo barefetch ; return 1 ; }

    local id
    for id in "$@"; do
        ___x_cmd_repo_barefetch_one "$id" || return $?
    done
}

___x_cmd_repo_barefetch_one(){
    local id="$1"
    local bare
    local x_

    ___x_cmd_repo_resolve_ "$id" || return $?
    bare="$___X_CMD_REPO_ROOT/.bare/${x_#"$___X_CMD_REPO_ROOT/"}.git"

    if [ ! -d "$bare" ]; then
        ___x_cmd_repo_giturl_ "$id" || return $?
        local url="$x_"
        ___x_cmd mkdirp "$(dirname "$bare")" || return $?
        ___x_cmd git clone --bare "$url" "$bare" || return $?
    fi

    # Fetch all remotes — refresh remote-tracking refs without touching
    # local refs/HEAD (no merge).
    ___x_cmd git -C "$bare" fetch --all --prune || return $?

    printf "%s\n" "$bare"
}
