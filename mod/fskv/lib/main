# shellcheck shell=dash

___x_cmd log init   fskv

___X_CMD_FSKV_DEFAULT_FILE=".x-cmd.fskv.default.file"
___X_CMD_FSKV_ROOT="${___X_CMD_FSKV_ROOT:-""}"

___x_cmd_fskv___main(){
    [ "$#" -gt 0 ] ||   set -- --help

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)  ___x_cmd help -m fskv "$@" ;            return 0 ;;

            -r|--root)  ___X_CMD_FSKV_ROOT="$2";                arg:2:shift ;;
            :*)         ___X_CMD_FSKV_ROOT="${1#:}";            shift ;;

            ls|has|get|get_|rm|root)
                        local op="$1" ; shift
                        ___x_cmd_fskv_"$op" "$@" ;              return $? ;;

            set|put)
                        ___x_cmd_fskv_put   "$@" ;;

            *)          N=fskv M="Unsupported op ==> $1" log:ret:64 ;;
        esac
    done
}

___x_cmd_fskv_get(){
    [ $# -gt 0 ]    ||      set -- --help
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m fskv get "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    x_=""
    ___x_cmd_fskv_get_ "$@" || return 1
    printf "%s" "$x_"
}

___x_cmd_fskv_get_(){
    [ "$#" -ge 1 ] ||    N=fskv M="get: expected <key>, got $# args" log:ret:64
    [ -n "$___X_CMD_FSKV_ROOT" ] || ___X_CMD_FSKV_ROOT="${PWD%/}/.x-cmd/fskv"

    local k="$1"
    local fp="$___X_CMD_FSKV_ROOT/$k"
    ___x_cmd abspath_ "$fp"
    fp="$x_"
    if [ -f "$fp" ]; then
        ___x_cmd rat_ "$fp"
    elif [ -d "$fp" ]; then
        [ -f "$fp/$___X_CMD_FSKV_DEFAULT_FILE" ] || return 1
        ___x_cmd rat_ "$fp/$___X_CMD_FSKV_DEFAULT_FILE"
    else
        return 1
    fi
}

___x_cmd_fskv_has(){
    [ $# -gt 0 ]    ||      set -- --help
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m fskv has "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    [ "$#" -ge 1 ] ||    N=fskv M="has: expected <key>, got $# args" log:ret:64
    [ -n "$___X_CMD_FSKV_ROOT" ] || ___X_CMD_FSKV_ROOT="${PWD%/}/.x-cmd/fskv"

    local k="$1"
    local fp="$___X_CMD_FSKV_ROOT/$k"
    local x_
    ___x_cmd abspath_ "$fp"
    fp="$x_"

    [ -f "$fp" ] || [ -f "$fp/$___X_CMD_FSKV_DEFAULT_FILE" ]
}

___x_cmd_fskv_ls(){
    [ $# -gt 0 ]    ||      set -- --help
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m fskv ls "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    [ "$#" -ge 1 ] ||    N=fskv M="ls: expected <key prefix>, got $# args" log:ret:64
    [ -n "$___X_CMD_FSKV_ROOT" ] || ___X_CMD_FSKV_ROOT="${PWD%/}/.x-cmd/fskv"

    [ -d "$___X_CMD_FSKV_ROOT/$1" ] || return 0

    local dir="$___X_CMD_FSKV_ROOT/$1"
    local x_
    ___x_cmd fsiter --file_ "$dir"

    while read -r line; do
        case "$line" in
            "$___X_CMD_FSKV_DEFAULT_FILE")
                continue ;;
            *)
                printf "%s\n" "$line" ;;
        esac
    done <<A
$x_
A

    ___x_cmd fsiter --dir_ "$dir"

    while read -r line; do
        if [ -f "$dir/$line/$___X_CMD_FSKV_DEFAULT_FILE" ]; then
            printf "%s\n" "$line"
        fi
    done <<A
$x_
A

}

___x_cmd_fskv_root(){
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m fskv root "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    [ "$#" -le 1 ] ||    N=fskv M="root: expected [path], got $# args" log:ret:64

    if [ -z "$1" ]; then
        [ -n "${___X_CMD_FSKV_ROOT:-}" ] || return
        printf "%s\n" "$___X_CMD_FSKV_ROOT"
        return
    fi

    [ -d "$1" ] || {
        [ ! -e "$1" ] || {
            M="fail to create folder for already existing non-folder ==> $1" N=fskv log:ret:1
        }
        ___x_cmd mkdirp "$1"
    }

    local x_
    ___x_cmd abspath_ "$1"
    ___X_CMD_FSKV_ROOT="$x_"
}


___x_cmd_fskv_rm(){
    [ $# -gt 0 ]    ||      set -- --help
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m fskv rm "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    [ "$#" -ge 1 ] ||    N=fskv M="rm: expected <key>, got $# args" log:ret:64

    [ -n "$___X_CMD_FSKV_ROOT" ] || ___X_CMD_FSKV_ROOT="${PWD%/}/.x-cmd/fskv"
    local x_
    ___x_cmd abspath_ "$___X_CMD_FSKV_ROOT" ;   ___X_CMD_FSKV_ROOT="$x_"

    local k="$1"
    local fp="$___X_CMD_FSKV_ROOT/$k"
    ___x_cmd abspath_ "$fp" ; fp="$x_"

    if [ -f "$fp" ]; then
        ___x_cmd_cmds_rm "$fp"
    elif [ -d "$fp" ] && [ -f "$fp/$___X_CMD_FSKV_DEFAULT_FILE" ]; then
        ___x_cmd_cmds_rm "$fp/$___X_CMD_FSKV_DEFAULT_FILE"
    else
        N=fskv M="key '$k' not found" log:ret:1
    fi
}


___x_cmd_fskv_put(){
    [ $# -gt 0 ]    ||      set -- --help
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m fskv put "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    [ "$#" -eq 2 ] ||    N=fskv M="put: expected <key> <value>, got $# args" log:ret:64

    [ -n "$___X_CMD_FSKV_ROOT" ] || ___X_CMD_FSKV_ROOT="${PWD%/}/.x-cmd/fskv"
    local x_
    ___x_cmd abspath_ "$___X_CMD_FSKV_ROOT" ;   ___X_CMD_FSKV_ROOT="$x_"
    ___x_cmd mkdirp "$___X_CMD_FSKV_ROOT"

    local k="$1"
    local fp="$___X_CMD_FSKV_ROOT/$k"
    ___x_cmd abspath_ "$fp" ; fp="$x_"

    if [ -f "$fp" ]; then
        printf "%s\n" "$2" > "$fp"
    elif [ -d "$fp" ]; then
        printf "%s\n" "$2" > "$fp/$___X_CMD_FSKV_DEFAULT_FILE"
    else
        local k_leaf="${k##*/}"
        x_="${fp%"$k_leaf"}"
        x_="${x_#"$___X_CMD_FSKV_ROOT"}"
        x_="${x_%/}"
        x_="${x_#/}"

        if [ -n "$x_" ]; then
            ___x_cmd_fskv___mkdirp "$___X_CMD_FSKV_ROOT" "${x_}" || N=fskv M="Fail to create dir -> ${fp%/*}" log:ret:1
        fi

        printf "%s\n" "$2" >"$fp"
    fi
}


___x_cmd_fskv___mkdirp(){
    local root="$1"
    local kp="$2"
    ! ___x_cmd mkdirp "$root/$kp" 2>/dev/null || return 0

    local cur="$kp"

    local x_
    ___x_cmd uuid get_
    x_="$root/.tempfle.$$.$x_"

    while [ -n "$cur" ]; do
        if [ -f "$root/$cur" ]; then
            ___x_cmd_cmds_mv "$root/$cur" "$x_"
            ___x_cmd_cmds_mkdir "$root/$cur" || return $?
            ___x_cmd_cmds_mv "$x_" "$root/$cur/$___X_CMD_FSKV_DEFAULT_FILE"
            ___x_cmd mkdirp "$root/$kp"
            return $?
        fi
        case "$cur" in
            */*)        cur="${cur%/*}" ;;
            *)          break ;;
        esac
    done

    return 1
}
