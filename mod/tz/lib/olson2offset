# shellcheck shell=dash

# Maps a timezone identifier (Olson / TZ database name or POSIX-style TZ string)
# to its standard-time UTC offset in +HHMM / -HHMM form.
# Sets the global `x_` to the offset; returns 1 if the input is unrecognised.
___x_cmd_tz_olson2offset_(){  # shellcheck disable=SC2034  # x_ is a side-channel for the caller
    case "$1" in
        # Zero offset
        UTC|GMT|UCT|Etc/UTC|Etc/GMT|"Etc/GMT+0"|"Etc/GMT-0"|UTC0|GMT0|GMT0BST)
                                                                x_=+0000 ;;

        # Asia
        Asia/Shanghai|Asia/Hong_Kong|Asia/Taipei|Asia/Singapore|PRC|Hongkong|Asia/Manila|CST-8|PHT-8)
                                                                x_=+0800 ;;
        Asia/Tokyo|Asia/Seoul|JST-9|KST-9)                     x_=+0900 ;;
        Asia/Kolkata|Asia/Calcutta|IST-5:30)                   x_=+0530 ;;
        Asia/Yangon|Asia/Rangoon|MMT-6:30)                     x_=+0630 ;;
        Asia/Kathmandu|Asia/Katmandu|NPT-5:45)                 x_=+0545 ;;
        Asia/Tehran|IRST-3:30IRDT)                             x_=+0330 ;;
        Asia/Bangkok|Asia/Jakarta|Asia/Ho_Chi_Minh|Asia/Hanoi|ICT-7)
                                                                x_=+0700 ;;
        Asia/Karachi|PKT-5)                                    x_=+0500 ;;
        Asia/Dubai|Asia/Muscat|Asia/Yerevan|Asia/Tbilisi|Asia/Baku|GST-4|AMT-4)
                                                                x_=+0400 ;;
        Asia/Almaty|Asia/Tashkent|ALMT-6)                      x_=+0600 ;;
        Asia/Kabul|AFT-4:30)                                   x_=+0430 ;;

        # Europe
        Europe/London|Europe/Dublin|Europe/Lisbon)             x_=+0000 ;;
        Europe/Berlin|Europe/Paris|Europe/Madrid|Europe/Rome|Europe/Amsterdam|Europe/Brussels|Europe/Vienna|Europe/Stockholm|Europe/Oslo|Europe/Copenhagen|Europe/Zurich|Europe/Warsaw|Europe/Prague|CET-1CEST|MET-1MEST)
                                                                x_=+0100 ;;
        Europe/Athens|Europe/Helsinki|Europe/Bucharest|Europe/Sofia|EET-2EEST)
                                                                x_=+0200 ;;
        Europe/Moscow|Europe/Kiev|Europe/Kyiv|Europe/Istanbul|WET|MSK-3)
                                                                x_=+0300 ;;

        # Africa
        Africa/Cairo|Africa/Johannesburg|SAST-2)               x_=+0200 ;;
        Africa/Lagos|Africa/Algiers|Africa/Tunis|WAT-1)        x_=+0100 ;;

        # Americas
        America/New_York|EST|EST5EDT)                          x_=-0500 ;;
        America/Chicago|CST|CST6|CST6CDT|America/Mexico_City|America/Bogota|America/Lima)
                                                                x_=-0600 ;;
        America/Denver|MST|MST7MDT)                            x_=-0700 ;;
        America/Los_Angeles|PST|PST8PDT)                       x_=-0800 ;;
        America/Anchorage|AKST9AKDT)                           x_=-0900 ;;
        Pacific/Honolulu|HST|HST10)                            x_=-1000 ;;
        America/Toronto|America/Montreal|America/Glace_Bay|America/Halifax|AST4ADT)
                                                                x_=-0400 ;;
        America/Sao_Paulo|America/Argentina/Buenos_Aires|America/Santiago|BRT+3)
                                                                x_=-0300 ;;
        America/St_Johns|NST3:30NDT)                           x_=-0330 ;;

        # Oceania
        Australia/Sydney|Australia/Melbourne|AEST-10AEDT)      x_=+1000 ;;
        Australia/Perth|AWST-8)                                x_=+0800 ;;
        Pacific/Auckland|NZ|NZST-12NZDT)                       x_=+1200 ;;

        *)                                                     x_="" ; return 1 ;;
    esac
}