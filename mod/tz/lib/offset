# shellcheck shell=dash

___x_cmd_tz_offset(){
    local x_
    ___x_cmd_tz_offset_ || return $?
    printf "%s\n" "$x_"
}

___x_cmd_tz_offset_(){
    [ -z "$___X_CMD_TZ_OFFSET" ]  ||  {
        x_="$___X_CMD_TZ_OFFSET"
        return 0
    }

    local offset_fp="$___X_CMD_ROOT_DATA/tz/offset"
    [ ! -f "$offset_fp" ] || {
        if [ -f /etc/localtime ] && [ "$offset_fp" -nt /etc/localtime ]; then
            read -r x_<"$offset_fp" || return $?
            if [ -n "$x_" ]; then
                ___X_CMD_TZ_OFFSET="$x_"
                return 0
            fi
        fi
    }

    ___x_cmd_tz_init_
}

___x_cmd_tz_init_(){
    if [ -f /etc/localtime ]; then
        { read -r x_ && read -r x_; }</etc/localtime

        ___x_cmd_hascmd ___x_cmd_tz_olson2offset_ || xrc:mod:lib tz olson2offset
        ___x_cmd_tz_olson2offset_ "$x_"
    fi

    [ -n "$x_" ] || x_=$(___x_cmd_cmds date +%z)
    ___X_CMD_TZ_OFFSET="$x_"
    local offset_fp="$___X_CMD_ROOT_DATA/tz/offset"
    ___x_cmd ensurefp "$offset_fp"
    printf "%s\n" "$x_">"$offset_fp"
}

___x_cmd_tz_init(){
    local x_
    ___x_cmd_tz_init_
    tz:info "Init timezone for x-cmd -> $x_"
}
