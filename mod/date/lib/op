
___x_cmd_date_add(){
    local x_
    ___x_cmd_date_add_ "$@" || return $?
    printf "%s\n" "$x_"
}

___x_cmd_date_add_(){
    [ $# -gt 0 ]    ||      set -- --help
    local input_fmt="auto"
    local output_fmt=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)          ___x_cmd help -m date minus "$@" ; return 0 ;;
            --input)            input_fmt="$2" ;    arg:2:shift ;;
            --output)           output_fmt="$2" ;   arg:2:shift ;;
            *)                  break ;;
        esac
    done

    [ $# -gt 0 ]    ||  N=date M="Please provide at least one argument." log:ret:64
    local a="$1" ;      shift
    local b="${1:-now}"

    ___X_CMD_DATE_PARSE_MODE_OUTPUT=1 ___x_cmd_date_parse_ --fmt "$input_fmt" "$a" || \
        N=date M="Fail to parse $a" log:ret:1

    {
        read -r x_
        read -r input_fmt
    } <<A
$x_
A

    ___x_cmd_date_dump_ -v "$b" --fmt "${output_fmt:-"$input_fmt"}" "$x_"
}

___x_cmd_date_minus(){
    local x_
    ___x_cmd_date_minus_ "$@" || return $?
    printf "%s\n" "$x_"
}

___x_cmd_date_minus_(){
    local mode=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)          ___x_cmd help -m date minus "$@" ; return 0 ;;
            --human|--day)      mode="${1#--}" ; shift ;;
            *)                  break ;;
        esac
    done

    [ $# -gt 0 ]    ||  N=date M="Please provide at least one argument." log:ret:64
    local a="$1" ;      shift
    local b="${1:-now}"

    ___x_cmd_date_normalize_ "$a" || return $?
    a="$x_"
    ___x_cmd_date_normalize_ "$b" || return $?
    b="$x_"

    x_=$(( a - b ))

    case "$mode" in
        human)          ___x_cmd humantime fromsec_ "$x_" ;;
        day)            x_=$(( x_ / 86400 )) ;;
    esac
}

# iso
# email
# rfc
___x_cmd_date_normalize_(){
    case "$1" in
        ""|now)         ___x_cmd epoch get_ ; return $? ;;
    esac
    # All-digit input goes straight to epoch seconds. parse_'s format
    # ladder would mis-parse '1743038674' as YYYYMMDD ('1743-03-86')
    # and return a wrong date — fall back to literal-epoch here so minus
    # gets the obvious integer-as-seconds semantics.
    case "$1" in
        *[!0-9]*) ___x_cmd_date_parse_ "$1" || return 1 ;;
        *)        x_="$1" ;;
    esac
    return 0
}


