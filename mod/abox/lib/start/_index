# shellcheck disable=SC2016


___x_cmd_abox_prepare(){
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m abox prepare "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    ___x_cmd docker image exist abox ||  ___x_cmd_abox_rebuild "$@"
}

___x_cmd_abox_rebuild(){
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)      ___x_cmd help -m abox rebuild "$@" ; return 0 ;;
            *)              break ;;
        esac
    done

    ___x_cmd docker refit --no-cache --userai --from ubuntu    \
            --apt "curl jq sqlite3 git openssh-server openssh-client tmux doas locales"  \
            --xenv "claude-code codex opencode"     \
            --utf8 --to abox
}

