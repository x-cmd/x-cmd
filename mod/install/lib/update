# shellcheck shell=dash

___x_cmd_install_update___check(){
    [ -f "$___X_CMD_INSTALL_DATA_ALLTSV" ] || ___x_cmd_install_update "$@"
}

___x_cmd_install_update(){
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) ___x_cmd help -m install --update "$@"; return 0 ;;
            *) break ;;
        esac
    done

    local install_url=
    if ___x_cmd websrc is cn; then
        install_url="https://oss.resource.x-cmd.com/releases/install/$___X_CMD_INSTALL_VERSION.all.tsv"
    else
        install_url="https://github.com/x-cmd/install/releases/latest/download/$___X_CMD_INSTALL_VERSION.all.tsv"
    fi

    local install_path="$___X_CMD_INSTALL_DATA_ALLTSV"

    install:info "Download install data from $install_url"
    ___x_cmd ensurefp "$install_path"
    ___x_cmd curl -L -sS --speed-time 5 --speed-limit 100 "$install_url" > "$install_path.tmp" || {
        install:error "Fail to download install data"
        return 1
    }
    ___x_cmd rmrf "$install_path"
    ___x_cmd mv "$install_path.tmp" "$install_path"

    local num; num="$( ___x_cmd_cmds wc -l <"$install_path" )"
    install:info "Metadata of softwares [num=$num] are updated successfully"
}
