# shellcheck shell=dash

xrc:mod:lib     dns     reset/linux reset/darwin reset/win

___x_cmd_dns_reset(){
    case "$1" in
        -h|--help)  ___x_cmd help -m dns reset; return 0 ;;
    esac

    local x_
    ___x_cmd os name_
    case "$x_" in
        linux)      ___x_cmd_dns_reset___linux  "$@" ;;
        darwin)     ___x_cmd_dns_reset___darwin "$@" ;;
        win)        ___x_cmd_dns_reset___win    "$@" ;;
        *)          N=dns M="Unsupported os ==> $x_" log:ret:64 ;;
    esac
}
