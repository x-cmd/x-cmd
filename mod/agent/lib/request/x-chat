# shellcheck shell=dash

___x_cmd_agent_request___run_exec_x_chat(){
    local xchat_tools="all"
    case "${toolmode:-all}" in
        read-only|read-write)
            xchat_tools="$(___x_cmd_agent_request___toolmode_tools_ x-chat "$toolmode")" || return $?
            ;;
    esac
    ___x_cmd timeout "${timeout_secs:-3000}" x-cmd chat --exec --style chat --tool "$xchat_tools" --tool-force "$@"
}
