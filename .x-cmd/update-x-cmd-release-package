# shellcheck shell=dash

WSROOT="$(x wsroot)"
fun_update_release_package()(
    [ -n "$GITHUB_TOKEN" ]  || N=x M="Please provide github token" log:ret:1
    [ -n "$GITEE_TOKEN" ]   || N=x M="Please provide gitee token" log:ret:1
    [ -n "$CB_TOKEN" ]      || N=x M="Please provide cb token" log:ret:1

    x:info "Setting github token"
    x gh --cfg token="$GITHUB_TOKEN"

    x:info "Setting gitee token"
    x gt --cfg token="$GITEE_TOKEN"

    x:info "Setting cb token"
    x cb --cfg token="$CB_TOKEN"

    local version_mode_dir="$WSROOT/mod/version"
    x rmrf "$version_mode_dir"
    x mkdirp "$version_mode_dir"
    command git clone "git@github.com:x-bash/version" "$version_mode_dir" || N=x M="Fail to git clone x-bash/version" log:ret:1
    cd "$version_mode_dir" || N=x M="Fail to cd $version_mode_dir" log:ret:1

    x ws release-update
)  

fun_update_release_package "$@"
